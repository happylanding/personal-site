---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ScrollReveal from "../../components/ScrollReveal.astro";
import { useTranslations } from "../../i18n/utils";
import { getCollection } from "astro:content";
import ColumnIcon from "../../components/ColumnIcon.astro";

const lang = "en" as const;
const t = useTranslations(lang);

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const sorted = allArticles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

type YearGroups = Record<string, typeof sorted>;
const grouped = sorted.reduce<YearGroups>((acc, article) => {
  const year = article.data.date.getFullYear().toString();
  (acc[year] ||= []).push(article);
  return acc;
}, {});
---

<BaseLayout title={t("archive.title")} description={t("archive.description")}>
  <Breadcrumb crumbs={[{ label: t("archive.title"), href: "/en/archive/" }]} />

  <section data-reveal>
    <h1 class="text-3xl font-serif font-bold mb-12">{t("archive.title")}</h1>

    {Object.entries(grouped).sort(([a], [b]) => +b - +a).map(([year, articles]) => (
      <div class="mb-10">
        <h2 class="text-5xl font-serif font-bold text-black/10 dark:text-white/10 mb-4 -ml-1">{year}</h2>
        <div class="border-l border-black/10 dark:border-white/10 pl-6 space-y-5">
          {articles.map((article) => {
            const title = article.data.titleEn || article.data.title;
            const dateStr = article.data.date.toLocaleDateString("en-US", { month: "long", day: "numeric" });
            return (
              <div class="group" data-reveal>
                <time class="text-xs text-black/30 dark:text-white/30 font-mono">{dateStr}</time>
                <a href={`/en/${article.data.section}/${article.slug}`} class="block mt-1">
                  <span class="text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/40 dark:text-white/40 mr-2 inline-flex items-center gap-1">
                    <ColumnIcon section={article.data.section as "insights"|"tips"|"books"|"invest"} class="w-3 h-3" />
                    {t(`columns.${article.data.section}.name`)}
                  </span>
                  <span class="font-serif font-bold group-hover:opacity-70 transition-opacity">{title}</span>
                </a>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </section>

  <ScrollReveal />
</BaseLayout>
