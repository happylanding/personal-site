---
/**
 * TOCPanel — 电子书目录预览面板
 *
 * 支持两种数据来源：
 *  1. tocUrl — 指向预生成的 .toc.json 文件（推荐，构建时由 extract-ebook.cjs 生成）
 *  2. 静态传入 tocData prop（用于后端渲染场景）
 *
 * 功能：
 *  - 折叠/展开
 *  - 层级缩进显示
 *  - 点击章节跳转到对应预览区
 *  - 显示格式徽章和章节数量
 *
 * Props:
 *   @param {string} [tocUrl] - TOC JSON 文件 URL
 *   @param {object} [tocData] - 直接传入的 TOC 数据（静态）
 *   @param {string} [format]  - 格式徽章文字（如 "EPUB"）
 *   @param {string} [title]   - 表格标题
 *   @param {boolean} [defaultOpen=false] - 默认展开
 */

export interface TOCEntry {
  id: string;
  title: string;
  level: number;
  href?: string | null;
  children?: TOCEntry[];
  note?: string;
}

export interface TOCData {
  title: string;
  author?: string;
  format: string;
  totalChapters: number;
  note?: string | null;
  toc: TOCEntry[];
}

interface Props {
  tocUrl?: string;
  tocData?: TOCData;
  format?: string;
  title?: string;
  defaultOpen?: boolean;
}

const { tocUrl, tocData: staticData, format, title, defaultOpen = false } = Astro.props;

// 从 tocUrl 获取数据（在客户端处理）
const hasDataSource = !!tocUrl || !!staticData;

// 如果传入了静态数据，直接序列化给客户端
const initialDataJSON = staticData ? JSON.stringify(staticData) : 'null';
---

{hasDataSource && (
  <div
    class="toc-panel mt-12 rounded-xl border border-black/10 dark:border-white/10 overflow-hidden"
    data-toc-url={tocUrl || ''}
    data-toc-initial={initialDataJSON}
    data-default-open={defaultOpen ? "true" : "false"}
  >
    <!-- 面板头部 — 始终可见 -->
    <button
      id="toc-toggle"
      class="w-full flex items-center justify-between px-6 py-4 hover:bg-black/[0.02] dark:hover:bg-white/[0.02] transition-colors"
      onclick="this.parentElement.classList.toggle('toc-expanded')"
    >
      <div class="flex items-center gap-3">
        <svg class="w-5 h-5 text-black/40 dark:text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/>
        </svg>
        <span class="font-bold font-serif text-sm">{title || "目录预览"}</span>
        {format && (
          <span class="text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/40 dark:text-white/40 uppercase">
            {format}
          </span>
        )}
      </div>
      <div class="flex items-center gap-2 text-xs text-black/30 dark:text-white/30">
        <span id="toc-chapter-count"></span>
        <svg class="w-4 h-4 toc-chevron transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </div>
    </button>

    <!-- 面板主体 — 展开后显示 -->
    <div class="toc-body hidden border-t border-black/10 dark:border-white/10" id="toc-body">
      <div class="max-h-[400px] overflow-y-auto p-4" id="toc-list">
        <!-- 动态填充 -->
        <div class="flex items-center justify-center py-8">
          <div class="animate-pulse space-y-2 w-full">
            <div class="h-3 bg-black/[0.04] dark:bg-white/[0.04] rounded w-3/4"></div>
            <div class="h-3 bg-black/[0.03] dark:bg-white/[0.03] rounded w-1/2 ml-4"></div>
            <div class="h-3 bg-black/[0.04] dark:bg-white/[0.04] rounded w-2/3"></div>
          </div>
        </div>
      </div>

      <!-- 警告信息（仅 MOBI 等格式显示） -->
      <div id="toc-note" class="hidden px-4 pb-4"></div>
    </div>
  </div>
)}

<script>
  // 浅色/深色模式下的颜色调适
  function tocEntryColor(level: number, isDark: boolean): string {
    const lightLevels = ["#1a1a2e", "#333", "#555", "#777"];
    const darkLevels = ["#e0e0e0", "#b0b0b0", "#888", "#666"];
    const colors = isDark ? darkLevels : lightLevels;
    return colors[Math.min(level, colors.length - 1)] || colors[colors.length - 1];
  }

  function renderTOC(data: any) {
    const list = document.getElementById("toc-list");
    const countEl = document.getElementById("toc-chapter-count");
    const noteEl = document.getElementById("toc-note");
    if (!list || !data) return;

    const isDark = document.documentElement.classList.contains("dark");
    const toc: Array<{id: string; title: string; level: number; note?: string}> = data.toc || [];
    
    if (countEl) {
      countEl.textContent = `${toc.length} 章`;
    }

    list.innerHTML = "";
    if (toc.length === 0) {
      list.innerHTML = `<p class="text-sm text-black/30 dark:text-white/30 italic text-center py-4">暂无目录信息</p>`;
      return;
    }

    // 显示层级缩进的 TOC
    toc.forEach((entry) => {
      const indent = entry.level * 20;
      const color = tocEntryColor(entry.level, isDark);
      const a = document.createElement("a");
      a.href = `#toc-${entry.id}`;
      a.className = "flex items-center gap-2 py-1.5 px-2 rounded-md text-sm hover:bg-black/[0.03] dark:hover:bg-white/[0.03] transition-colors cursor-pointer";
      a.style.paddingLeft = `${indent + 8}px`;
      a.innerHTML = `
        <span class="flex-shrink-0 w-1 h-1 rounded-full bg-black/20 dark:bg-white/20" style="background-color:${color}"></span>
        <span class="truncate" style="color:${color}">${entry.title}</span>
      `;

      // 检查是否有对应预览区
      const target = document.getElementById(`toc-${entry.id}`);
      if (target) {
        a.addEventListener("click", (e) => {
          e.preventDefault();
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      }
      list.appendChild(a);
    });

    // 如果有警告信息
    if (data.note) {
      noteEl!.classList.remove("hidden");
      noteEl!.innerHTML = `<p class="text-xs text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-400/10 rounded-lg p-3">⚠️ ${data.note}</p>`;
    }
  }

  // 初始化
  const panel = document.querySelector(".toc-panel") as HTMLElement;
  if (panel) {
    const initialDataStr = panel.getAttribute("data-toc-initial");
    const tocUrl = panel.getAttribute("data-toc-url");
    const defaultOpen = panel.getAttribute("data-default-open") === "true";

    // 如果默认展开
    if (defaultOpen) {
      panel.classList.add("toc-expanded");
    }

    // 1. 优先使用静态传入的数据
    if (initialDataStr && initialDataStr !== "null") {
      try {
        const data = JSON.parse(initialDataStr);
        renderTOC(data);
      } catch {}
    }
    // 2. 从 URL 异步加载
    else if (tocUrl) {
      fetch(tocUrl)
        .then((res) => res.json())
        .then((data) => renderTOC(data))
        .catch(() => {
          const list = document.getElementById("toc-list");
          if (list) list.innerHTML = `<p class="text-sm text-black/30 dark:text-white/30 italic text-center py-4">目录加载失败</p>`;
        });
    }
  }
</script>

<style>
  /* 展开/折叠逻辑 */
  .toc-panel:not(.toc-expanded) .toc-body {
    display: none;
  }
  .toc-panel.toc-expanded .toc-body {
    display: block;
  }
  .toc-panel.toc-expanded .toc-chevron {
    transform: rotate(180deg);
  }

  /* 滚动区样式 */
  #toc-list::-webkit-scrollbar { width: 4px; }
  #toc-list::-webkit-scrollbar-track { background: transparent; }
  #toc-list::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.1); border-radius: 2px; }
  .dark #toc-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); }
</style>
