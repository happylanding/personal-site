{
  "name": "personal-site",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "tsc -p tsconfig.galvin.json --noEmit",
    "check:astro": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium playwright test",
    "quality": "npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^7.2.0",
    "tailwindcss": "^4.1.18",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "jszip": "^3.10.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
