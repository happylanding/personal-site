---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Icon from "../components/Icon.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const breadcrumbItems = [
  { label: t("contact.title") },
];
---

<BaseLayout>
  <Breadcrumb crumbs={breadcrumbItems} />

  <h1 class="text-2xl font-bold font-serif mb-3" data-reveal>{t("contact.title")}</h1>
  <p class="text-sm text-black/40 dark:text-white/40 mb-12" data-reveal>{t("contact.description")}</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8" data-reveal>

    <!-- Email -->
    <div class="p-6 rounded-xl border border-black/10 dark:border-white/10 hover-lift">
      <div class="flex items-center gap-3 mb-3">
        <Icon name="mail" class="w-5 h-5 opacity-50" />
        <h2 class="font-bold text-base">{t("contact.email")}</h2>
      </div>
      <a href="mailto:{t('contact.emailValue')}" class="text-sm text-black/60 dark:text-white/60 hover:underline break-all">
        {t("contact.emailValue")}
      </a>
    </div>

  </div>

  <!-- Response note -->
  <p class="mt-12 text-center text-sm text-black/30 dark:text-white/30" data-reveal>
    {t("contact.response")}
  </p>
</BaseLayout>
