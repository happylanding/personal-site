---
/* Galvin design reminder: 叩问 is a continuous question directory, not a dashboard.
   Let titles and reading metadata lead; violet marks a chosen filter, cyan marks live state. */
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getQuestionFilterOptions } from "../lib/galvin-content-view";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const filters = getQuestionFilterOptions(articles.flatMap((article) => article.data.tags));
const preferredFilters = new Set(["全部", "AI", "Vibe Coding", "AI写作", "工作方式", "数字政府"]);
const primaryFilters = filters.filter((filter) => preferredFilters.has(filter));
const visibleFilters = primaryFilters.length > 1 ? primaryFilters : filters.slice(0, 6);
const extraFilters = filters.filter((filter) => !visibleFilters.includes(filter));

function dateLabel(date: Date): string {
  return new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(date).replaceAll("/", ".");
}
---

<BaseLayout title="叩问" description="Galvin 的思考归档：AI 学习、工作方法与持续追问。">
  <section class="galvin-content-page galvin-question-page" aria-labelledby="question-title">
    <header class="galvin-question-directory__header">
      <p data-question-metadata><span aria-hidden="true"></span>问题目录</p>
      <div class="galvin-question-directory__title-row">
        <h1 id="question-title">叩问</h1>
        <span class="galvin-question-directory__count" data-question-metadata>{articles.length} 篇已发布</span>
      </div>
      <div class="galvin-question-directory__summary">
        <p>把遇到的问题摊开，把暂时没有答案的事写下来。这里收录 AI 学习、工作方法和持续修正中的思考。</p>
        <button id="question-open-search" class="galvin-question-directory__search" type="button">检索全部内容 <kbd>⌘ K</kbd></button>
      </div>
    </header>

    <div class="galvin-question-filter" aria-label="按标签筛选文章">
      <div class="galvin-question-filter__head">
        <div>
          <p>主题筛选</p>
          <span>先从一个熟悉的问题开始。</span>
        </div>
        <p class="galvin-question-filter__count" aria-live="polite"><span id="question-visible-count">{String(articles.length).padStart(2, "0")}</span> 篇</p>
      </div>
      <div class="galvin-question-filter__primary" data-question-filter-primary role="tablist" aria-label="核心文章标签">
        {visibleFilters.map((filter, index) => (
          <button
            class:list={["galvin-question-filter__tab", index === 0 && "is-active"]}
            type="button"
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls="question-directory"
            data-question-filter={filter}
          >
            {filter}
          </button>
        ))}
      </div>
      {extraFilters.length > 0 && <button
        id="question-filter-toggle"
        class="galvin-question-filter__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="question-filter-extra"
      >
        展开全部标签 <span>（{extraFilters.length}）</span>
      </button>}
      {extraFilters.length > 0 && <div id="question-filter-extra" class="galvin-question-filter__extra" data-question-filter-extra role="tablist" aria-label="补充文章标签" hidden>
        {extraFilters.map((filter) => (
          <button
            class="galvin-question-filter__tab"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="question-directory"
            data-question-filter={filter}
          >
            {filter}
          </button>
        ))}
      </div>}
    </div>

    <div class="galvin-question-directory__list" id="question-directory">
      {articles.map((article, index) => (
        <article class:list={["galvin-question-row", { "galvin-question-row--lead": index === 0 }]} data-question-card data-tags={article.data.tags.join("|")}>
          <a href={`/${article.data.section}/${article.id}/`} class="galvin-question-row__link" aria-label={`阅读：${article.data.title}`}></a>
          <span class="galvin-question-row__mark" aria-hidden="true"></span>
          <div class="galvin-question-row__main">
            <div class="galvin-question-row__utility" data-question-metadata>
              <time datetime={article.data.date.toISOString()}>{dateLabel(article.data.date)}</time>
              <span class="galvin-question-row__section">{article.data.section === "ai" ? "AI 学习" : article.data.section === "insights" ? "工作观察" : article.data.section === "tips" ? "方法实践" : "阅读记录"}</span>
            </div>
            <h2>{article.data.title}</h2>
            {article.data.description && <p>{article.data.description}</p>}
            <div class="galvin-question-row__tags" data-question-tags aria-label="文章标签">
              {article.data.tags.slice(0, 4).map((tag) => <span>#{tag}</span>)}
            </div>
          </div>
          <span class="galvin-question-row__arrow" aria-hidden="true">↗</span>
        </article>
      ))}
    </div>

    {articles.length === 0 && <p class="galvin-empty-state">暂时还没有可公开的叩问记录。</p>}
  </section>

  <script>
    (() => {
      const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-question-filter]"));
      const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-question-card]"));
      const count = document.getElementById("question-visible-count");
      const searchButton = document.getElementById("question-open-search");
      const filterToggle = document.getElementById("question-filter-toggle");
      const extraFilterPanel = document.getElementById("question-filter-extra");

      const setExtraFiltersOpen = (open: boolean) => {
        if (!filterToggle || !extraFilterPanel) return;
        extraFilterPanel.hidden = !open;
        filterToggle.setAttribute("aria-expanded", String(open));
        filterToggle.firstChild!.textContent = open ? "收起补充标签 " : "展开全部标签 ";
      };

      const applyFilter = (filter: string) => {
        let visible = 0;
        cards.forEach((card) => {
          const tags = (card.dataset.tags || "").split("|").filter(Boolean);
          const matches = filter === "全部" || tags.includes(filter);
          card.hidden = !matches;
          if (matches) visible += 1;
        });
        filters.forEach((button) => {
          const active = button.dataset.questionFilter === filter;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-selected", String(active));
          if (active && button.closest("[data-question-filter-extra]")) setExtraFiltersOpen(true);
        });
        if (count) count.textContent = String(visible).padStart(2, "0");
      };

      filters.forEach((button) => button.addEventListener("click", () => applyFilter(button.dataset.questionFilter || "全部")));
      filterToggle?.addEventListener("click", () => setExtraFiltersOpen(filterToggle.getAttribute("aria-expanded") !== "true"));
      searchButton?.addEventListener("click", () => {
        document.getElementById("search-trigger-desktop")?.click();
        document.getElementById("search-trigger-mobile")?.click();
      });
    })();
  </script>
</BaseLayout>
