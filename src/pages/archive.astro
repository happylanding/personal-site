---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getCollection } from "astro:content";
import ColumnIcon from "../components/ColumnIcon.astro";
import type { SectionKey } from "../lib/sections";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const sorted = allArticles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

type YearGroups = Record<string, typeof sorted>;
const grouped = sorted.reduce<YearGroups>((acc, article) => {
  const year = article.data.date.getFullYear().toString();
  (acc[year] ||= []).push(article);
  return acc;
}, {});
---

<BaseLayout title={t("archive.title")} description={t("archive.description")}>
  <Breadcrumb crumbs={[{ label: t("archive.title"), href: "/archive/" }]} />

  <section data-reveal>
    <h1 class="text-3xl font-serif font-bold mb-12">{t("archive.title")}</h1>

    {Object.entries(grouped).sort(([a], [b]) => +b - +a).map(([year, articles]) => (
      <div class="mb-10">
        <h2 class="text-5xl font-serif font-bold text-black/10 dark:text-white/10 mb-4 -ml-1">{year}</h2>
        <div class="border-l border-black/10 dark:border-white/10 pl-6 space-y-5">
          {articles.map((article) => {
            const title = lang === "en" ? (article.data.titleEn || article.data.title) : article.data.title;
            const dateStr = article.data.date.toLocaleDateString(lang === "en" ? "en-US" : "zh-CN", { month: "long", day: "numeric" });
            return (
              <div class="group" data-reveal>
                <time class="text-[13px] text-black/45 dark:text-white/60 font-mono">{dateStr}</time>
                <a
                  href={lang === "en" ? `/en/${article.data.section}/${article.id}` : `/${article.data.section}/${article.id}`}
                  class="block mt-1"
                >
                  <span class="text-[13px] px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75 mr-2 inline-flex items-center gap-1">
                    <ColumnIcon section={article.data.section as SectionKey} class="w-3 h-3" />
                    {t(`columns.${article.data.section}.name`)}
                  </span>
                  <span class="font-serif font-bold group-hover:text-black dark:group-hover:text-white transition-colors">{title}</span>
                </a>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </section>

  <ScrollReveal />
</BaseLayout>
