---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
  const sites = await getCollection("sites", ({ data }) => !data.draft && !!data.siteUrl);
  return sites.map((site) => ({ params: { slug: site.slug } }));
}

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allSites = await getCollection("sites", ({ data }) => !data.draft && !!data.siteUrl);
const entry = allSites.find((s) => s.slug === slug);
if (!entry) return Astro.redirect("/404");

// 同系列内按日期排序，用于上一篇 / 下一篇
const sectionSites = allSites.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const idx = sectionSites.findIndex((s) => s.slug === slug);
const prevEntry = idx > 0 ? sectionSites[idx - 1] : undefined;
const nextEntry = idx >= 0 && idx < sectionSites.length - 1 ? sectionSites[idx + 1] : undefined;

const { Content } = await entry.render();

const isEn = lang === "en";
const title = isEn ? (entry.data.titleEn || entry.data.title) : entry.data.title;
const desc = isEn ? (entry.data.descriptionEn || entry.data.description) : entry.data.description;
const dateStr = entry.data.date.toLocaleDateString(isEn ? "en-US" : "zh-CN", {
  year: "numeric", month: "long", day: "numeric",
});
const host = entry.data.siteUrl ? new URL(entry.data.siteUrl).hostname : "";
---

<BaseLayout title={title} description={desc}>
  <Breadcrumb
    crumbs={[
      { label: isEn ? "Collection" : "收藏夹", href: isEn ? "/en/sites/" : "/sites/" },
      { label: title, href: "#" },
    ]}
  />

  <article class="max-w-2xl mx-auto" data-reveal>
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/50 dark:text-white/50 inline-flex items-center gap-1">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
          {isEn ? "Collection" : "收藏夹"}
        </span>
        {entry.data.siteUrl && (
          <a
            href={entry.data.siteUrl}
            target="_blank"
            rel="noopener"
            class="text-xs px-2 py-0.5 rounded-full border border-black/15 dark:border-white/15 text-black/50 dark:text-white/50 hover:bg-black/[0.04] dark:hover:bg-white/[0.04] inline-flex items-center gap-1 transition-colors"
          >
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            {host}
          </a>
        )}
      </div>

      <h1 class="text-3xl md:text-4xl font-serif font-bold leading-tight mb-4">{title}</h1>
      {desc && <p class="text-base text-black/50 dark:text-white/50 mb-4 leading-relaxed">{desc}</p>}

      <time class="text-sm text-black/30 dark:text-white/30 font-mono" datetime={entry.data.date.toISOString()}>
        {dateStr}
      </time>

      {entry.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {entry.data.tags.slice(0, 5).map((tag: string) => (
            <span class="text-xs px-2 py-1 rounded-md bg-black/5 dark:bg-white/5 text-black/40 dark:text-white/40">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose dark:prose-invert article-content max-w-none">
      <Content />
    </div>

    <!-- 上一篇 / 下一篇 -->
    <nav class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {prevEntry ? (
        <a
          href={isEn ? `/en/sites/${prevEntry.slug}/` : `/sites/${prevEntry.slug}/`}
          class="group p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-colors"
        >
          <p class="text-xs text-black/30 dark:text-white/30 mb-1">← {isEn ? "Previous" : "上一篇"}</p>
          <p class="text-sm font-medium group-hover:opacity-70 transition-opacity line-clamp-2">
            {isEn ? (prevEntry.data.titleEn || prevEntry.data.title) : prevEntry.data.title}
          </p>
        </a>
      ) : (
        <span></span>
      )}
      {nextEntry ? (
        <a
          href={isEn ? `/en/sites/${nextEntry.slug}/` : `/sites/${nextEntry.slug}/`}
          class="group p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-colors sm:text-right"
        >
          <p class="text-xs text-black/30 dark:text-white/30 mb-1">{isEn ? "Next" : "下一篇"} →</p>
          <p class="text-sm font-medium group-hover:opacity-70 transition-opacity line-clamp-2">
            {isEn ? (nextEntry.data.titleEn || nextEntry.data.title) : nextEntry.data.title}
          </p>
        </a>
      ) : (
        <span></span>
      )}
    </nav>

    <nav class="mt-12">
      <a
        href={isEn ? "/en/sites/" : "/sites/"}
        class="inline-flex items-center gap-2 text-sm text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors"
      >
        ← {isEn ? "Back to collection" : "返回收藏夹"}
      </a>
    </nav>
  </article>
</BaseLayout>
