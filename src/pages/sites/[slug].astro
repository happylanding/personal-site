---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Icon from "../../components/Icon.astro";
import ArticleTOC from "../../components/ArticleTOC.astro";
import { SECTION_COLORS, SECTION_COLORS_DARK, type SectionKey } from "../../lib/sections";

export async function getStaticPaths() {
  const sites = await getCollection("sites", ({ data }) => !data.draft && !!data.siteUrl);
  return sites.map((site) => ({ params: { slug: site.id } }));
}

const { slug } = Astro.params;

const allSites = await getCollection("sites", ({ data }) => !data.draft && !!data.siteUrl);
const entry = allSites.find((s) => s.id === slug);
if (!entry) return Astro.redirect("/404");

// 同系列内按日期排序，用于上一篇 / 下一篇
const sectionSites = allSites.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const idx = sectionSites.findIndex((s) => s.id === slug);
const prevEntry = idx > 0 ? sectionSites[idx - 1] : undefined;
const nextEntry = idx >= 0 && idx < sectionSites.length - 1 ? sectionSites[idx + 1] : undefined;

const { Content } = await render(entry);

const title = entry.data.title;
const desc = entry.data.description;
const dateStr = entry.data.date.toLocaleDateString("zh-CN", {
  year: "numeric", month: "long", day: "numeric",
});
const host = entry.data.siteUrl ? new URL(entry.data.siteUrl).hostname : "";
---

<BaseLayout title={title} description={desc}>
  <Breadcrumb
    crumbs={[
      { label: "收藏夹", href: "/sites/" },
      { label: title, href: "#" },
    ]}
  />

  <article data-reveal
    style={{
      "--toc-accent": SECTION_COLORS[entry.data.section as SectionKey],
      "--toc-accent-dark": SECTION_COLORS_DARK[entry.data.section as SectionKey],
    }}
  >
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-[13px] px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75 inline-flex items-center gap-1">
          <Icon name="bookmark" class="w-3 h-3" />
          收藏夹
        </span>
        {entry.data.siteUrl && (
          <a
            href={entry.data.siteUrl}
            target="_blank"
            rel="noopener"
            class="text-[13px] px-2 py-0.5 rounded-full border border-black/15 dark:border-white/15 text-black/60 dark:text-white/75 hover:bg-black/[0.04] dark:hover:bg-white/[0.04] inline-flex items-center gap-1 transition-colors"
          >
            <Icon name="link" class="w-3 h-3" />
            {host}
          </a>
        )}
      </div>

      <h1 class="text-3xl md:text-4xl font-serif font-bold leading-tight mb-4">{title}</h1>
      {desc && <p class="text-base text-black/50 dark:text-white/50 mb-4 leading-relaxed max-w-3xl">{desc}</p>}

      <time class="text-sm text-black/45 dark:text-white/60 font-mono" datetime={entry.data.date.toISOString()}>
        {dateStr}
      </time>

      {entry.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {entry.data.tags.slice(0, 5).map((tag: string) => (
            <span class="text-[13px] px-2 py-1 rounded-md bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div id="article-grid" class="article-grid lg:grid lg:grid-cols-[minmax(0,1fr)_220px] xl:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 xl:gap-14">
      <!-- 正文 -->
      <div class="min-w-0 order-1">
        <div class="prose dark:prose-invert article-content">
          <Content />
        </div>
      </div>

      <!-- 右侧 sticky 目录 -->
      <div class="min-w-0 order-2">
        <ArticleTOC
          label="目录"
          countFormat="{count} 节"
          sectionColor={SECTION_COLORS[entry.data.section as SectionKey]}
          sectionColorDark={SECTION_COLORS_DARK[entry.data.section as SectionKey]}
        />
      </div>
    </div>

    <!-- 上一篇 / 下一篇：与正文列对齐（桌面端右侧留出与目录同宽的空白列） -->
    <nav class="mt-12 article-prevnext" data-reveal>
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_220px] xl:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 xl:gap-14">
        <div class="min-w-0 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevEntry ? (
            <a
              href={`/sites/${prevEntry.id}/`}
              class="group p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-colors"
            >
              <p class="text-xs text-black/30 dark:text-white/30 mb-1 inline-flex items-center gap-1"><Icon name="arrowLeft" class="w-3 h-3" /> 上一篇</p>
              <p class="text-sm font-medium group-hover:text-black dark:group-hover:text-white transition-colors line-clamp-2">
                {prevEntry.data.title}
              </p>
            </a>
          ) : (
            <span></span>
          )}
          {nextEntry ? (
            <a
              href={`/sites/${nextEntry.id}/`}
              class="group p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-colors sm:text-right"
            >
              <p class="text-xs text-black/30 dark:text-white/30 mb-1 inline-flex items-center gap-1">下一篇 <Icon name="arrowRight" class="w-3 h-3" /></p>
              <p class="text-sm font-medium group-hover:text-black dark:group-hover:text-white transition-colors line-clamp-2">
                {nextEntry.data.title}
              </p>
            </a>
          ) : (
            <span></span>
          )}
        </div>
        <!-- 占位列：桌面端与右侧目录栏对齐，保持导航与正文左对齐 -->
        <div class="hidden lg:block article-prevnext-spacer" aria-hidden="true"></div>
      </div>
    </nav>

    <nav class="mt-12">
      <a
        href="/sites/"
        class="inline-flex items-center gap-2 text-sm text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors"
      >
        <Icon name="arrowLeft" class="w-4 h-4" />
        返回收藏夹
      </a>
    </nav>
  </article>
</BaseLayout>
