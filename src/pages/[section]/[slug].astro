---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ColumnIcon from "../../components/ColumnIcon.astro";
import Icon from "../../components/Icon.astro";
import ArticleTOC from "../../components/ArticleTOC.astro";
import ArticleReadingProgress from "../../components/ArticleReadingProgress.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getGalvinKindLabel } from "../../lib/galvin-content";
import { resolveArticleSearchKind } from "../../lib/galvin-content-view";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { section: article.data.section, slug: article.id },
  }));
}

const { section, slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const article = allArticles.find((a) => a.id === slug && a.data.section === section);
if (!article) return Astro.redirect("/404");

const { Content } = await render(article);

const displayTitle = lang === "en" ? (article.data.titleEn || article.data.title) : article.data.title;
const displayDesc = lang === "en" ? (article.data.descriptionEn || article.data.description) : article.data.description;
const displayTags = lang === "en"
  ? (article.data.tagsEn.length > 0 ? article.data.tagsEn : article.data.tags)
  : article.data.tags;
const dateStr = article.data.date.toLocaleDateString(lang === "en" ? "en-US" : "zh-CN", {
  year: "numeric", month: "long", day: "numeric",
});
const isBook = section === "books";
const ogImage = article.data.ogImage || "/favicon.svg";
const galvinKind = resolveArticleSearchKind(article.data.kind, article.data.section);
const galvinKindLabel = getGalvinKindLabel(galvinKind);

// 同栏目内按时间排序，用于上一篇 / 下一篇
const sectionArticles = allArticles
  .filter((a) => a.data.section === section)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const idx = sectionArticles.findIndex((a) => a.id === slug);
const prevArticle = idx > 0 ? sectionArticles[idx - 1] : undefined;
const nextArticle = idx >= 0 && idx < sectionArticles.length - 1 ? sectionArticles[idx + 1] : undefined;
---

<BaseLayout title={displayTitle} description={displayDesc} ogImage={ogImage}>
  <article class="galvin-article-page" data-reveal>
    <header class="galvin-article-page__hero">
      <a class="galvin-article-page__back" href="/archive/">← 返回叩问</a>
      {article.data.ogImage && (
        <img
          src={article.data.ogImage.replace(/\.png$/, ".webp")}
          alt={displayTitle}
          class="galvin-article-page__cover"
          width="1200"
          height="630"
          loading="eager"
          decoding="async"
        />
      )}

      <div class="galvin-article-page__signal-row">
        <span class="galvin-article-page__kind">
          <ColumnIcon section={section as import("../lib/sections").SectionKey} class="w-3 h-3" /> {galvinKindLabel}
        </span>
        <span>ARTICLE / {article.id.toUpperCase()}</span>
        {article.data.featured && (
          <span class="galvin-article-page__featured">
            <Icon name="star" class="w-3 h-3" /> {t("articles.featured")}
          </span>
        )}
      </div>

      <h1>{displayTitle}</h1>

      {displayDesc && (
        <p class="galvin-article-page__lead">{displayDesc}</p>
      )}

      <div class="galvin-article-page__meta">
        <time datetime={article.data.date.toISOString()}><span>PUBLISHED</span>{dateStr}</time>
        <span><span>SECTION</span>{galvinKindLabel}</span>
        {article.data.author && (
          <span><span>AUTHOR</span>{article.data.author}</span>
        )}
      </div>

      {displayTags.length > 0 && (
        <div class="galvin-article-page__tags">
          {displayTags.map((tag: string) => (
            <span>
              #{tag}
            </span>
          ))}
        </div>
      )}

      {isBook && article.data.coverImage && (
        <div class="galvin-article-page__book-cover">
          <img src={article.data.coverImage} alt={displayTitle} loading="lazy" decoding="async" />
        </div>
      )}
    </header>

    <ArticleReadingProgress />

    <div id="article-grid" class="article-grid galvin-article-grid lg:grid lg:grid-cols-[minmax(0,1fr)_220px] xl:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 xl:gap-14">
      <!-- 正文 -->
      <div class="min-w-0 order-1">
        <div class="prose dark:prose-invert article-content galvin-article-content max-w-none">
          <Content />
        </div>
      </div>

      <!-- 右侧 sticky 目录（lg+ 显示 rail；移动端/平板显示折叠卡片，均由组件内响应式 class 控制） -->
      <div class="min-w-0 order-2">
        <ArticleTOC label={t("articles.toc")} countFormat={t("articles.tocCount")} />
      </div>
    </div>

    {article.data.sourceUrl && (
      <aside class="galvin-article-resource" aria-label="文章资源">
        <span class="galvin-article-resource__node" aria-hidden="true"></span>
        <div><span>PRIMARY SOURCE</span><p>本文引用的公开课程、项目或资料入口。</p></div>
        <a href={article.data.sourceUrl} target="_blank" rel="noopener">原始资源 <span aria-hidden="true">↗</span></a>
      </aside>
    )}

    <!-- Book-specific: format download section -->
    {isBook && (
      <div class="mt-12 p-6 rounded-xl border border-black/10 dark:border-white/10" data-reveal>
        <h3 class="font-bold font-serif mb-3">{t("articles.download")}</h3>
        <p class="text-xs text-black/40 dark:text-white/40 mb-4">
          {t("articles.formatNote") || "支持多种电子书格式，点击对应按钮下载"}
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={`/books/${slug}/read/`}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-black dark:bg-white text-white dark:text-black text-sm hover:opacity-80 transition-opacity"
          >
            <Icon name="bookOpen" class="w-4 h-4" />
            {t("articles.preview")}
          </a>
          {article.data.epubUrl && (
            <a
              href={article.data.epubUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-black dark:bg-white text-white dark:text-black text-sm hover:opacity-80 transition-opacity"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              EPUB {t("articles.download")}
            </a>
          )}
          {article.data.mobiUrl && (
            <a
              href={article.data.mobiUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              MOBI {t("articles.download")}
            </a>
          )}
          {article.data.azw3Url && (
            <a
              href={article.data.azw3Url}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              AZW3 {t("articles.download")}
            </a>
          )}
          {article.data.fb2Url && (
            <a
              href={article.data.fb2Url}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              FB2 {t("articles.download")}
            </a>
          )}
          {article.data.txtUrl && (
            <a
              href={article.data.txtUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              TXT {t("articles.download")}
            </a>
          )}
          {article.data.pdfUrl && (
            <a
              href={article.data.pdfUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              PDF {t("articles.download")}
            </a>
          )}
        </div>
      </div>
    )}

    <!-- 上一篇 / 下一篇：与正文列对齐（桌面端右侧留出与目录同宽的空白列） -->
    <nav class="mt-12 article-prevnext" data-reveal>
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_220px] xl:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 xl:gap-14">
        <div class="min-w-0 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevArticle ? (
            <a
              href={lang === "en" ? `/en/${section}/${prevArticle.id}` : `/${section}/${prevArticle.id}`}
              class="group p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-colors relative overflow-hidden" data-spotlight
            >
              <p class="text-xs text-black/30 dark:text-white/30 mb-1 inline-flex items-center gap-1"><Icon name="arrowLeft" class="w-3 h-3" /> {lang === "en" ? "Older" : "上一篇"}</p>
              <p class="text-sm font-medium group-hover:opacity-70 transition-opacity line-clamp-2">
                {lang === "en" ? (prevArticle.data.titleEn || prevArticle.data.title) : prevArticle.data.title}
              </p>
            </a>
          ) : (
            <span></span>
          )}
          {nextArticle ? (
            <a
              href={lang === "en" ? `/en/${section}/${nextArticle.id}` : `/${section}/${nextArticle.id}`}
              class="group p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-colors sm:text-right relative overflow-hidden" data-spotlight
            >
              <p class="text-xs text-black/30 dark:text-white/30 mb-1 inline-flex items-center gap-1">{lang === "en" ? "Newer" : "下一篇"} <Icon name="arrowRight" class="w-3 h-3" /></p>
              <p class="text-sm font-medium group-hover:opacity-70 transition-opacity line-clamp-2">
                {lang === "en" ? (nextArticle.data.titleEn || nextArticle.data.title) : nextArticle.data.title}
              </p>
            </a>
          ) : (
            <span></span>
          )}
        </div>
        <!-- 占位列：桌面端与右侧目录栏对齐，保持导航与正文左对齐 -->
        <div class="hidden lg:block article-prevnext-spacer" aria-hidden="true"></div>
      </div>
    </nav>

  </article>
</BaseLayout>
