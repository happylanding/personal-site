---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ColumnIcon from "../../components/ColumnIcon.astro";
import Icon from "../../components/Icon.astro";
import ArticleTOC from "../../components/ArticleTOC.astro";

const columnNames: Record<string, string> = {
  insights: "行业洞察",
  ai: "AI 学习",
  tips: "实用技巧",
  books: "阅读思考",
};

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { section: article.data.section, slug: article.id },
  }));
}

const { section, slug } = Astro.params;

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const article = allArticles.find((a) => a.id === slug && a.data.section === section);
if (!article) return Astro.redirect("/404");

const { Content } = await render(article);

const displayTitle = article.data.title;
const displayDesc = article.data.description;
const displayTags = article.data.tags;
const dateStr = article.data.date.toLocaleDateString("zh-CN", {
  year: "numeric", month: "long", day: "numeric",
});
const isBook = section === "books";
const ogImage = article.data.ogImage || "/favicon.svg";

// 同栏目内按时间排序，用于上一篇 / 下一篇
const sectionArticles = allArticles
  .filter((a) => a.data.section === section)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const idx = sectionArticles.findIndex((a) => a.id === slug);
const prevArticle = idx > 0 ? sectionArticles[idx - 1] : undefined;
const nextArticle = idx >= 0 && idx < sectionArticles.length - 1 ? sectionArticles[idx + 1] : undefined;
---

<BaseLayout title={displayTitle} description={displayDesc} ogImage={ogImage}>
  <Breadcrumb
    crumbs={[
      { label: columnNames[section], href: `/${section}/` },
      { label: displayTitle, href: "#" },
    ]}
  />

  <article data-reveal>
    <header class="mb-10">
      {article.data.ogImage && (
        <img
          src={article.data.ogImage.replace(/\.png$/, ".webp")}
          alt={displayTitle}
          class="w-full rounded-xl border border-black/10 dark:border-white/10 shadow-sm mb-6"
          width="1200"
          height="630"
          loading="eager"
          decoding="async"
        />
      )}

      <div class="flex items-center gap-3 mb-4">
        <span class="text-[13px] px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75 inline-flex items-center gap-1">
          <ColumnIcon section={section as import("../lib/sections").SectionKey} class="w-3 h-3" /> {columnNames[section]}
        </span>
        {article.data.featured && (
          <span class="text-xs px-2 py-0.5 rounded-full bg-black dark:bg-white text-white dark:text-black inline-flex items-center gap-1">
            <Icon name="star" class="w-3 h-3" /> 精选
          </span>
        )}
      </div>

      <h1 class="text-3xl md:text-4xl font-serif font-bold leading-tight mb-4 lmask">
        <span class="lmask-inner" style="--lmask-delay:0.1s"><span>{displayTitle}</span></span>
      </h1>

      {displayDesc && (
        <p class="text-base text-black/50 dark:text-white/50 mb-4 leading-relaxed max-w-3xl">{displayDesc}</p>
      )}

      <div class="flex flex-wrap items-center gap-4 text-sm text-black/45 dark:text-white/60 font-mono">
        <time datetime={article.data.date.toISOString()}>
          发布于 {dateStr}
        </time>
        {article.data.author && (
          <span>作者: {article.data.author}</span>
        )}
      </div>

      {displayTags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {displayTags.map((tag: string) => (
            <span class="text-[13px] px-2 py-1 rounded-md bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75">
              #{tag}
            </span>
          ))}
        </div>
      )}

      {isBook && article.data.coverImage && (
        <div class="mt-6">
          <img src={article.data.coverImage} alt={displayTitle} class="w-32 rounded-lg shadow-md" loading="lazy" decoding="async" />
        </div>
      )}
    </header>

    <div id="article-grid" class="article-grid lg:grid lg:grid-cols-[minmax(0,1fr)_220px] xl:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 xl:gap-14">
      <!-- 正文 -->
      <div class="min-w-0 order-1">
        <div class="prose dark:prose-invert article-content">
          <Content />
        </div>
      </div>

      <!-- 右侧 sticky 目录（lg+ 显示 rail；移动端/平板显示折叠卡片，均由组件内响应式 class 控制） -->
      <div class="min-w-0 order-2">
        <ArticleTOC label="目录" countFormat="{count} 节" />
      </div>
    </div>

    <!-- Book-specific: format download section -->
    {isBook && (
      <div class="mt-12 p-6 rounded-xl border border-black/10 dark:border-white/10" data-reveal>
        <h3 class="font-bold font-serif mb-3">下载</h3>
        <p class="text-xs text-black/40 dark:text-white/40 mb-4">
          支持多种电子书格式，点击对应按钮下载
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={`/books/${slug}/read/`}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-black dark:bg-white text-white dark:text-black text-sm hover:opacity-80 transition-opacity"
          >
            <Icon name="bookOpen" class="w-4 h-4" />
            在线阅读
          </a>
          {article.data.epubUrl && (
            <a
              href={article.data.epubUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-black dark:bg-white text-white dark:text-black text-sm hover:opacity-80 transition-opacity"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              EPUB 下载
            </a>
          )}
          {article.data.mobiUrl && (
            <a
              href={article.data.mobiUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              MOBI 下载
            </a>
          )}
          {article.data.azw3Url && (
            <a
              href={article.data.azw3Url}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              AZW3 下载
            </a>
          )}
          {article.data.fb2Url && (
            <a
              href={article.data.fb2Url}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              FB2 下载
            </a>
          )}
          {article.data.txtUrl && (
            <a
              href={article.data.txtUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              TXT 下载
            </a>
          )}
          {article.data.pdfUrl && (
            <a
              href={article.data.pdfUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              PDF 下载
            </a>
          )}
        </div>
      </div>
    )}

    <!-- 上一篇 / 下一篇：与正文列对齐（桌面端右侧留出与目录同宽的空白列） -->
    <nav class="mt-12 article-prevnext" data-reveal>
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_220px] xl:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 xl:gap-14">
        <div class="min-w-0 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevArticle ? (
            <a
              href={`/${section}/${prevArticle.id}`}
              class="group p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-colors relative overflow-hidden" data-spotlight
            >
              <p class="text-xs text-black/30 dark:text-white/30 mb-1 inline-flex items-center gap-1"><Icon name="arrowLeft" class="w-3 h-3" /> 上一篇</p>
              <p class="text-sm font-medium group-hover:text-black dark:group-hover:text-white transition-colors line-clamp-2">
                {prevArticle.data.title}
              </p>
            </a>
          ) : (
            <span></span>
          )}
          {nextArticle ? (
            <a
              href={`/${section}/${nextArticle.id}`}
              class="group p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-colors sm:text-right relative overflow-hidden" data-spotlight
            >
              <p class="text-xs text-black/30 dark:text-white/30 mb-1 inline-flex items-center gap-1">下一篇 <Icon name="arrowRight" class="w-3 h-3" /></p>
              <p class="text-sm font-medium group-hover:text-black dark:group-hover:text-white transition-colors line-clamp-2">
                {nextArticle.data.title}
              </p>
            </a>
          ) : (
            <span></span>
          )}
        </div>
        <!-- 占位列：桌面端与右侧目录栏对齐，保持导航与正文左对齐 -->
        <div class="hidden lg:block article-prevnext-spacer" aria-hidden="true"></div>
      </div>
    </nav>

  </article>
</BaseLayout>
