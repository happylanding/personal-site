---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ColumnIcon from "../../components/ColumnIcon.astro";
import Icon from "../../components/Icon.astro";
import ArticleTOC from "../../components/ArticleTOC.astro";
import { SECTION_COLORS, SECTION_COLORS_DARK } from "../../lib/sections";

const columnNames: Record<string, string> = {
  insights: "行业洞察",
  ai: "AI 学习",
  tips: "实用技巧",
  books: "阅读思考",
};

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { section: article.data.section, slug: article.id },
  }));
}

const { section, slug } = Astro.params;

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const article = allArticles.find((a) => a.id === slug && a.data.section === section);
if (!article) return Astro.redirect("/404");

const { Content } = await render(article);

const displayTitle = article.data.title;
const displayDesc = article.data.description;
const displayTags = article.data.tags;
const dateStr = article.data.date.toLocaleDateString("zh-CN", {
  year: "numeric", month: "long", day: "numeric",
});
const isBook = section === "books";
const isCopyright = isBook && !!article.data.copyright;
const ogImage = article.data.ogImage || "/favicon.svg";

// 书本详情页的「阅读感悟」：通过书 frontmatter 的 reflectionSlugs（站主独立读后感文章的 slug 数组）
// 解析出对应的已发布文章。一本书可挂多篇；若为空则整块隐藏。
// 感悟文章不限定栏目，只要存在其 slug 对应文章即可，链接按其实际栏目+slug 生成。
const reflectionSlugs = (article.data.reflectionSlugs || []) as string[];
const reflections = isBook
  ? reflectionSlugs
      .map((rslug) => allArticles.find((a) => a.id === rslug))
      .filter((a): a is NonNullable<typeof a> => !!a && !a.data.draft)
  : [];

// 同栏目内按时间排序，用于上一篇 / 下一篇（隐藏附属文章不参与上下篇）
const nonHidden = allArticles.filter((a) => !a.data.hidden);
const sectionArticles = nonHidden
  .filter((a) => a.data.section === section)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const idx = sectionArticles.findIndex((a) => a.id === slug);
const prevArticle = idx > 0 ? sectionArticles[idx - 1] : undefined;
const nextArticle = idx >= 0 && idx < sectionArticles.length - 1 ? sectionArticles[idx + 1] : undefined;
---

<BaseLayout title={displayTitle} description={displayDesc} ogImage={ogImage}>
  <Breadcrumb
    crumbs={[
      { label: columnNames[section], href: `/${section}/` },
      { label: displayTitle, href: "#" },
    ]}
  />

  <article data-reveal
    style={{
      "--toc-accent": SECTION_COLORS[section as keyof typeof SECTION_COLORS],
      "--toc-accent-dark": SECTION_COLORS_DARK[section as keyof typeof SECTION_COLORS_DARK],
    }}
  >
    <header class="mb-10">
      {!isBook && article.data.ogImage && (
        <img
          src={article.data.ogImage.replace(/\.png$/, ".webp")}
          alt={displayTitle}
          class="w-full rounded-xl border border-black/10 dark:border-white/10 shadow-sm mb-6"
          width="1200"
          height="630"
          loading="eager"
          decoding="async"
        />
      )}

      <div class="flex items-center gap-3 mb-4">
        <span class="text-[13px] px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75 inline-flex items-center gap-1">
          <ColumnIcon section={section as import("../lib/sections").SectionKey} class="w-3 h-3" /> {columnNames[section]}
        </span>
        {article.data.featured && (
          <span class="text-xs px-2 py-0.5 rounded-full bg-black dark:bg-white text-white dark:text-black inline-flex items-center gap-1">
            <Icon name="star" class="w-3 h-3" /> 精选
          </span>
        )}
      </div>

      <h1 class="text-3xl md:text-4xl font-serif font-bold leading-tight mb-4 lmask">
        <span class="lmask-inner" style="--lmask-delay:0.1s"><span>{displayTitle}</span></span>
      </h1>

      {displayDesc && (
        <p class="text-base text-black/50 dark:text-white/50 mb-4 leading-relaxed max-w-3xl">{displayDesc}</p>
      )}

      <div class="flex flex-wrap items-center gap-4 text-sm text-black/45 dark:text-white/60 font-mono">
        <time datetime={article.data.date.toISOString()}>
          发布于 {dateStr}
        </time>
        {article.data.author && (
          <span>作者: {article.data.author}</span>
        )}
      </div>

      {displayTags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {displayTags.map((tag: string) => (
            <span class="text-[13px] px-2 py-1 rounded-md bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75">
              #{tag}
            </span>
          ))}
        </div>
      )}

    </header>

    <div id="article-grid" class="article-grid lg:grid lg:grid-cols-[minmax(0,1fr)_220px] xl:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 xl:gap-14">
      <!-- 正文 -->
      <div class="min-w-0 order-1">
        <div class="prose dark:prose-invert article-content">
          <Content />
        </div>
      </div>

      <!-- 右侧 sticky 目录（lg+ 显示 rail；移动端/平板显示折叠卡片，均由组件内响应式 class 控制） -->
      <div class="min-w-0 order-2">
        <ArticleTOC
          label="目录"
          countFormat="{count} 节"
          sectionColor={SECTION_COLORS[section as keyof typeof SECTION_COLORS]}
          sectionColorDark={SECTION_COLORS_DARK[section as keyof typeof SECTION_COLORS_DARK]}
        />
      </div>
    </div>

    <!-- Book-specific: 阅读感悟（正文之后、资源区之前；无感悟文章则整块隐藏） -->
    {isBook && reflections.length > 0 && (
      <section class="mt-12" data-reveal>
        <div class="flex items-center gap-2 mb-4">
          <h3 class="font-bold font-serif text-xl">阅读感悟</h3>
          <span class="text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/50 dark:text-white/60">
            {reflections.length} 篇
          </span>
        </div>
        <div class="space-y-4">
          {reflections
            .slice()
            .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
            .map((ref) => {
              const refDate = ref.data.date.toLocaleDateString("zh-CN", {
                year: "numeric", month: "long", day: "numeric",
              });
              const refPath = `/${ref.data.section}/${ref.id}`;
              return (
                <a
                  href={refPath}
                  class="group block p-5 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 hover:bg-black/[0.02] dark:hover:bg-white/[0.03] transition-colors relative overflow-hidden"
                  data-spotlight
                >
                  <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 mt-1 text-[11px] px-2 py-1 rounded-md bg-black/[0.04] dark:bg-white/[0.06] inline-flex items-center gap-1.5 text-black/50 dark:text-white/70">
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z" transform="translate(3 0)"/>
                        <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z" transform="translate(-9 0)"/>
                      </svg>
                      阅读感悟
                    </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="font-bold font-serif group-hover:text-black dark:group-hover:text-white transition-colors hover-scale-text">
                        {ref.data.title}
                      </h4>
                      {ref.data.description && (
                        <p class="text-sm text-black/45 dark:text-white/55 leading-relaxed mt-1 line-clamp-2">
                          {ref.data.description}
                        </p>
                      )}
                      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2 text-xs text-black/40 dark:text-white/50 font-mono">
                        <time datetime={ref.data.date.toISOString()}>{refDate}</time>
                        {ref.data.tags.slice(0, 3).map((tag: string) => (
                          <span class="text-[12px] text-black/45 dark:text-white/60">#{tag}</span>
                        ))}
                      </div>
                    </div>
                    <svg class="flex-shrink-0 w-5 h-5 mt-2 text-black/25 dark:text-white/25 group-hover:text-black/60 dark:group-hover:text-white/60 group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                    </svg>
                  </div>
                </a>
              );
            })}
        </div>
      </section>
    )}

    <!-- Book-specific: format download section -->
    {isBook && (
      <div class="mt-12 p-6 rounded-xl border border-black/10 dark:border-white/10" data-reveal>
        <h3 class="font-bold font-serif mb-3">资源</h3>
        {isCopyright ? (
          <div class="mb-4 p-4 rounded-lg bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/30">
            <p class="text-sm font-medium text-amber-800 dark:text-amber-300">
              版权声明
            </p>
            <p class="text-sm text-amber-800/90 dark:text-amber-300/90 mt-1 leading-relaxed">
              本书为受版权保护作品，本站不提供文件下载与在线阅读。如需阅读，请通过正规渠道购买正版支持作者。
            </p>
          </div>
        ) : (
          <p class="text-xs text-black/40 dark:text-white/40 mb-4">
            公版书支持在线阅读与下载
          </p>
        )}
        <div class="flex flex-wrap gap-3">
          {article.data.readUrl && !isCopyright && (
          <a
            href={article.data.readUrl}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-black dark:bg-white text-white dark:text-black text-sm hover:opacity-80 transition-opacity"
          >
            <Icon name="bookOpen" class="w-4 h-4" />
            在线阅读
          </a>
          )}
          {article.data.readUrl && isCopyright && (
          <span
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm text-black/40 dark:text-white/40 cursor-not-allowed select-none"
            title="本书受版权保护，本站不提供在线阅读与文件下载。如需阅读，请通过正规渠道购买正版支持作者。"
          >
            <Icon name="bookOpen" class="w-4 h-4" />
            在线阅读
          </span>
          )}
          {article.data.epubUrl && (
            <a
              href={article.data.epubUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-black dark:bg-white text-white dark:text-black text-sm hover:opacity-80 transition-opacity"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              EPUB 下载
            </a>
          )}
          {article.data.mobiUrl && (
            <a
              href={article.data.mobiUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              MOBI 下载
            </a>
          )}
          {article.data.azw3Url && (
            <a
              href={article.data.azw3Url}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              AZW3 下载
            </a>
          )}
          {article.data.fb2Url && (
            <a
              href={article.data.fb2Url}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              FB2 下载
            </a>
          )}
          {article.data.txtUrl && (
            <a
              href={article.data.txtUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              TXT 下载
            </a>
          )}
          {article.data.pdfUrl && (
            <a
              href={article.data.pdfUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 text-sm hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              download
            >
              <Icon name="download" class="w-4 h-4" />
              PDF 下载
            </a>
          )}
        </div>
      </div>
    )}

    <!-- 上一篇 / 下一篇：与正文列对齐（桌面端右侧留出与目录同宽的空白列） -->
    <nav class="mt-12 article-prevnext" data-reveal>
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_220px] xl:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 xl:gap-14">
        <div class="min-w-0 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevArticle ? (
            <a
              href={`/${section}/${prevArticle.id}`}
              class="group p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-colors relative overflow-hidden" data-spotlight
            >
              <p class="text-xs text-black/30 dark:text-white/30 mb-1 inline-flex items-center gap-1"><Icon name="arrowLeft" class="w-3 h-3" /> 上一篇</p>
              <p class="text-sm font-medium group-hover:text-black dark:group-hover:text-white transition-colors line-clamp-2">
                {prevArticle.data.title}
              </p>
            </a>
          ) : (
            <span></span>
          )}
          {nextArticle ? (
            <a
              href={`/${section}/${nextArticle.id}`}
              class="group p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-colors sm:text-right relative overflow-hidden" data-spotlight
            >
              <p class="text-xs text-black/30 dark:text-white/30 mb-1 inline-flex items-center gap-1">下一篇 <Icon name="arrowRight" class="w-3 h-3" /></p>
              <p class="text-sm font-medium group-hover:text-black dark:group-hover:text-white transition-colors line-clamp-2">
                {nextArticle.data.title}
              </p>
            </a>
          ) : (
            <span></span>
          )}
        </div>
        <!-- 占位列：桌面端与右侧目录栏对齐，保持导航与正文左对齐 -->
        <div class="hidden lg:block article-prevnext-spacer" aria-hidden="true"></div>
      </div>
    </nav>

  </article>
</BaseLayout>
