---
/* Galvin design reminder: traces is a quiet living directory in the pure #10131d workspace.
   Use a medium Chinese title and continuous records, not dashboard numbering or a lifestyle feed. */
import BaseLayout from "../layouts/BaseLayout.astro";

const moments = [
  { label: "南京", title: "把日常留在可继续回看的坐标里", text: "城市不是背景板。它是工作、学习和慢慢理解生活的共同刻度。" },
  { label: "训练", title: "力量训练，练习把注意力放回身体", text: "不追逐短期数字，只记录愿意持续投入的一点时间。" },
  { label: "阅读", title: "读到有用的内容，再把它带回问题里", text: "书架与叩问会继续收纳这些正在发生的连接。" },
];
---

<BaseLayout title="行迹" description="Galvin 的南京、咖啡、力量训练与阅读片段。">
  <section class="galvin-directory-page galvin-traces-page" aria-labelledby="traces-title">
    <header class="galvin-directory-intro galvin-traces-page__hero">
      <p class="galvin-page-kicker"><span aria-hidden="true"></span>慢速记录</p>
      <h1 id="traces-title">行迹</h1>
      <p>南京、咖啡、力量训练与阅读，留在同一条慢速轨迹里。</p>
    </header>
    <div class="galvin-traces-page__list">
      {moments.map((moment) => (
        <article>
          <p>{moment.label}</p>
          <div><h2>{moment.title}</h2><p>{moment.text}</p></div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
