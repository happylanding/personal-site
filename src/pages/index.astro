---
import BaseLayout from "../layouts/BaseLayout.astro";
import ColumnIcon from "../components/ColumnIcon.astro";
import Icon from "../components/Icon.astro";
import Currently from "../components/Currently.astro";
import { getCollection } from "astro:content";
import { SECTION_ORDER, type SectionKey } from "../lib/sections";
import { getMotto, SEASON_COLORS } from "../lib/solarTerms";

const text = {
  motto: "From curiosity to creation.",
  subtitle: "从好奇，到创造",
  title: "Galvin",
  intro: "终身学习者，扎根数字经济行业，热爱 AI 学习与知识分享。探索 AI、行业洞察与生产力工具的交汇点，记录成长路上的思考与实践。",
  exploreColumns: "探索专栏",
  columnsDesc: "四个方向，构建个人知识体系",
  columnsName: { insights: "行业洞察", ai: "AI 学习", tips: "实用技巧", books: "阅读思考" },
  columnsEnName: { insights: "Industry Insights", ai: "AI Learning", tips: "Practical Tips", books: "Reading & Thinking" },
  columnsDesc2: {
    insights: "数字经济与产业观察，记录我在这个行业里的一点见闻和思考",
    ai: "AI 工具实测、学习路径与实战笔记，从入门到上手，一起慢慢摸索",
    tips: "效率工具、办公技巧与折腾心得，让技术为你所用",
    books: "书评与阅读笔记，经典好书支持在线阅读与下载",
  },
  featured: "精选",
  latestArticles: "最新文章",
  viewAll: "查看全部",
  noArticles: "暂无文章",
};

// Hero 眉标：节日优先、节气兜底的题记（构建时计算，静态输出）
const term = getMotto();
const termAccent = SEASON_COLORS[term.season];

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const sorted = allArticles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = sorted.slice(0, 5);
const featured = sorted.filter((a) => a.data.featured).slice(0, 4);

// Count per section
const counts = SECTION_ORDER.reduce<Record<string, number>>((acc, s) => {
  acc[s] = allArticles.filter((a) => a.data.section === s).length;
  return acc;
}, {});
---

<BaseLayout>
  <!-- ===== Hero: 大气封面（oil 同款超大字号 + 星野极光背景） ===== -->
  <section class="hero-section pt-24 pb-20 md:pt-36 md:pb-28 text-center relative overflow-hidden">
    <!-- 视差背景装饰层：极光 + 星野 + 光尘 + 巨型品牌字（只动背景，不动正文） -->
    <div class="hero-parallax" aria-hidden="true">
      <div class="hp-layer hp-layer-1"><span class="hp-glow hp-glow-1"></span></div>
      <div class="hp-layer hp-layer-2"><span class="hp-glow hp-glow-2"></span></div>
      <div class="hp-stars"></div>
      <span class="hp-dust hp-dust-1"></span>
      <span class="hp-dust hp-dust-2"></span>
      <span class="hp-dust hp-dust-3"></span>
      <span class="hp-dust hp-dust-4"></span>
      <span class="hp-mega-name">GALVIN</span>
    </div>

    <div class="hero-content">
      <!-- 时令 / 节日题记：节日优先、节气兜底（如：立秋 · 云天收夏色 / 七夕 · 金风玉露一相逢） -->
      <p class="hero-eyebrow mb-8" style={`--term-accent:${termAccent}`}>
        <span class="hero-term-dot" aria-hidden="true"></span>
        <span class="hero-term-name">{term.zh}</span>
        <span class="hero-term-sep" aria-hidden="true"></span>
        <span class="hero-term-line">{term.lineZh}</span>
      </p>

      <!-- 英文座右铭：超大手写体 -->
      <p class="hero-motto mb-5 lmask">
        <span class="lmask-inner" style="--lmask-delay:0.1s">{text.motto}</span>
      </p>

      <!-- 中文标语：超大衬线 + 渐变字 -->
      <h1 class="hero-subtitle mb-9 lmask">
        <span class="lmask-inner" style="--lmask-delay:0.24s">{text.subtitle}</span>
      </h1>

      <!-- Bio paragraph -->
      <p class="hero-intro">
        {text.title} · writer, learner. <br/>
        {text.intro}
      </p>
    </div>

    <!-- Divider ornament -->
    <div class="mt-14 mb-4 flex justify-center" aria-hidden="true">
      <span class="block w-24 h-px bg-gradient-to-r from-transparent via-black/15 dark:via-white/15 to-transparent"></span>
    </div>
  </section>

  <!-- ===== Currently: what I'm doing now ===== -->
  <section class="mb-16" data-reveal>
    <Currently />
  </section>

  <!-- ===== 4 Column cards ===== -->
  <section class="mb-20">
    <div class="fx-section-head justify-center mb-3">
      <span class="fx-sec-index" aria-hidden="true">NO.01</span>
      <h2 class="text-center text-lg font-bold font-serif">{text.exploreColumns}</h2>
      <span class="fx-sec-bar" aria-hidden="true"></span>
    </div>
    <p class="text-center text-sm text-black/40 dark:text-white/40 mb-8">{text.columnsDesc}</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {SECTION_ORDER.map((s, i) => {
        const colPath = `/${s}/`;
        return (
          <a
            href={colPath}
            class="roll-card group block p-6 rounded-xl border border-black/10 dark:border-white/10 hover-lift transition-all duration-300 hover:border-black/30 dark:hover:border-white/30 relative overflow-hidden"
            style={`--roll-index:${i}`}
            data-spotlight
            data-tilt
            data-c-accent={s}
          >
            <span class="ghost-num text-black/10 dark:text-white/20 select-none pointer-events-none" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="mb-3 block opacity-80 dark:opacity-100 relative"><ColumnIcon section={s} class="w-8 h-8" /></span>
            <h3 class="font-bold text-base mb-1 hover-glow relative">
              {text.columnsName[s]}
            </h3>
            <p class="text-xs text-black/40 dark:text-white/40 mb-3 relative">
              {text.columnsEnName[s]}
            </p>
            <p class="text-sm text-black/50 dark:text-white/50 leading-relaxed mb-3 relative">
              {text.columnsDesc2[s]}
            </p>
            <span class="text-[13px] text-black/45 dark:text-white/60 font-mono relative">
              <span data-count-up={counts[s] || 0}>0</span> 篇文章
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ===== Divider ornament ===== -->
  <div class="flex justify-center mb-16" aria-hidden="true">
    <span class="block w-24 h-px bg-gradient-to-r from-transparent via-black/15 dark:via-white/15 to-transparent"></span>
  </div>

  <!-- ===== Featured articles ===== -->
  {featured.length > 0 && (
    <section class="mb-16" data-reveal>
      <div class="fx-section-head mb-8">
        <span class="fx-sec-index" aria-hidden="true">NO.02</span>
        <h2 class="text-lg font-bold font-serif inline-flex items-center gap-2">
          <Icon name="sparkles" class="w-5 h-5 text-black/40 dark:text-white/40" />
          {text.featured}
        </h2>
        <span class="fx-sec-bar" aria-hidden="true"></span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {featured.map((a) => {
          const title = a.data.title;
          const desc = a.data.description;
          return (
            <a
              href={`/${a.data.section}/${a.id}`}
              class="roll-card group block p-5 rounded-xl border border-black/10 dark:border-white/10 hover-lift transition-all duration-300 hover:border-black/30 dark:hover:border-white/30 relative overflow-hidden"
              data-spotlight
              data-c-accent={a.data.section as SectionKey}
            >
              <div class="flex items-center gap-2 mb-3">
                <span class="text-[13px] px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75 inline-flex items-center gap-1">
                  <ColumnIcon section={a.data.section as SectionKey} class="w-3 h-3" />
                  {text.columnsName[a.data.section]}
                </span>
                <span class="text-[13px] text-black/45 dark:text-white/60 font-mono">
                  {a.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "short", day: "numeric" })}
                </span>
              </div>
              <h3 class="font-bold font-serif text-base mb-2 group-hover:text-black dark:group-hover:text-white transition-colors leading-snug hover-scale-text">{title}</h3>
              {desc && <p class="text-sm text-black/40 dark:text-white/40 line-clamp-2 leading-relaxed">{desc}</p>}
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- ===== Latest articles ===== -->
  <section data-reveal>
    <div class="flex items-center justify-between mb-8">
      <div class="fx-section-head">
        <span class="fx-sec-index" aria-hidden="true">NO.03</span>
        <h2 class="text-lg font-bold font-serif">{text.latestArticles}</h2>
        <span class="fx-sec-bar" aria-hidden="true"></span>
      </div>
      <a
        href="/archive/"
        class="text-sm text-black/40 dark:text-white/40 hover:opacity-70 transition-opacity inline-flex items-center gap-1"
      >
        {text.viewAll}
        <Icon name="arrowRight" class="w-3.5 h-3.5" />
      </a>
    </div>

    {latest.length > 0 ? (
      <div class="space-y-2">
        {latest.map((a) => (
          <a
            href={`/${a.data.section}/${a.id}`}
            class="latest-row flex items-center justify-between py-3 px-4 rounded-lg hover:bg-black/[0.03] dark:hover:bg-white/[0.03] transition-colors group overflow-hidden"
            data-c-accent={a.data.section as SectionKey}
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="flex-shrink-0 opacity-75 dark:opacity-100"><ColumnIcon section={a.data.section as SectionKey} class="w-4 h-4" /></span>
              <span class="text-sm font-medium truncate group-hover:text-black dark:group-hover:text-white transition-colors hover-scale-text">
                {a.data.title}
              </span>
            </div>
            <time class="text-[13px] text-black/45 dark:text-white/60 font-mono flex-shrink-0 ml-4">
              {a.data.date.toLocaleDateString("zh-CN", { month: "short", day: "numeric" })}
            </time>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-sm text-black/30 dark:text-white/30 italic">{text.noArticles}</p>
    )}
  </section>
</BaseLayout>
