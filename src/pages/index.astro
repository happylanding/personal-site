---
import BaseLayout from "../layouts/BaseLayout.astro";
import ColumnIcon from "../components/ColumnIcon.astro";
import Icon from "../components/Icon.astro";
import Currently from "../components/Currently.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getCollection } from "astro:content";
import { SECTION_ORDER, type SectionKey } from "../lib/sections";
import { getCurrentTerm, SEASON_COLORS } from "../lib/solarTerms";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Hero 眉标：时令题记——随二十四节气轮换的物候短句（构建时计算，静态输出）
const term = getCurrentTerm();
const termAccent = SEASON_COLORS[term.season];

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const sorted = allArticles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = sorted.slice(0, 5);
const featured = sorted.filter((a) => a.data.featured).slice(0, 4);

// Count per section
const counts = SECTION_ORDER.reduce<Record<string, number>>((acc, s) => {
  acc[s] = allArticles.filter((a) => a.data.section === s).length;
  return acc;
}, {});
---

<BaseLayout>
  <!-- ===== Hero: 大气封面（oil 同款超大字号 + 星野极光背景） ===== -->
  <section class="hero-section pt-24 pb-20 md:pt-36 md:pb-28 text-center relative overflow-hidden">
    <!-- 视差背景装饰层：极光 + 星野 + 光尘 + 巨型品牌字（只动背景，不动正文） -->
    <div class="hero-parallax" aria-hidden="true">
      <div class="hp-layer hp-layer-1"><span class="hp-glow hp-glow-1"></span></div>
      <div class="hp-layer hp-layer-2"><span class="hp-glow hp-glow-2"></span></div>
      <div class="hp-stars"></div>
      <span class="hp-dust hp-dust-1"></span>
      <span class="hp-dust hp-dust-2"></span>
      <span class="hp-dust hp-dust-3"></span>
      <span class="hp-dust hp-dust-4"></span>
      <span class="hp-mega-name">GALVIN</span>
    </div>

    <div class="hero-content">
      <!-- 时令题记：随二十四节气轮换（如：中国 · 立秋 · 云天收夏色） -->
      <p class="hero-eyebrow mb-8" style={`--term-accent:${termAccent}`}>
        <span class="hero-term-dot" aria-hidden="true"></span>
        <span class="hero-term-loc">{t("home.location")}</span>
        <span class="hero-term-sep" aria-hidden="true"></span>
        <span class="hero-term-name">{lang === "en" ? term.en : term.zh}</span>
        <span class="hero-term-line">{lang === "en" ? term.lineEn : term.lineZh}</span>
      </p>

      <!-- 英文座右铭：超大手写体 -->
      <p class="hero-motto mb-5 lmask">
        <span class="lmask-inner" style="--lmask-delay:0.1s">{t("site.motto")}</span>
      </p>

      <!-- 中文标语：超大衬线 + 渐变字 -->
      <h1 class="hero-subtitle mb-9 lmask">
        <span class="lmask-inner" style="--lmask-delay:0.24s">{t("site.subtitle")}</span>
      </h1>

      <!-- Bio paragraph -->
      <p class="hero-intro">
        {t("site.title")} · writer, learner. <br/>
        {t("home.intro")}
      </p>
    </div>

    <!-- Divider ornament -->
    <div class="mt-14 mb-4 flex justify-center" aria-hidden="true">
      <span class="block w-24 h-px bg-gradient-to-r from-transparent via-black/15 dark:via-white/15 to-transparent"></span>
    </div>
  </section>

  <!-- ===== Currently: what I'm doing now ===== -->
  <section class="mb-16" data-reveal>
    <Currently />
  </section>

  <!-- ===== 4 Column cards ===== -->
  <section class="mb-20">
    <div class="fx-section-head justify-center mb-3">
      <span class="fx-sec-index" aria-hidden="true">NO.01</span>
      <h2 class="text-center text-lg font-bold font-serif">{t("home.exploreColumns")}</h2>
      <span class="fx-sec-bar" aria-hidden="true"></span>
    </div>
    <p class="text-center text-sm text-black/40 dark:text-white/40 mb-8">{t("home.columnsDesc")}</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {SECTION_ORDER.map((s, i) => {
        const colPath = lang === "en" ? `/en/${s}/` : `/${s}/`;
        return (
          <a
            href={colPath}
            class="roll-card group block p-6 rounded-xl border border-black/10 dark:border-white/10 hover-lift transition-all duration-300 hover:border-black/30 dark:hover:border-white/30 relative overflow-hidden"
            style={`--roll-index:${i}`}
            data-spotlight
            data-tilt
            data-c-accent={s}
          >
            <span class="ghost-num text-black/5 dark:text-white/5 select-none pointer-events-none" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="mb-3 block opacity-60 relative"><ColumnIcon section={s} class="w-8 h-8" /></span>
            <h3 class="font-bold text-base mb-1 group-hover:opacity-70 transition-opacity hover-glow relative">
              {t(`columns.${s}.name`)}
            </h3>
            <p class="text-xs text-black/40 dark:text-white/40 mb-3 relative">
              {t(`columns.${s}.enName`)}
            </p>
            <p class="text-sm text-black/50 dark:text-white/50 leading-relaxed mb-3 relative">
              {t(`columns.${s}.desc`)}
            </p>
            <span class="text-xs text-black/25 dark:text-white/25 font-mono relative">
              <span data-count-up={counts[s] || 0}>0</span> {lang === "en" ? "articles" : "篇文章"}
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ===== Divider ornament ===== -->
  <div class="flex justify-center mb-16" aria-hidden="true">
    <span class="block w-24 h-px bg-gradient-to-r from-transparent via-black/15 dark:via-white/15 to-transparent"></span>
  </div>

  <!-- ===== Featured articles ===== -->
  {featured.length > 0 && (
    <section class="mb-16" data-reveal>
      <div class="fx-section-head mb-8">
        <span class="fx-sec-index" aria-hidden="true">NO.02</span>
        <h2 class="text-lg font-bold font-serif inline-flex items-center gap-2">
          <Icon name="sparkles" class="w-5 h-5 text-black/40 dark:text-white/40" />
          {t("articles.featured")}
        </h2>
        <span class="fx-sec-bar" aria-hidden="true"></span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {featured.map((a) => {
          const title = lang === "en" ? (a.data.titleEn || a.data.title) : a.data.title;
          const desc = lang === "en" ? (a.data.descriptionEn || a.data.description) : a.data.description;
          return (
            <a
              href={lang === "en" ? `/en/${a.data.section}/${a.id}` : `/${a.data.section}/${a.id}`}
              class="roll-card group block p-5 rounded-xl border border-black/10 dark:border-white/10 hover-lift transition-all duration-300 hover:border-black/30 dark:hover:border-white/30 relative overflow-hidden"
              data-spotlight
              data-c-accent={a.data.section as SectionKey}
            >
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/50 dark:text-white/50 inline-flex items-center gap-1">
                  <ColumnIcon section={a.data.section as SectionKey} class="w-3 h-3" />
                  {t(`columns.${a.data.section}.name`)}
                </span>
                <span class="text-xs text-black/25 dark:text-white/25 font-mono">
                  {a.data.date.toLocaleDateString(lang === "en" ? "en-US" : "zh-CN", { year: "numeric", month: "short", day: "numeric" })}
                </span>
              </div>
              <h3 class="font-bold font-serif text-base mb-2 group-hover:opacity-70 transition-opacity leading-snug">{title}</h3>
              {desc && <p class="text-sm text-black/40 dark:text-white/40 line-clamp-2 leading-relaxed">{desc}</p>}
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- ===== Latest articles ===== -->
  <section data-reveal>
    <div class="flex items-center justify-between mb-8">
      <div class="fx-section-head">
        <span class="fx-sec-index" aria-hidden="true">NO.03</span>
        <h2 class="text-lg font-bold font-serif">{t("home.latestArticles")}</h2>
        <span class="fx-sec-bar" aria-hidden="true"></span>
      </div>
      <a
        href={lang === "en" ? "/en/archive/" : "/archive/"}
        class="text-sm text-black/40 dark:text-white/40 hover:opacity-70 transition-opacity inline-flex items-center gap-1"
      >
        {t("home.viewAll")}
        <Icon name="arrowRight" class="w-3.5 h-3.5" />
      </a>
    </div>

    {latest.length > 0 ? (
      <div class="space-y-2">
        {latest.map((a) => (
          <a
            href={lang === "en" ? `/en/${a.data.section}/${a.id}` : `/${a.data.section}/${a.id}`}
            class="latest-row flex items-center justify-between py-3 px-4 rounded-lg hover:bg-black/[0.03] dark:hover:bg-white/[0.03] transition-colors group"
            data-c-accent={a.data.section as SectionKey}
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="flex-shrink-0 opacity-40"><ColumnIcon section={a.data.section as SectionKey} class="w-4 h-4" /></span>
              <span class="text-sm font-medium truncate group-hover:opacity-70 transition-opacity hover-scale-text">
                {lang === "en" ? (a.data.titleEn || a.data.title) : a.data.title}
              </span>
            </div>
            <time class="text-xs text-black/25 dark:text-white/25 font-mono flex-shrink-0 ml-4">
              {a.data.date.toLocaleDateString(lang === "en" ? "en-US" : "zh-CN", { month: "short", day: "numeric" })}
            </time>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-sm text-black/30 dark:text-white/30 italic">{t("articles.noArticles")}</p>
    )}
  </section>
</BaseLayout>
