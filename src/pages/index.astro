---
/* Galvin design reminder: this is an asymmetric AI editorial workspace, not a SaaS dashboard.
   Typography carries the thesis; the right-hand signal panel is the single theatrical visual moment. */
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import SignalTrail from "../components/SignalTrail.astro";
import { getCollection } from "astro:content";
import { GALVIN_NAVIGATION } from "../lib/galvin-navigation";

const articles = await getCollection("articles", ({ data }) => !data.draft);
const latestArticles = articles
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const recentArticle = latestArticles[0];
const displayDate = (date: Date) =>
  date.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<BaseLayout>
  <div class="galvin-home">
    <section class="galvin-hero" aria-labelledby="galvin-hero-title">
      <div class="galvin-hero__grid">
        <div class="galvin-hero__copy">
          <p class="galvin-eyebrow"><span class="galvin-eyebrow__dot"></span>GALVIN / 个人 AI 学习与创作空间</p>
          <h1 id="galvin-hero-title">把好奇心，<br />做成一点<strong>有用的东西。</strong></h1>
          <p class="galvin-hero__intro">
            一位数字政府与数字经济从业者的 AI 学习现场。这里记录工具、思考、方法和还在发生的生活。
          </p>
          <div class="galvin-hero__actions">
            <a class="galvin-button galvin-button--primary" href="/archive">
              阅读最近的叩问 <Icon name="arrowRight" class="w-4 h-4" />
            </a>
            <a class="galvin-button galvin-button--quiet" href="/tools">查看正在造的东西</a>
          </div>
        </div>

        <aside class="galvin-signal-panel" aria-label="当前信号">
          <div class="galvin-signal-panel__topline">
            <span>CURRENT SIGNAL</span>
            <span class="galvin-signal-panel__live"><i></i> 更新中</span>
          </div>
          <div class="galvin-signal-panel__body">
            <span class="galvin-signal-panel__number">001</span>
            <div>
              <p class="galvin-signal-panel__label">正在搭建</p>
              <h2>Galvin V1<br />个人 AI 工作空间</h2>
            </div>
          </div>
          <div class="galvin-signal-panel__detail">
            <span class="galvin-status-chip">STRUCTURE</span>
            <p>先让内容有秩序，再让每一次探索留下轨迹。</p>
          </div>
          <div class="galvin-signal-panel__meter" aria-hidden="true"><span></span></div>
        </aside>
      </div>
      <SignalTrail />
    </section>

    <section class="galvin-index-section" aria-labelledby="galvin-index-title">
      <div class="galvin-section-heading">
        <div>
          <p class="galvin-section-heading__eyebrow">CONTENT INDEX</p>
          <h2 id="galvin-index-title">七个入口，<span>一条持续展开的轨迹。</span></h2>
        </div>
        <p>不急着把内容填满。每个栏目都留给正在成为的部分。</p>
      </div>
      <div class="galvin-index-grid">
        {GALVIN_NAVIGATION.map((item) => (
          <a class="galvin-index-card" href={item.href}>
            <span class="galvin-index-card__number">{item.index}</span>
            <span class="galvin-index-card__label">{item.label}</span>
            <Icon name="arrowUpRight" class="galvin-index-card__icon w-4 h-4" />
          </a>
        ))}
      </div>
    </section>

    <section class="galvin-latest" aria-labelledby="galvin-latest-title">
      <div class="galvin-section-heading galvin-section-heading--compact">
        <div>
          <p class="galvin-section-heading__eyebrow">RECENT NOTES</p>
          <h2 id="galvin-latest-title">最近留下的<span>问题和做法。</span></h2>
        </div>
        <a class="galvin-text-link" href="/archive">全部文章 <Icon name="arrowRight" class="w-4 h-4" /></a>
      </div>
      <div class="galvin-latest__list">
        {latestArticles.map((article, index) => (
          <a class="galvin-article-row" href={`/${article.data.section}/${article.id}`}>
            <span class="galvin-article-row__index">0{index + 1}</span>
            <div>
              <p>{article.data.tags[0] || "记录"} · {displayDate(article.data.date)}</p>
              <h3>{article.data.title}</h3>
            </div>
            <Icon name="arrowUpRight" class="w-4 h-4" />
          </a>
        ))}
        {!recentArticle && <p class="galvin-empty-state">第一条正在路上。</p>}
      </div>
    </section>
  </div>
</BaseLayout>
