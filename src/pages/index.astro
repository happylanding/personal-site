---
/* Galvin design reminder: homepage is the only display-led page in a pure #10131d workspace.
   The thesis leads; `此刻` is a static low-weight annotation, never a background effect. */
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { getCollection } from "astro:content";
import { GALVIN_NAVIGATION, GALVIN_RESOURCE_NAVIGATION } from "../lib/galvin-navigation";

const articles = await getCollection("articles", ({ data }) => !data.draft);
const latestArticles = articles
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const recentArticle = latestArticles[0];
const displayDate = (date: Date) =>
  date.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<BaseLayout>
  <div class="galvin-home">
    <section class="galvin-hero galvin-hero--reading-runway" aria-labelledby="galvin-hero-title">
      <div class="galvin-hero__grid">
        <div class="galvin-hero__copy">
          <p class="galvin-eyebrow"><span class="galvin-eyebrow__dot"></span>Galvin · 个人 AI 学习与创作空间</p>
          <h1 id="galvin-hero-title">把好奇心，做成一点有用的东西。</h1>
          <p class="galvin-hero__intro">
            一位数字政府与数字经济从业者的 AI 学习现场。这里记录工具、思考、方法和还在发生的生活。
          </p>
          <div class="galvin-hero__actions">
            <a class="galvin-button galvin-button--primary" href="/archive">
              阅读最近的叩问 <Icon name="arrowRight" class="w-4 h-4" />
            </a>
            <a class="galvin-button galvin-button--quiet" href="/tools">查看正在造的东西</a>
          </div>
        </div>

        <aside class="galvin-current-note" aria-label="此刻正在推进">
          <div><span aria-hidden="true"></span><p>此刻</p></div>
          <strong>正在搭建 Galvin V1</strong>
          <p>先让内容有秩序，再让每一次探索留下轨迹。</p>
        </aside>
      </div>
    </section>

    <section class="galvin-path-section" aria-labelledby="galvin-index-title">
      <header class="galvin-path-section__head">
        <div>
          <p>可以从这里开始</p>
          <h2 id="galvin-index-title">四条主线，<span>一条继续展开的轨道。</span></h2>
        </div>
        <p>不急着把内容填满。每条路径都通往正在发生的学习与创作。</p>
      </header>
      <nav id="home-path-track" class="galvin-path-track" aria-label="Galvin 内容路径">
        {GALVIN_NAVIGATION.map((item) => (
          <a class="galvin-path-track__route" href={item.href}>
            <span>{item.label}</span><Icon name="arrowRight" class="w-4 h-4" />
          </a>
        ))}
        <div class="galvin-path-track__resources" aria-label="藏页资源">
          <p>藏页</p>
          {GALVIN_RESOURCE_NAVIGATION.map((item) => <a href={item.href}>{item.label}<Icon name="arrowRight" class="w-3.5 h-3.5" /></a>)}
        </div>
      </nav>
    </section>

    <section class="galvin-latest" aria-labelledby="galvin-latest-title">
      <div class="galvin-latest__heading">
        <div>
          <p>最近叩问</p>
          <h2 id="galvin-latest-title">最近留下的<span>问题和做法。</span></h2>
        </div>
        <a class="galvin-text-link" href="/archive">全部文章 <Icon name="arrowRight" class="w-4 h-4" /></a>
      </div>
      <div class="galvin-latest__list">
        {latestArticles.map((article, index) => (
          <a class:list={["galvin-article-row", { "galvin-article-row--lead": index === 0 }]} href={`/${article.data.section}/${article.id}`}>
            <div>
              <p>{article.data.tags[0] || "记录"} · {displayDate(article.data.date)}</p>
              <h3>{article.data.title}</h3>
              {index === 0 && article.data.description && <span>{article.data.description}</span>}
            </div>
            <Icon name="arrowUpRight" class="w-4 h-4" />
          </a>
        ))}
        {!recentArticle && <p class="galvin-empty-state">第一条正在路上。</p>}
      </div>
      <a class="galvin-latest__next" href="/archive">下一步，从一篇问题开始 <Icon name="arrowRight" class="w-4 h-4" /></a>
    </section>
  </div>
</BaseLayout>
