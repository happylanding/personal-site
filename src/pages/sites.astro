---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Icon from "../components/Icon.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const isEn = lang === "en";

// 已收录的站点报告（按日期倒序）
const siteEntries = (await getCollection("sites", ({ data }) => !data.draft && !!data.siteUrl))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 从 markdown 正文提取「一句话定位」与「亮点特色总结」小节的首段，供可展开列表展示
function extractSection(content: string, heading: string): string {
  // 匹配 "## 一句话定位\n\n正文..."
  const re = new RegExp(`^##\\s*${heading}\\s*\\n+([\\s\\S]*?)(?=^##\\s|\\Z)`, "m");
  const m = content.match(re);
  if (!m) return "";
  // 取第一段非空文本，去掉 markdown 语法
  const para = m[1]
    .split(/\n\s*\n/)
    .map((s) => s.trim())
    .find((s) => s.length > 0 && !s.startsWith(">") && !s.startsWith("#"));
  if (!para) return "";
  return para
    .replace(/\*\*([^*]+)\*\*/g, "$1")
    .replace(/\*([^*]+)\*/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/\s+/g, " ")
    .trim();
}

// 从中文 + 英文标签自动归并出展示分类
function classify(entry): string {
  const tags = [...(entry.data.tags || []), ...(entry.data.tagsEn || [])].map((x) => x.toLowerCase());
  const has = (...kw: string[]) => tags.some((tag) => kw.some((k) => tag.includes(k)));
  if (has("个人品牌站", "personal-site", "作品集", "portfolio")) return "personal";
  if (has("策展", "日报", "编辑", "curation", "daily", "editorial")) return "curation";
  if (has("教程站", "教程", "course-site", "tutorial", "学习", "开源教育")) return "course";
  if (has("产品", "工具", "知识库", "product", "knowledge-base")) return "product";
  return "other";
}

// 分类展示名（中/英）
const CATEGORY_NAMES = {
  personal: isEn ? "Personal Brands" : "个人品牌站",
  curation: isEn ? "Curation & Editorial" : "策展与编辑",
  course: isEn ? "Courses & Learning" : "教程与学习",
  product: isEn ? "Products & Knowledge" : "产品与知识",
  other: isEn ? "Others" : "其他",
};
const CATEGORY_ORDER = ["personal", "curation", "course", "product", "other"];

// 收集所有用到过的分类（按固定顺序）
const usedCategories = CATEGORY_ORDER.filter((c) => siteEntries.some((e) => classify(e) === c));

// 构建前端数据
const siteData = siteEntries.map((entry) => {
  let body = "";
  try {
    body = readFileSync(join(process.cwd(), "src/content/sites", `${entry.id}.md`), "utf-8");
  } catch {
    body = "";
  }
  const title = isEn ? (entry.data.titleEn || entry.data.title) : entry.data.title;
  const desc = isEn ? (entry.data.descriptionEn || entry.data.description) : entry.data.description;
  const tags = (isEn ? entry.data.tagsEn : entry.data.tags) || [];
  return {
    id: entry.id,
    slug: entry.id,
    title,
    desc,
    host: entry.data.siteUrl ? new URL(entry.data.siteUrl).hostname : "",
    siteUrl: entry.data.siteUrl || "",
    date: entry.data.date.toLocaleDateString(isEn ? "en-US" : "zh-CN", {
      year: "numeric", month: "long", day: "numeric",
    }),
    tags,
    category: classify(entry),
    tagline: extractSection(body, "一句话定位"),
    highlight: extractSection(body, "亮点特色总结"),
    href: isEn ? `/en/sites/${entry.id}/` : `/sites/${entry.id}/`,
  };
});

const updatedDateStr = siteEntries.length
  ? siteEntries[0].data.date.toLocaleDateString(isEn ? "en-US" : "zh-CN", {
      year: "numeric", month: "long", day: "numeric",
    })
  : "";
---

<BaseLayout
  title={isEn ? "Design Inspiration Collection" : "设计灵感收藏夹"}
  description={isEn ? "Great sites & designs I come across, with breakdowns, creative analysis and highlights." : "平时刷到的好网站、好设计都收录在这里，附上拆解、创意分析与亮点特色。"}
>
  <Breadcrumb
    crumbs={[{ label: isEn ? "Collection" : "收藏夹", href: isEn ? "/en/sites/" : "/sites/" }]}
  />

  <section data-reveal>
    <header class="mb-6">
      <div class="flex items-center gap-3">
        <span class="block opacity-70 flex-shrink-0"><Icon name="bookmark" class="w-9 h-9" style="color:#0E96E9" /></span>
        <div>
          <h1 class="text-3xl font-serif font-bold flex items-center gap-3">
            <span>{isEn ? "Design Inspiration Collection" : "设计灵感收藏夹"}</span>
            <span class="text-sm font-mono font-normal px-2.5 py-0.5 rounded-full bg-[#0E96E9]/10 text-[#0E96E9] dark:text-[#6CC3FF]">{siteEntries.length}</span>
          </h1>
          <p class="text-sm text-black/40 dark:text-white/40 mt-1">
            {isEn ? "Curated sites & designs with breakdowns" : "收藏好网站 · 附拆解与创意分析"}
          </p>
        </div>
      </div>
      <p class="text-base text-black/50 dark:text-white/50 mt-4 leading-relaxed max-w-2xl">
        {isEn
          ? "Great sites & designs I come across are archived here — each entry is a breakdown of structure, creative analysis and highlights."
          : "平时刷到的好网站会持续收录在这里，每篇都是一份「网站拆解 + 创意分析 + 亮点特色」报告。"}
      </p>
    </header>

    <!-- 统计条 -->
    <div class="flex flex-wrap items-center gap-x-5 gap-y-1 mb-6 text-[13px] text-black/45 dark:text-white/60 font-mono">
      <span>{isEn ? `共收录 ${siteEntries.length} 篇` : `共收录 ${siteEntries.length} 篇`}</span>
      {updatedDateStr && <span class="inline-flex items-center gap-1"><Icon name="arrowUp" class="w-3 h-3" />{isEn ? "最近更新 " : "最近更新 "}{updatedDateStr}</span>}
      <span class="inline-flex items-center gap-1"><Icon name="list" class="w-3 h-3" />{isEn ? "按收录时间倒序" : "按收录时间倒序"}</span>
    </div>

    <!-- 搜索框 -->
    <div class="relative mb-5">
      <Icon name="search" class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-black/35 dark:text-white/40 pointer-events-none" />
      <input
        id="sites-search"
        type="text"
        class="w-full pl-11 pr-16 py-3 rounded-xl border border-black/10 dark:border-white/10 bg-white dark:bg-neutral-900 focus:outline-none focus:border-[#0E96E9] focus:ring-2 focus:ring-[#0E96E9]/20 transition-all text-sm placeholder:text-black/35 dark:placeholder:text-white/35"
        placeholder={isEn ? "搜索网站名 / 域名 / 描述…" : "搜索网站名 / 域名 / 描述…"}
      />
      <kbd class="absolute right-4 top-1/2 -translate-y-1/2 text-[11px] font-mono px-1.5 py-0.5 rounded border border-black/10 dark:border-white/10 text-black/40 dark:text-white/50 pointer-events-none">
        {isEn ? "⌘K" : "⌘K"}
      </kbd>
    </div>

    <!-- 分组锚点 -->
    <div id="sites-cats" class="flex flex-wrap gap-2 mb-6">
      <button
        data-cat="all"
        class="cat-chip text-[13px] px-3.5 py-1.5 rounded-full border transition-all cursor-pointer border-black/10 dark:border-white/10 text-black/60 dark:text-white/75 hover:border-black/30 dark:hover:border-white/30 cat-active"
      >
        {isEn ? "All" : "全部"}
      </button>
      {usedCategories.map((c) => (
        <button
          data-cat={c}
          class="cat-chip text-[13px] px-3.5 py-1.5 rounded-full border transition-all cursor-pointer border-black/10 dark:border-white/10 text-black/60 dark:text-white/75 hover:border-black/30 dark:hover:border-white/30"
        >
          {CATEGORY_NAMES[c]}
          <span class="opacity-50 ml-1">{siteEntries.filter((e) => classify(e) === c).length}</span>
        </button>
      ))}
    </div>

    <!-- 卡片列表（可展开） -->
    {siteEntries.length > 0 ? (
      <div id="sites-list" class="space-y-3">
        {siteData.map((item, i) => (
          <div
            class="site-card block p-5 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-all duration-300 cursor-pointer group"
            data-id={item.id}
            data-cat={item.category}
            data-search={(item.title + " " + item.host + " " + (item.desc || "") + " " + (item.tags || []).join(" ")).toLowerCase()}
          >
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[13px] font-mono text-black/45 dark:text-white/60">{String(i + 1).padStart(2, "0")}</span>
              {item.host && (
                <span class="text-[13px] px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75 inline-flex items-center gap-1">
                  <Icon name="link" class="w-3 h-3" />{item.host}
                </span>
              )}
              <span class="ml-auto text-xs opacity-30 group-hover:opacity-60 transition-opacity"><Icon name="arrowRight" class="w-3.5 h-3.5" /></span>
            </div>
            <h3 class="font-bold font-serif text-base mb-1.5 leading-snug">{item.title}</h3>
            {item.desc && <p class="text-[15px] text-black/60 dark:text-white/60 line-clamp-2 leading-relaxed">{item.desc}</p>}

            <!-- 展开区 -->
            <div class="site-expand hidden mt-3 pt-3 border-t border-black/5 dark:border-white/5">
              {item.tagline && (
                <div class="mb-2.5">
                  <p class="inline-flex items-center gap-1 text-[12px] font-semibold uppercase tracking-wider mb-1 text-[#0E96E9] dark:text-[#6CC3FF]"><span class="w-1 h-1 rounded-full bg-[#0E96E9] dark:bg-[#6CC3FF]"></span>{isEn ? "One-liner" : "一句话定位"}</p>
                  <p class="text-sm text-black/60 dark:text-white/70 leading-relaxed">{item.tagline}</p>
                </div>
              )}
              {item.highlight && (
                <div class="mb-2.5">
                  <p class="inline-flex items-center gap-1 text-[12px] font-semibold uppercase tracking-wider mb-1 text-[#0E96E9] dark:text-[#6CC3FF]"><span class="w-1 h-1 rounded-full bg-[#0E96E9] dark:bg-[#6CC3FF]"></span>{isEn ? "Highlights" : "亮点特色"}</p>
                  <p class="text-sm text-black/60 dark:text-white/70 leading-relaxed">{item.highlight}</p>
                </div>
              )}
              <a
                href={item.href}
                class="inline-flex items-center gap-1.5 text-[13px] text-[#0E96E9] dark:text-[#6CC3FF] hover:opacity-80 mt-1"
              >
                {isEn ? "Read full breakdown →" : "查看完整拆解 →"}
              </a>
            </div>

            <div class="flex items-center justify-between mt-3">
              <time class="text-[13px] text-black/55 dark:text-white/65 font-mono inline-flex items-center gap-1.5"><Icon name="calendar" class="w-3.5 h-3.5 opacity-70" />{item.date}</time>
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0E96E9] dark:text-[#6CC3FF] bg-[#0E96E9]/10 dark:bg-[#6CC3FF]/10 px-2.5 py-1 rounded-full transition-colors expand-hint">
                <span class="grid place-items-center w-4 h-4 rounded-full bg-[#0E96E9] dark:bg-[#6CC3FF] text-white dark:text-[#06121a]">
                  <Icon name="plus" class="w-3 h-3 expand-icon transition-transform" strokeWidth="2.4" />
                </span>
                {isEn ? "Expand" : "展开"}
              </span>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="py-12 text-center text-black/30 dark:text-white/30 italic inline-flex items-center gap-1.5">
        {isEn ? "Nothing collected yet." : "暂无收录，敬请期待"}
        <Icon name="sparkles" class="w-3.5 h-3.5" />
      </p>
    )}

    <p id="sites-empty" class="hidden py-12 text-center text-black/30 dark:text-white/30 italic">
      {isEn ? "No matches — try another keyword." : "没有匹配的收藏，换个关键词试试。"}
    </p>
  </section>
</BaseLayout>

<style is:global>
  .cat-chip.cat-active {
    background: #0E96E9;
    border-color: #0E96E9;
    color: #fff;
  }
  :global(.dark) .cat-chip.cat-active {
    color: #06121a;
    background: #6CC3FF;
    border-color: #6CC3FF;
  }
</style>

<script>
  (function () {
    var list = document.getElementById("sites-list");
    if (!list) return;
    var cards = Array.prototype.slice.call(list.querySelectorAll(".site-card"));
    var search = document.getElementById("sites-search");
    var empty = document.getElementById("sites-empty");
    var catBtns = Array.prototype.slice.call(document.querySelectorAll(".cat-chip"));
    var state = { query: "", cat: "all" };

    // ⌘K / Ctrl+K 聚焦搜索框
    document.addEventListener("keydown", function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (search) { search.focus(); search.select(); }
      }
    });

    function apply() {
      var q = state.query.trim().toLowerCase();
      var shown = 0;
      cards.forEach(function (card) {
        var okCat = state.cat === "all" || card.getAttribute("data-cat") === state.cat;
        var okQ = !q || card.getAttribute("data-search").indexOf(q) !== -1;
        var show = okCat && okQ;
        card.style.display = show ? "" : "none";
        if (show) shown++;
      });
      if (empty) empty.style.display = shown ? "none" : "";
      if (list) list.style.display = shown ? "" : "none";
    }

    if (search) {
      search.addEventListener("input", function () {
        state.query = search.value;
        apply();
      });
    }

    catBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        catBtns.forEach(function (b) { b.classList.remove("cat-active"); });
        btn.classList.add("cat-active");
        state.cat = btn.getAttribute("data-cat");
        apply();
      });
    });

    // 可展开列表：同时只展开一个
    cards.forEach(function (card) {
      card.addEventListener("click", function (e) {
        // 点击"查看完整拆解"链接时不拦截
        if (e.target.closest("a")) return;
        var expand = card.querySelector(".site-expand");
        var isOpen = expand && !expand.classList.contains("hidden");
        // 收起所有
        cards.forEach(function (c) {
          var ex = c.querySelector(".site-expand");
          var icon = c.querySelector(".expand-icon");
          if (ex) ex.classList.add("hidden");
          if (icon) icon.style.transform = "";
          c.classList.remove("expanded");
        });
        if (!isOpen && expand) {
          expand.classList.remove("hidden");
          card.classList.add("expanded");
          var openIcon = card.querySelector(".expand-icon");
          // 展开后 + 旋转 45° 变成 ×，直观表示“收起”
          if (openIcon) openIcon.style.transform = "rotate(45deg)";
        }
      });
    });
  })();
</script>
