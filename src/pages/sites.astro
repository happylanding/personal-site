---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const isEn = lang === "en";

// 已收录的站点报告（按日期倒序）
const siteEntries = (await getCollection("sites", ({ data }) => !data.draft && !!data.siteUrl))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title={isEn ? "Design Inspiration Collection" : "设计灵感收藏夹"}
  description={isEn ? "Great sites & designs I come across, with breakdowns, creative analysis and highlights." : "平时刷到的好网站、好设计都收录在这里，附上拆解、创意分析与亮点特色。"}
>
  <Breadcrumb
    crumbs={[{ label: isEn ? "Collection" : "收藏夹", href: isEn ? "/en/sites/" : "/sites/" }]}
  />

  <section data-reveal>
    <header class="mb-10">
      <h1 class="text-3xl font-serif font-bold mb-2">
        {isEn ? "Design Inspiration Collection" : "设计灵感收藏夹"}
      </h1>
      <p class="text-sm text-black/40 dark:text-white/40">
        {isEn ? "Curated sites & designs with breakdowns" : "收藏好网站 · 附拆解与创意分析"}
      </p>
      <p class="text-base text-black/50 dark:text-white/50 mt-3 leading-relaxed max-w-2xl">
        {isEn
          ? "Great sites & designs I come across are archived here — each entry is a breakdown of structure, creative analysis and highlights."
          : "平时刷到的好网站会持续收录在这里，每篇都是一份「网站拆解 + 创意分析 + 亮点特色」报告。"}
      </p>
    </header>

    {siteEntries.length > 0 ? (
      <div class="space-y-3">
        {siteEntries.map((entry, i) => {
          const title = isEn ? (entry.data.titleEn || entry.data.title) : entry.data.title;
          const desc = isEn ? (entry.data.descriptionEn || entry.data.description) : entry.data.description;
          const dateStr = entry.data.date.toLocaleDateString(isEn ? "en-US" : "zh-CN", {
            year: "numeric", month: "long", day: "numeric",
          });
          const href = isEn ? `/en/sites/${entry.id}/` : `/sites/${entry.id}/`;
          return (
            <a
              href={href}
              class="block p-5 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 hover-lift transition-all duration-300 group"
            >
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-mono text-black/25 dark:text-white/25">
                  {String(i + 1).padStart(2, "0")}
                </span>
                {entry.data.siteUrl && (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/50 dark:text-white/50 inline-flex items-center gap-1">
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    {new URL(entry.data.siteUrl).hostname}
                  </span>
                )}
              </div>
              <h3 class="font-bold font-serif text-base mb-1.5 group-hover:opacity-70 transition-opacity leading-snug">{title}</h3>
              {desc && <p class="text-sm text-black/40 dark:text-white/40 line-clamp-2 leading-relaxed">{desc}</p>}
              <div class="flex items-center justify-between mt-3">
                <time class="text-xs text-black/25 dark:text-white/25 font-mono">{dateStr}</time>
                <span class="text-xs opacity-0 group-hover:opacity-40 transition-opacity">→</span>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="py-12 text-center text-black/30 dark:text-white/30 italic">
        {isEn ? "Nothing collected yet." : "暂无收录，敬请期待 ✨"}
      </p>
    )}
  </section>
</BaseLayout>
