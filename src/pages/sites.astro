---
/* Galvin design reminder: resources are a continuous research directory in the pure #10131d workspace.
   Search and filters clarify discovery; each source expands in flow rather than becoming a floating card. */
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const siteEntries = (await getCollection("sites", ({ data }) => !data.draft && !!data.siteUrl))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function extractSection(content: string, heading: string): string {
  const re = new RegExp(`^##\\s*${heading}\\s*\\n+([\\s\\S]*?)(?=^##\\s|\\Z)`, "m");
  const matched = content.match(re);
  if (!matched) return "";
  const paragraph = matched[1]
    .split(/\n\s*\n/)
    .map((value) => value.trim())
    .find((value) => value.length > 0 && !value.startsWith(">") && !value.startsWith("#"));
  if (!paragraph) return "";
  return paragraph
    .replace(/\*\*([^*]+)\*\*/g, "$1")
    .replace(/\*([^*]+)\*/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/\s+/g, " ")
    .trim();
}

function classify(entry): string {
  const tags = [...(entry.data.tags || []), ...(entry.data.tagsEn || [])].map((value) => value.toLowerCase());
  const has = (...keywords: string[]) => tags.some((tag) => keywords.some((keyword) => tag.includes(keyword)));
  if (has("个人品牌站", "personal-site", "作品集", "portfolio")) return "personal";
  if (has("策展", "日报", "编辑", "curation", "daily", "editorial")) return "curation";
  if (has("教程站", "教程", "course-site", "tutorial", "学习", "开源教育")) return "course";
  if (has("产品", "工具", "知识库", "product", "knowledge-base")) return "product";
  return "other";
}

const categoryNames = {
  personal: "个人品牌",
  curation: "策展与编辑",
  course: "教程与学习",
  product: "产品与知识",
  other: "其他",
};
const categoryOrder = ["personal", "curation", "course", "product", "other"];
const usedCategories = categoryOrder.filter((category) => siteEntries.some((entry) => classify(entry) === category));

const siteData = siteEntries.map((entry) => {
  let body = "";
  try {
    body = readFileSync(join(process.cwd(), "src/content/sites", `${entry.id}.md`), "utf-8");
  } catch {
    body = "";
  }
  return {
    id: entry.id,
    title: entry.data.title,
    desc: entry.data.description || "",
    host: entry.data.siteUrl ? new URL(entry.data.siteUrl).hostname : "",
    date: entry.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).replaceAll("/", "."),
    tags: entry.data.tags || [],
    category: classify(entry),
    tagline: extractSection(body, "一句话定位"),
    highlight: extractSection(body, "亮点特色总结"),
    href: `/sites/${entry.id}/`,
  };
});
---

<BaseLayout title="网站与资源" description="Galvin 收录的个人网站、设计案例与资源拆解。">
  <section class="galvin-directory-page galvin-resource-page" aria-labelledby="resources-title">
    <header class="galvin-directory-intro">
      <p class="galvin-page-kicker"><span aria-hidden="true"></span>藏页 · 研究记录</p>
      <h1 id="resources-title">网站与资源</h1>
      <p>平时刷到的好网站、好设计都收录在这里。每一项保留原始链接、结构拆解与值得继续回看的创意线索。</p>
    </header>

    <div class="galvin-resource-toolbar" aria-label="网站与资源筛选">
      <div class="galvin-resource-toolbar__search">
        <label for="sites-search">检索网站与资源</label>
        <input id="sites-search" type="search" aria-label="检索网站与资源" placeholder="输入网站名、域名或描述" />
      </div>
      <div class="galvin-resource-toolbar__filters" role="group" aria-label="资源分类">
        <button data-cat="all" class="galvin-resource-filter is-active" type="button">全部资源 <small>{siteEntries.length}</small></button>
        {usedCategories.map((category) => (
          <button data-cat={category} class="galvin-resource-filter" type="button">
            {categoryNames[category]} <small>{siteEntries.filter((entry) => classify(entry) === category).length}</small>
          </button>
        ))}
      </div>
    </div>

    {siteData.length > 0 ? (
      <div id="sites-list" class="galvin-resource-rail">
        {siteData.map((item) => (
          <article
            class="galvin-resource-row"
            data-resource-row
            data-id={item.id}
            data-cat={item.category}
            data-search={(item.title + " " + item.host + " " + item.desc + " " + item.tags.join(" ")).toLowerCase()}
          >
            <button class="galvin-resource-row__summary" type="button" data-resource-toggle aria-expanded="false" aria-controls={`resource-${item.id}`}>
              <span class="galvin-resource-row__utility">{item.host || "网站记录"} · {item.date}</span>
              <span class="galvin-resource-row__main">
                <strong>{item.title}</strong>
                {item.desc && <span>{item.desc}</span>}
              </span>
              <span class="galvin-resource-row__action" aria-hidden="true">展开 <i>↓</i></span>
            </button>
            <div id={`resource-${item.id}`} class="galvin-resource-row__detail" hidden>
              {item.tagline && <div><p>一句话定位</p><span>{item.tagline}</span></div>}
              {item.highlight && <div><p>亮点特色</p><span>{item.highlight}</span></div>}
              <a href={item.href}>查看完整拆解 <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="galvin-empty-state">资源记录正在整理中。</p>
    )}

    <p id="sites-empty" class="galvin-empty-state" hidden>没有匹配的资源，换个关键词试试。</p>
  </section>
</BaseLayout>

<script>
  (() => {
    const list = document.getElementById("sites-list");
    if (!list) return;
    const rows = Array.from(list.querySelectorAll<HTMLElement>("[data-resource-row]"));
    const search = document.getElementById("sites-search") as HTMLInputElement | null;
    const empty = document.getElementById("sites-empty");
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>(".galvin-resource-filter"));
    const toggles = Array.from(list.querySelectorAll<HTMLButtonElement>("[data-resource-toggle]"));
    const state = { query: "", category: "all" };

    const closeRow = (row: HTMLElement) => {
      const toggle = row.querySelector<HTMLButtonElement>("[data-resource-toggle]");
      const detail = row.querySelector<HTMLElement>(".galvin-resource-row__detail");
      if (toggle) toggle.setAttribute("aria-expanded", "false");
      if (detail) detail.hidden = true;
    };

    const apply = () => {
      const query = state.query.trim().toLowerCase();
      let shown = 0;
      rows.forEach((row) => {
        const matchesCategory = state.category === "all" || row.dataset.cat === state.category;
        const matchesQuery = !query || (row.dataset.search || "").includes(query);
        const show = matchesCategory && matchesQuery;
        row.hidden = !show;
        if (!show) closeRow(row);
        if (show) shown += 1;
      });
      if (empty) empty.hidden = shown !== 0;
      list.hidden = shown === 0;
    };

    search?.addEventListener("input", () => {
      state.query = search.value;
      apply();
    });

    filters.forEach((filter) => filter.addEventListener("click", () => {
      state.category = filter.dataset.cat || "all";
      filters.forEach((item) => item.classList.toggle("is-active", item === filter));
      apply();
    }));

    toggles.forEach((toggle) => toggle.addEventListener("click", () => {
      const row = toggle.closest<HTMLElement>("[data-resource-row]");
      if (!row) return;
      const detail = row.querySelector<HTMLElement>(".galvin-resource-row__detail");
      const shouldOpen = toggle.getAttribute("aria-expanded") !== "true";
      rows.forEach(closeRow);
      toggle.setAttribute("aria-expanded", String(shouldOpen));
      if (detail) detail.hidden = !shouldOpen;
    }));
  })();
</script>
