---
/* Galvin design reminder: 造物 is a content directory in a pure #10131d workspace.
   Real tools appear before system metadata; violet denotes action and cyan only denotes local/safe status. */
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { filterToolsByType } from "../lib/galvin-content-view";

const tools = (await getCollection("tools", ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return (b.data.updated || b.data.date).getTime() - (a.data.updated || a.data.date).getTime();
  });

const typeMeta = [
  { id: "all", label: "全部" },
  { id: "app", label: "浏览器工具" },
  { id: "script", label: "本地脚本" },
  { id: "online", label: "外部工具" },
] as const;

const toolTypeLabel = {
  app: "浏览器工具",
  script: "本地脚本",
  online: "外部工具",
} as const;

const toolStatusLabel = {
  online: "可访问",
  stable: "稳定版",
  beta: "测试中",
  dev: "开发中",
} as const;

function dateLabel(date: Date): string {
  return new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })
    .format(date)
    .replaceAll("/", ".");
}
---

<BaseLayout title="造物" description="Galvin 的实用工具、工作脚本与持续试验。">
  <section class="galvin-directory-page galvin-making-page" aria-labelledby="making-title">
    <header class="galvin-directory-intro">
      <p class="galvin-page-kicker"><span aria-hidden="true"></span>造物</p>
      <h1 id="making-title">造物</h1>
      <p>从工作里冒出来的小麻烦开始，做一些自己能用、也希望能帮到别人的工具。它们不承诺解决一切，只尽量把一件事做顺。</p>
    </header>

    <div class="galvin-directory-toolbar" aria-label="造物目录工具带">
      <div class="galvin-directory-toolbar__filters">
        <div class="galvin-directory-toolbar__head">
          <p>筛选工具</p>
          <span><span id="tool-visible-count">{tools.length}</span> 项可用</span>
        </div>
        <div class="galvin-filter-rail__track" role="tablist" aria-label="工具类型">
        {typeMeta.map((type, index) => (
          <button
            class:list={["galvin-filter-chip", index === 0 && "is-active"]}
            type="button"
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            data-tool-filter={type.id}
          >
            {type.label}<small>{filterToolsByType(tools, type.id).length}</small>
          </button>
        ))}
        </div>
      </div>
      <aside class="galvin-directory-note" aria-label="工具隐私边界">
        <span aria-hidden="true"></span>
        <p>浏览器工具在本地运行；本地脚本在 Windows 电脑上执行。除特别标注的外部链接外，本站不接收你的文本或工作文件。</p>
      </aside>
    </div>

    <div class="galvin-tool-rail" id="making-list">
      {tools.map((tool, index) => {
        const updated = tool.data.updated || tool.data.date;
        const privacy = tool.data.type === "app"
          ? "浏览器本地计算 · 不上传输入内容"
          : tool.data.type === "script"
            ? "Windows 本机运行 · 文件不上传"
            : "外部链接 · 请以对方说明为准";
        const primaryHref = tool.data.downloadUrl || tool.data.url || `/tools/${tool.id}/`;
        const primaryLabel = tool.data.downloadUrl ? "下载工具" : tool.data.url ? "打开工具" : "进入试用";
        return (
          <article class="galvin-tool-row" data-tool-card data-tool-type={tool.data.type}>
            <div class="galvin-tool-row__utility">
              <span>{toolTypeLabel[tool.data.type]} · {dateLabel(updated)}</span>
              <span class="galvin-tool-row__status"><i></i>{toolStatusLabel[tool.data.status]}</span>
            </div>
            <div class="galvin-tool-row__main">
              <h2>{tool.data.title}</h2>
              {tool.data.description && <p>{tool.data.description}</p>}
              <span>{privacy}</span>
            </div>
            <div class="galvin-tool-row__actions">
              <a
                class="galvin-action-link galvin-action-link--primary"
                href={primaryHref}
                download={tool.data.downloadUrl ? true : undefined}
                target={tool.data.url ? "_blank" : undefined}
                rel={tool.data.url ? "noopener" : undefined}
              >
                {primaryLabel}<span aria-hidden="true">{tool.data.downloadUrl ? "↓" : "↗"}</span>
              </a>
              <a class="galvin-action-link" href={`/tools/${tool.id}/`}>工具说明 <span aria-hidden="true">→</span></a>
            </div>
          </article>
        );
      })}
    </div>

    {tools.length === 0 && <p class="galvin-empty-state">工具工作台正在整理中。</p>}
  </section>

  <script>
    (() => {
      const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tool-filter]"));
      const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-tool-card]"));
      const count = document.getElementById("tool-visible-count");

      const applyFilter = (type: string) => {
        let visible = 0;
        cards.forEach((card) => {
          const matches = type === "all" || card.dataset.toolType === type;
          card.hidden = !matches;
          if (matches) visible += 1;
        });
        filters.forEach((button) => {
          const active = button.dataset.toolFilter === type;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-selected", String(active));
        });
        if (count) count.textContent = String(visible);
      };

      filters.forEach((button) => button.addEventListener("click", () => applyFilter(button.dataset.toolFilter || "all")));
    })();
  </script>
</BaseLayout>
