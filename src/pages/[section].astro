---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ColumnIcon from "../components/ColumnIcon.astro";
import Icon from "../components/Icon.astro";
import { ALL_SECTIONS, SECTION_COLORS } from "../lib/sections";

const sectionMeta: Record<string, { name: string; enName: string; desc: string }> = {
  insights: { name: "行业洞察", enName: "Industry Insights", desc: "数字经济与产业观察，记录我在这个行业里的一点见闻和思考" },
  ai: { name: "AI 学习", enName: "AI Learning", desc: "AI 工具实测、学习路径与实战笔记，从入门到上手，一起慢慢摸索" },
  tips: { name: "实用技巧", enName: "Practical Tips", desc: "效率工具、办公技巧与折腾心得，让技术为你所用" },
  books: { name: "阅读思考", enName: "Reading & Thinking", desc: "书评与阅读笔记，经典好书支持在线阅读与下载" },
};

export async function getStaticPaths() {
  return ALL_SECTIONS.map((section) => ({ params: { section } }));
}

const { section } = Astro.params;

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const sectionArticles = allArticles
  .filter((a) => a.data.section === section)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const isBooksSection = section === "books";
---

<BaseLayout title={sectionMeta[section].name} description={sectionMeta[section].desc}>
  <Breadcrumb
    crumbs={[
      { label: sectionMeta[section].name, href: `/${section}/` },
    ]}
  />

  <section data-reveal>
    <div class="mb-10">
      <div class="w-12 h-1 rounded-full mb-4" style={{ backgroundColor: SECTION_COLORS[section] }}></div>
      <h1 class="text-3xl font-serif font-bold mb-2 flex items-center gap-3 lmask">
        <span class="block opacity-70 flex-shrink-0"><ColumnIcon section={section as import("../lib/sections").SectionKey} class="w-9 h-9" /></span>
        <span class="lmask-inner" style="--lmask-delay:0.1s"><span>{sectionMeta[section].name}</span></span>
      </h1>
      <p class="text-sm text-black/40 dark:text-white/40">{sectionMeta[section].enName}</p>
      <p class="text-base text-black/50 dark:text-white/50 mt-3 leading-relaxed max-w-2xl">
        {sectionMeta[section].desc}
      </p>
    </div>

    {sectionArticles.length > 0 ? (
      isBooksSection ? (
        /* ===== Book cards with download buttons ===== */
        <div class="grid grid-cols-1 gap-6">
          {sectionArticles.map((article) => {
            const title = article.data.title;
            const desc = article.data.description;
            const author = article.data.author;
            const displayTags = article.data.tags;
            const dateStr = article.data.date.toLocaleDateString("zh-CN", {
              year: "numeric", month: "long", day: "numeric",
            });
            const hasEpub = !!article.data.epubUrl;
            const hasPdf = !!article.data.pdfUrl;
            const hasMobi = !!article.data.mobiUrl;
            const hasAzw3 = !!article.data.azw3Url;
            const hasFb2 = !!article.data.fb2Url;
            const hasTxt = !!article.data.txtUrl;
            const hasBuy = !!article.data.buyUrl;
            const hasRead = !!article.data.readUrl;
            const hasReview = !!article.data.reviewUrl;
            return (
              <div class="flex flex-col sm:flex-row gap-5 p-5 rounded-xl border border-black/10 dark:border-white/10 hover-lift group relative overflow-hidden" data-spotlight data-tilt>
                {/* Cover placeholder */}
                <div class="flex-shrink-0 w-20 h-28 bg-black/[0.04] dark:bg-white/[0.04] rounded flex items-center justify-center text-black/15 dark:text-white/15">
                  <Icon name="bookOpen" class="w-8 h-8" strokeWidth={1.2} />
                </div>
                {/* Content */}
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-bold font-serif group-hover:text-black dark:group-hover:text-white transition-colors mb-1">
                    <a href={`/${section}/${article.id}`} class="hover-scale-text inline-block">
                      {title}
                    </a>
                    {article.data.featured && <Icon name="star" class="w-3.5 h-3.5 inline-block ml-1 align-middle text-amber-500" />}
                  </h3>
                  {author && <p class="text-sm text-black/50 dark:text-white/50 mb-2">作者: {author}</p>}
                  {desc && <p class="text-sm text-black/40 dark:text-white/40 line-clamp-2 mb-3">{desc}</p>}
                  {article.data.rating && (
                    <div class="text-xs text-black/30 dark:text-white/30 mb-3 inline-flex items-center gap-0.5">
                      <span class="mr-1">评分:</span>
                      {Array.from({ length: article.data.rating }).map(() => (
                        <Icon name="star" class="w-3.5 h-3.5 text-amber-500" />
                      ))}
                      {Array.from({ length: 5 - article.data.rating }).map(() => (
                        <Icon name="starOutline" class="w-3.5 h-3.5 opacity-40" />
                      ))}
                    </div>
                  )}
                  {/* Download/action buttons */}
                  <div class="flex flex-wrap gap-2 mt-1">
                    {hasRead && (
                      <a href={`/books/${article.id}/read/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <Icon name="bookOpen" class="w-3.5 h-3.5" />
                        在线阅读
                      </a>
                    )}
                    {hasReview && (
                      <a href={article.data.reviewUrl} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <Icon name="fileText" class="w-3.5 h-3.5" />
                        书评
                      </a>
                    )}
                    {hasEpub && (
                      <a href={article.data.epubUrl} download class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <Icon name="download" class="w-3.5 h-3.5" />
                        EPUB
                      </a>
                    )}
                    {hasMobi && (
                      <a href={article.data.mobiUrl} download class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <Icon name="download" class="w-3.5 h-3.5" />
                        MOBI
                      </a>
                    )}
                    {hasAzw3 && (
                      <a href={article.data.azw3Url} download class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <Icon name="download" class="w-3.5 h-3.5" />
                        AZW3
                      </a>
                    )}
                    {hasFb2 && (
                      <a href={article.data.fb2Url} download class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <Icon name="download" class="w-3.5 h-3.5" />
                        FB2
                      </a>
                    )}
                    {hasTxt && (
                      <a href={article.data.txtUrl} download class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <Icon name="download" class="w-3.5 h-3.5" />
                        TXT
                      </a>
                    )}
                    {hasPdf && (
                      <a href={article.data.pdfUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <Icon name="fileText" class="w-3.5 h-3.5" />
                        PDF
                      </a>
                    )}
                    {hasBuy && (
                      <a href={article.data.buyUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black dark:bg-white text-white dark:text-black text-xs font-medium hover:opacity-80 transition-opacity">
                        <Icon name="cart" class="w-3.5 h-3.5" />
                        购买此书
                      </a>
                    )}
                  </div>
                  <div class="flex gap-2 mt-3">
                    {displayTags.slice(0, 3).map((tag: string) => (
                      <span class="text-[13px] text-black/50 dark:text-white/65">#{tag}</span>
                    ))}
                  </div>
                </div>
                <time class="text-[13px] text-black/45 dark:text-white/60 font-mono flex-shrink-0">{dateStr}</time>
              </div>
            );
          })}
        </div>
      ) : (
        /* ===== Regular article list ===== */
        <div class="space-y-1">
          {sectionArticles.map((article) => {
            const title = article.data.title;
            const desc = article.data.description;
            const displayTags = article.data.tags;
            const dateStr = article.data.date.toLocaleDateString("zh-CN", {
              year: "numeric", month: "long", day: "numeric",
            });
            return (
              <a
                href={`/${section}/${article.id}`}
                class="flex items-start justify-between py-4 px-4 rounded-lg hover:bg-black/[0.03] dark:hover:bg-white/[0.03] transition-colors group overflow-hidden"
              >
                <div class="min-w-0">
                  <h3 class="text-base font-bold font-serif group-hover:text-black dark:group-hover:text-white transition-colors mb-1 hover-scale-text">
                    {title}
                    {article.data.featured && <Icon name="star" class="w-3 h-3 inline-block ml-1 align-middle text-amber-500" />}
                  </h3>
                  {desc && (
                    <p class="text-sm text-black/40 dark:text-white/40 line-clamp-1">{desc}</p>
                  )}
                  <div class="flex gap-2 mt-2">
                    {displayTags.slice(0, 3).map((tag: string) => (
                      <span class="text-[13px] text-black/50 dark:text-white/65">#{tag}</span>
                    ))}
                  </div>
                </div>
                <time class="text-[13px] text-black/45 dark:text-white/60 font-mono flex-shrink-0 ml-4 mt-1">
                  {dateStr}
                </time>
              </a>
            );
          })}
        </div>
      )
    ) : (
      <p class="py-12 text-center text-black/30 dark:text-white/30 italic">暂无文章</p>
    )}
  </section>
</BaseLayout>
