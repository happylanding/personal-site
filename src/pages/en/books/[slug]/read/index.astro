---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../../../components/Breadcrumb.astro";
import ColumnIcon from "../../../../../components/ColumnIcon.astro";
import Icon from "../../../../../components/Icon.astro";
import ArticleTOC from "../../../../../components/ArticleTOC.astro";
import { getLangFromUrl, useTranslations } from "../../../../../i18n/utils";

export async function getStaticPaths() {
  const books = await getCollection("articles", ({ data }) => !data.draft && data.section === "books");
  return books.map((b) => ({ params: { slug: b.id } }));
}

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allBooks = await getCollection("articles", ({ data }) => !data.draft && data.section === "books");
const book = allBooks.find((b) => b.id === slug);
if (!book) return Astro.redirect("/404");

const { default: chapters } = await import(`../../../../../data/books/${slug}.json`);

const displayTitle = lang === "en" ? (book.data.titleEn || book.data.title) : book.data.title;
const displayDesc = lang === "en" ? (book.data.descriptionEn || book.data.description) : book.data.description;
const displayAuthor = lang === "en" ? (book.data.authorEn || book.data.author) : book.data.author;
const base = "/en/books";
// PDF 原书：用原图展示 + 翻页（不做文本解析）；其他格式用章节文本
const isPdf = chapters && chapters.type === "pdf";
---

<BaseLayout title={`${displayTitle} · ${t("articles.preview")}`} description={displayDesc}>
  <Breadcrumb
    crumbs={[
      { label: t(`columns.books.name`), href: `${base}/` },
      { label: displayTitle, href: `${base}/${slug}/` },
      { label: t("articles.preview"), href: "#" },
    ]}
  />

  <div class="mb-8" data-reveal>
    <div class="flex items-center gap-3 mb-3">
      <span class="text-[13px] px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75 inline-flex items-center gap-1">
        <ColumnIcon section="books" class="w-3 h-3" /> {t(`columns.books.name`)}
      </span>
    </div>
    <h1 class="text-3xl md:text-4xl font-serif font-bold leading-tight mb-3">
      {displayTitle}
    </h1>
    {displayAuthor && (
      <p class="text-base text-black/50 dark:text-white/50 mb-2">
        {t("articles.author")}: {displayAuthor}
      </p>
    )}
    {displayDesc && (
      <p class="text-sm text-black/40 dark:text-white/40 leading-relaxed max-w-3xl mb-4">{displayDesc}</p>
    )}
    <a href={`${base}/${slug}/`} class="inline-flex items-center gap-1.5 text-sm text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors">
      <Icon name="arrowLeft" class="w-3.5 h-3.5" /> Back to book page
    </a>
  </div>

  {isPdf ? (
    /* ===== PDF 原图：翻页阅读 ===== */
    <div class="article-grid lg:grid lg:grid-cols-[minmax(0,1fr)_220px] xl:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 xl:gap-14" data-reveal>
      <div class="min-w-0 order-1">
        <div class="pdf-reader max-w-3xl mx-auto" data-pdf-reader>
          <div class="pdf-page-wrap bg-black/[0.03] dark:bg-white/[0.04] rounded-lg overflow-hidden shadow-sm">
            <img
              id="pdf-page-img"
              class="pdf-page-img w-full h-auto block"
              src={chapters.dir + chapters.files[0]}
              alt={`${displayTitle} · Page 1`}
              loading="eager"
            />
          </div>
          <div class="flex items-center justify-center gap-3 mt-5">
            <button type="button" class="pdf-prev inline-flex items-center gap-1 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-sm hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors disabled:opacity-30" data-pdf-prev disabled>
              <Icon name="arrowLeft" class="w-4 h-4" /> Prev
            </button>
            <span class="text-sm text-black/50 dark:text-white/50 font-mono" data-pdf-page-indicator>
              1 / {chapters.pages}
            </span>
            <button type="button" class="pdf-next inline-flex items-center gap-1 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-sm hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors disabled:opacity-30" data-pdf-next {chapters.pages <= 1 ? "disabled" : ""}>
              Next <Icon name="arrowRight" class="w-4 h-4" />
            </button>
          </div>
          <div class="flex items-center justify-center gap-2 mt-4">
            {chapters.files.map((f, i) => (
              <button
                type="button"
                class="pdf-jump w-6 h-6 text-[11px] rounded-full border border-black/10 dark:border-white/10 hover:bg-black/[0.06] dark:hover:bg-white/[0.06] transition-colors {i === 0 ? 'bg-black/5 dark:bg-white/5 font-semibold' : ''}"
                data-pdf-jump={String(i + 1)}
                title={`Page ${i + 1}`}
              >
                {i + 1}
              </button>
            ))}
          </div>
        </div>
      </div>
      <div class="min-w-0 order-2"></div>
    </div>
  ) : (
    /* ===== 章节文本阅读 ===== */
    <div id="article-grid" class="article-grid lg:grid lg:grid-cols-[minmax(0,1fr)_220px] xl:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 xl:gap-14" data-reveal>
      <div class="min-w-0 order-1">
        <div class="book-reader lang-en article-content max-w-none">
          {chapters.map((c) => (
            <section id={`ch-${c.num}`} class="book-chapter mb-12">
              <h2 id={`ch-title-${c.num}`} class="book-chapter-title">
                {c.title ? c.title : `Chapter ${c.num}`}
              </h2>
              <div class="book-chapter-body">
                {(c.textZh || c.text || "").split(/\n\s*\n/).map((p) => p.replace(/\s+/g, " ").trim()).filter(Boolean).map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
      <div class="min-w-0 order-2">
        <ArticleTOC label={t("articles.toc")} countFormat={t("articles.tocCount")} />
      </div>
    </div>
  )}

  {/* PDF 翻页逻辑 */}
  {isPdf && (
    <script define:vars={{ total: chapters.pages, pages: chapters.files, dir: chapters.dir, title: displayTitle }}>
      const img = document.getElementById("pdf-page-img");
      const prevBtn = document.querySelector("[data-pdf-prev]");
      const nextBtn = document.querySelector("[data-pdf-next]");
      const indicator = document.querySelector("[data-pdf-page-indicator]");
      const jumpBtns = Array.from(document.querySelectorAll("[data-pdf-jump]"));
      let current = 1;

      const render = () => {
        img.src = dir + pages[current - 1];
        img.alt = title;
        indicator.textContent = current + " / " + total;
        prevBtn.disabled = current <= 1;
        nextBtn.disabled = current >= total;
        jumpBtns.forEach((btn, i) => {
          const active = i + 1 === current;
          btn.classList.toggle("bg-black/5", active);
          btn.classList.toggle("dark:bg-white/5", active);
          btn.classList.toggle("font-semibold", active);
          btn.classList.toggle("opacity-70", !active);
        });
      };

      prevBtn.addEventListener("click", () => { if (current > 1) { current--; render(); } });
      nextBtn.addEventListener("click", () => { if (current < total) { current++; render(); } });
      jumpBtns.forEach((btn) => {
        btn.addEventListener("click", () => { current = Number(btn.dataset.pdfJump); render(); });
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") { if (current > 1) { current--; render(); } }
        if (e.key === "ArrowRight") { if (current < total) { current++; render(); } }
      });
      render();
    </script>
  )}
</BaseLayout>
