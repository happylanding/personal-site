---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../../../components/Breadcrumb.astro";
import ColumnIcon from "../../../../../components/ColumnIcon.astro";
import Icon from "../../../../../components/Icon.astro";
import ArticleTOC from "../../../../../components/ArticleTOC.astro";
import { getLangFromUrl, useTranslations } from "../../../../../i18n/utils";

export async function getStaticPaths() {
  const books = await getCollection("articles", ({ data }) => !data.draft && data.section === "books");
  return books.map((b) => ({ params: { slug: b.id } }));
}

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allBooks = await getCollection("articles", ({ data }) => !data.draft && data.section === "books");
const book = allBooks.find((b) => b.id === slug);
if (!book) return Astro.redirect("/404");

const { default: chapters } = await import(`../../../../../data/books/${slug}.json`);

const displayTitle = lang === "en" ? (book.data.titleEn || book.data.title) : book.data.title;
const displayDesc = lang === "en" ? (book.data.descriptionEn || book.data.description) : book.data.description;
const displayAuthor = lang === "en" ? (book.data.authorEn || book.data.author) : book.data.author;
const base = "/en/books";
// PDF 原书：用原图展示 + 翻页（不做文本解析）；其他格式用章节文本
const isPdf = chapters && chapters.type === "pdf";

// —— 章节切换阅读：任意章节数的章节文本书统一用“选章节 → 只看该章”模式 ——
const LARGE_BOOK_THRESHOLD = 30;
const isLargeBook = Array.isArray(chapters) && chapters.length >= LARGE_BOOK_THRESHOLD;
const INITIAL_CHAPTERS = 3;
const initialChapters = isLargeBook ? chapters.slice(0, INITIAL_CHAPTERS) : chapters;
const chapterTitle = (c) => (c.titleZh ? c.titleZh : `Chapter ${c.num}`);
const chapterBody = (c) => (c.textZh || c.text || "").split(/\n\s*\n/).map((p) => p.replace(/\s+/g, " ").trim()).filter(Boolean);
// 章节元数据：供章节切换器下拉/导航使用（index 为 0-based 章节位置）
const chaptersMeta = Array.isArray(chapters)
  ? chapters.map((c, i) => ({ index: i, num: c.num, title: chapterTitle(c), inline: !isLargeBook || i < INITIAL_CHAPTERS }))
  : [];
const totalChapters = chaptersMeta.length;
---

<BaseLayout title={`${displayTitle} · ${t("articles.preview")}`} description={displayDesc}>
  <Breadcrumb
    crumbs={[
      { label: t(`columns.books.name`), href: `${base}/` },
      { label: displayTitle, href: `${base}/${slug}/` },
      { label: t("articles.preview"), href: "#" },
    ]}
  />

  <div class="mb-8" data-reveal>
    <div class="flex items-center gap-3 mb-3">
      <span class="text-[13px] px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75 inline-flex items-center gap-1">
        <ColumnIcon section="books" class="w-3 h-3" /> {t(`columns.books.name`)}
      </span>
    </div>
    <h1 class="text-3xl md:text-4xl font-serif font-bold leading-tight mb-3">
      {displayTitle}
    </h1>
    {displayAuthor && (
      <p class="text-base text-black/50 dark:text-white/50 mb-2">
        {t("articles.author")}: {displayAuthor}
      </p>
    )}
    {displayDesc && (
      <p class="text-sm text-black/40 dark:text-white/40 leading-relaxed max-w-3xl mb-4">{displayDesc}</p>
    )}
    <a href={`${base}/${slug}/`} class="inline-flex items-center gap-1.5 text-sm text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors">
      <Icon name="arrowLeft" class="w-3.5 h-3.5" /> Back to book page
    </a>
  </div>

  {isPdf ? (
    /* ===== PDF 原图：翻页阅读 ===== */
    <div class="article-grid lg:grid lg:grid-cols-[minmax(0,1fr)_220px] xl:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 xl:gap-14" data-reveal>
      <div class="min-w-0 order-1">
        <div class="pdf-reader max-w-3xl mx-auto" data-pdf-reader>
          <div
            class="pdf-viewport bg-black/[0.03] dark:bg-white/[0.04] rounded-lg overflow-hidden shadow-sm relative select-none"
            data-pdf-viewport
          >
            <div class="pdf-stage" data-pdf-stage>
              <img
                id="pdf-page-img"
                class="pdf-page-img w-full h-auto block"
                src={chapters.dir + chapters.files[0]}
                alt={`${displayTitle} · Page 1`}
                loading="eager"
                draggable="false"
              />
            </div>
            <div class="absolute bottom-2 right-2 text-[11px] px-2 py-0.5 rounded-full bg-black/50 text-white/90 dark:bg-white/15 pointer-events-none opacity-0 transition-opacity" data-pdf-zoom-badge>
              100%
            </div>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-2 mt-4">
            <button type="button" class="pdf-zoom-btn inline-flex items-center justify-center w-8 h-8 rounded-full border border-black/15 dark:border-white/15 text-base hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors disabled:opacity-30" data-pdf-zoom-out title="Zoom out" disabled>
              −
            </button>
            <button type="button" class="pdf-zoom-btn inline-flex items-center justify-center px-3 h-8 rounded-full border border-black/15 dark:border-white/15 text-sm hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors disabled:opacity-30" data-pdf-zoom-reset title="Fit page">
              Fit
            </button>
            <button type="button" class="pdf-zoom-btn inline-flex items-center justify-center w-8 h-8 rounded-full border border-black/15 dark:border-white/15 text-base hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors" data-pdf-zoom-in title="Zoom in">
              +
            </button>
            <span class="mx-1 h-5 w-px bg-black/10 dark:bg-white/10"></span>
            <button type="button" class="pdf-prev inline-flex items-center gap-1 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-sm hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors disabled:opacity-30" data-pdf-prev disabled>
              <Icon name="arrowLeft" class="w-4 h-4" /> Prev
            </button>
            <span class="text-sm text-black/50 dark:text-white/50 font-mono" data-pdf-page-indicator>
              1 / {chapters.pages}
            </span>
            <button type="button" class="pdf-next inline-flex items-center gap-1 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-sm hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors disabled:opacity-30" data-pdf-next {chapters.pages <= 1 ? "disabled" : ""}>
              Next <Icon name="arrowRight" class="w-4 h-4" />
            </button>
          </div>
          <div class="flex items-center justify-center gap-2 mt-4">
            {chapters.files.map((f, i) => (
              <button
                type="button"
                class="pdf-jump w-6 h-6 text-[11px] rounded-full border border-black/10 dark:border-white/10 hover:bg-black/[0.06] dark:hover:bg-white/[0.06] transition-colors {i === 0 ? 'bg-black/5 dark:bg-white/5 font-semibold' : ''}"
                data-pdf-jump={String(i + 1)}
                title={`Page ${i + 1}`}
              >
                {i + 1}
              </button>
            ))}
          </div>
        </div>
      </div>
      <div class="min-w-0 order-2"></div>
    </div>
  ) : (
    /* ===== Chapter-switch reading: select a chapter → only that chapter shows ===== */
    <div id="article-grid" class="article-grid lg:grid lg:grid-cols-[minmax(0,1fr)_220px] xl:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 xl:gap-14" data-reveal>
      <div class="min-w-0 order-1">
        {/* Chapter switcher: dropdown + prev/next */}
        <div class="chapter-switcher mb-8 p-3 rounded-xl border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.03] flex flex-wrap items-center gap-3" data-chapter-switcher>
          <span class="text-[13px] font-medium text-black/55 dark:text-white/65 inline-flex items-center gap-1.5">
            <Icon name="list" class="w-3.5 h-3.5" />
            Chapter
          </span>
          <div class="flex items-center gap-2 flex-1 min-w-0">
            <button type="button" class="ch-prev inline-flex items-center gap-1 px-2.5 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-sm hover:bg-black/[0.05] dark:hover:bg-white/[0.05] transition-colors disabled:opacity-30 disabled:pointer-events-none" data-ch-prev disabled>
              <Icon name="arrowLeft" class="w-4 h-4" />
            </button>
            <select data-ch-select class="ch-select flex-1 min-w-0 max-w-full px-3 py-1.5 rounded-lg border border-black/15 dark:border-white/15 bg-transparent text-sm text-black/80 dark:text-white/80 focus:outline-none focus:border-black/40 dark:focus:border-white/40">
              {chaptersMeta.map((m) => (
                <option value={m.index} class="text-black dark:text-white bg-white dark:bg-neutral-900">
                  {m.title}
                </option>
              ))}
            </select>
            <button type="button" class="ch-next inline-flex items-center gap-1 px-2.5 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-sm hover:bg-black/[0.05] dark:hover:bg-white/[0.05] transition-colors disabled:opacity-30 disabled:pointer-events-none" data-ch-next>
              <Icon name="arrowRight" class="w-4 h-4" />
            </button>
          </div>
          <span class="text-[12px] text-black/40 dark:text-white/45 font-mono" data-ch-count>
            1 / {totalChapters}
          </span>
        </div>

        <div class="book-reader lang-en article-content">
          {chapters.map((c, i) => {
            const inline = !isLargeBook || i < INITIAL_CHAPTERS;
            return (
              <section
                id={`ch-${c.num}`}
                class="book-chapter book-chapter-switch mb-12"
                data-ch-index={String(i)}
                data-ch-num={c.num}
                data-ch-title={chapterTitle(c)}
                data-inline={inline ? "true" : "false"}
                data-loaded={inline ? "true" : "false"}
                hidden={i !== 0}
              >
                <h2 id={`ch-title-${c.num}`} class="book-chapter-title">
                  {chapterTitle(c)}
                </h2>
                {inline ? (
                  <div class="book-chapter-body">
                    {chapterBody(c).map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                ) : (
                  <div class="book-chapter-loading">
                    <span class="inline-flex items-center gap-2 text-sm text-black/40 dark:text-white/40">
                      <svg class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                      </svg>
                      Loading chapter…
                    </span>
                  </div>
                )}
              </section>
            );
          })}
        </div>
      </div>
      <div class="min-w-0 order-2">
        <ArticleTOC label={t("articles.toc")} countFormat={t("articles.tocCount")} />
      </div>
    </div>
  )}

  {/* Chapter-switch logic: select chapter → show only it (lazy fetch for large books) */}
  {!isPdf && (
    <script define:vars={{ slug, totalChapters }}>
      (function () {
        var chapterUrl = function (i) { return "/books/" + slug + "/chapters/ch-" + i + ".json"; };

        function renderParagraphs(text) {
          return text
            .split(/\n\s*\n/)
            .map(function (p) { return p.replace(/\s+/g, " ").trim(); })
            .filter(Boolean)
            .map(function (p) {
              var el = document.createElement("p");
              el.textContent = p;
              return el;
            });
        }

        // Grab current DOM state (DOM is replaced on View Transition, so query live)
        function getState() {
          var root = document.querySelector(".book-reader");
          var switcher = document.querySelector("[data-chapter-switcher]");
          if (!root || !switcher) return null;
          var sections = Array.from(root.querySelectorAll("[data-ch-index]"));
          if (sections.length === 0) return null;
          return {
            root: root,
            select: switcher.querySelector("[data-ch-select]"),
            prevBtn: switcher.querySelector("[data-ch-prev]"),
            nextBtn: switcher.querySelector("[data-ch-next]"),
            countEl: switcher.querySelector("[data-ch-count]"),
            sections: sections
          };
        }

        function loadChapter(section) {
          if (section.dataset.loaded === "true" || section.dataset.loading === "true") return;
          var idx = section.dataset.chIndex;
          if (!idx) return;

          section.dataset.loading = "true";
          var loadingEl = section.querySelector(".book-chapter-loading");

          fetch(chapterUrl(idx))
            .then(function (r) {
              if (!r.ok) throw new Error("HTTP " + r.status);
              return r.json();
            })
            .then(function (chunk) {
              var bodyEl = document.createElement("div");
              bodyEl.className = "book-chapter-body";
              var text = chunk.textZh || chunk.text || "";
              renderParagraphs(text).forEach(function (p) { bodyEl.appendChild(p); });
              if (loadingEl) loadingEl.replaceWith(bodyEl);
              section.dataset.loaded = "true";
              section.dataset.loading = "false";
            })
            .catch(function (e) {
              console.error("[chapter-switch] Failed to load chapter:", e);
              section.dataset.loading = "false";
              if (loadingEl) {
                loadingEl.textContent = "Failed to load. Click to retry.";
                loadingEl.style.cursor = "pointer";
                loadingEl.addEventListener("click", function () { loadChapter(section); }, { once: true });
              }
            });
        }

        function showChapter(index) {
          var st = getState();
          if (!st) return;
          if (index < 0 || index >= st.sections.length) return;
          st.sections.forEach(function (sec, i) {
            sec.hidden = i !== index;
            if (i === index && sec.dataset.loaded !== "true" && sec.dataset.inline !== "true") {
              loadChapter(sec);
            }
          });
          if (st.select) st.select.value = String(index);
          if (st.prevBtn) st.prevBtn.disabled = index <= 0;
          if (st.nextBtn) st.nextBtn.disabled = index >= st.sections.length - 1;
          if (st.countEl) st.countEl.textContent = index + 1 + " / " + totalChapters;
          var top = st.root.getBoundingClientRect().top + window.scrollY - 80;
          window.scrollTo({ top: Math.max(top, 0), behavior: "smooth" });
        }

        function init() {
          var st = getState();
          if (!st || !st.select) return;

          st.select.onchange = function () { showChapter(Number(st.select.value)); };
          st.prevBtn.onclick = function () { showChapter(Number(st.select.value) - 1); };
          st.nextBtn.onclick = function () { showChapter(Number(st.select.value) + 1); };

          var anyVisible = Array.prototype.some.call(st.sections, function (s) { return !s.hidden; });
          if (!anyVisible) showChapter(0);
        }

        // —— Bind document-level events once (won't accumulate duplicates across View Transitions) ——
        document.addEventListener("keydown", function (e) {
          var st = getState();
          if (!st || !st.select) return;
          if (/^(input|textarea|select)$/i.test((e.target.tagName) || "")) return;
          var cur = Number(st.select.value);
          if (e.key === "ArrowLeft") { e.preventDefault(); showChapter(cur - 1); }
          if (e.key === "ArrowRight") { e.preventDefault(); showChapter(cur + 1); }
        });

        // Clicking a TOC link (rail) switches to that chapter
        document.addEventListener("click", function (e) {
          var el = e.target;
          if (!el || !el.classList || !el.classList.contains("article-toc-link")) return;
          var st = getState();
          if (!st) return;
          var id = el.dataset.tocId;
          if (!id) return;
          var idx = -1;
          for (var i = 0; i < st.sections.length; i++) {
            var titleEl = st.sections[i].querySelector(".book-chapter-title");
            if (titleEl && (titleEl.id === id || (titleEl.textContent || "").trim() === (el.textContent || "").trim())) {
              idx = i;
              break;
            }
          }
          if (idx >= 0) showChapter(idx);
        });

        init();
        // Astro View Transition 后重新初始化（旧 DOM 被替换时，事件重新绑定）
        document.addEventListener("astro:page-load", function () {
          init();
        });
      })();
    </script>
  )}

  {/* PDF 翻页 + 缩放阅读逻辑 */}
  {isPdf && (
    <script define:vars={{ total: chapters.pages, pages: chapters.files, dir: chapters.dir, title: displayTitle }}>
      const img = document.getElementById("pdf-page-img");
      const prevBtn = document.querySelector("[data-pdf-prev]");
      const nextBtn = document.querySelector("[data-pdf-next]");
      const indicator = document.querySelector("[data-pdf-page-indicator]");
      const jumpBtns = Array.from(document.querySelectorAll("[data-pdf-jump]"));
      const viewport = document.querySelector("[data-pdf-viewport]");
      const stage = document.querySelector("[data-pdf-stage]");
      const zoomIn = document.querySelector("[data-pdf-zoom-in]");
      const zoomOut = document.querySelector("[data-pdf-zoom-out]");
      const zoomReset = document.querySelector("[data-pdf-zoom-reset]");
      const zoomBadge = document.querySelector("[data-pdf-zoom-badge]");
      let current = 1;

      // —— 缩放阅读状态 ——
      const MIN_SCALE = 1;
      const MAX_SCALE = 6;
      const ZOOM_STEP = 0.5;
      let scale = 1;
      let tx = 0; // pan x (px)
      let ty = 0; // pan y (px)
      let dragging = false;
      let startX = 0, startY = 0, startTx = 0, startTy = 0;
      let lastDragX = 0;
      let lastTapTime = 0;
      let pinchDist = 0, pinchScale = 1, pinchStartScale = 1;

      // 图片纵横比（高/宽），图片加载后动态更新
      let imgRatio = 1287 / 910;
      img.addEventListener("load", () => {
        if (img.naturalWidth) imgRatio = img.naturalHeight / img.naturalWidth;
      });

      const resetView = () => {
        scale = 1;
        tx = 0; ty = 0;
        applyTransform();
      };

      const applyTransform = () => {
        if (!stage) return;
        stage.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
        stage.style.transformOrigin = "top left";
        stage.style.touchAction = scale > 1 ? "none" : "pan-y";
        if (zoomOut) zoomOut.disabled = scale <= MIN_SCALE;
        if (zoomBadge) {
          zoomBadge.textContent = Math.round(scale * 100) + "%";
          zoomBadge.classList.toggle("opacity-0", scale <= MIN_SCALE);
          zoomBadge.classList.toggle("opacity-100", scale > MIN_SCALE);
        }
      };

      const zoomAt = (factor, cx, cy) => {
        const vp = viewport.getBoundingClientRect();
        const newScale = Math.max(MIN_SCALE, Math.min(MAX_SCALE, scale * factor));
        const k = newScale / scale;
        const pcx = cx !== undefined ? cx - vp.left : vp.width / 2;
        const pcy = cy !== undefined ? cy - vp.top : vp.height / 2;
        tx = pcx - k * (pcx - tx);
        ty = pcy - k * (pcy - ty);
        scale = newScale;
        clampPan();
        applyTransform();
      };

      const clampPan = () => {
        if (!viewport) return;
        const vpW = viewport.clientWidth;
        const vpH = viewport.clientHeight;
        const dispW = vpW * scale;
        const dispH = vpW * scale * imgRatio;
        const maxX = Math.max(0, (dispW - vpW) / 2);
        const maxY = Math.max(0, (dispH - vpH) / 2);
        tx = Math.max(-maxX, Math.min(maxX, tx));
        ty = Math.max(-maxY, Math.min(maxY, ty));
      };

      if (zoomIn) zoomIn.addEventListener("click", () => zoomAt(1 + ZOOM_STEP));
      if (zoomOut) zoomOut.addEventListener("click", () => zoomAt(1 - ZOOM_STEP));
      if (zoomReset) zoomReset.addEventListener("click", resetView);

      if (viewport) {
        viewport.addEventListener(
          "wheel",
          (e) => {
            if (!e.ctrlKey && scale <= MIN_SCALE) return;
            e.preventDefault();
            const factor = e.deltaY < 0 ? 1.15 : 0.87;
            zoomAt(factor, e.clientX, e.clientY);
          },
          { passive: false }
        );
      }

      if (viewport) {
        const getPos = (e) => (e.touches && e.touches[0] ? { x: e.touches[0].clientX, y: e.touches[0].clientY } : { x: e.clientX, y: e.clientY });

        viewport.addEventListener("touchstart", (e) => {
          if (e.touches.length === 2) {
            const d = Math.hypot(
              e.touches[0].clientX - e.touches[1].clientX,
              e.touches[0].clientY - e.touches[1].clientY
            );
            pinchDist = d;
            pinchStartScale = scale;
            return;
          }
          dragging = true;
          startX = getPos(e).x;
          startY = getPos(e).y;
          startTx = tx;
          startTy = ty;
          lastDragX = startX;
        });

        viewport.addEventListener("touchmove", (e) => {
          if (e.touches.length === 2) {
            e.preventDefault();
            const d = Math.hypot(
              e.touches[0].clientX - e.touches[1].clientX,
              e.touches[0].clientY - e.touches[1].clientY
            );
            if (pinchDist > 0) {
              const midX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
              const midY = (e.touches[0].clientY + e.touches[1].clientY) / 2;
              const factor = d / pinchDist;
              zoomAt(factor / (scale / (pinchStartScale || 1)), midX, midY);
            }
            return;
          }
          if (!dragging || scale <= MIN_SCALE) return;
          e.preventDefault();
          const p = getPos(e);
          tx = startTx + (p.x - startX);
          ty = startTy + (p.y - startY);
          lastDragX = p.x;
          clampPan();
          applyTransform();
        });

        viewport.addEventListener("touchend", (e) => {
          if (e.touches.length === 2) { pinchDist = 0; return; }
          if (e.changedTouches && e.changedTouches.length === 1 && e.touches.length === 0) {
            const now = Date.now();
            const dt = now - lastTapTime;
            lastTapTime = now;
            if (dt < 300 && scale <= MIN_SCALE) {
              zoomAt(2, e.changedTouches[0].clientX, e.changedTouches[0].clientY);
            } else if (dt < 300 && scale > MIN_SCALE) {
              resetView();
            }
            if (scale > MIN_SCALE) {
              const deltaX = lastDragX - startX;
              const moved = Math.abs(deltaX) > 60 && Math.abs(e.changedTouches[0].clientX - startX) > 60;
              if (moved) {
                if (deltaX < 0 && current < total) { current++; render(); }
                else if (deltaX > 0 && current > 1) { current--; render(); }
              }
            }
          }
          dragging = false;
        });

        viewport.addEventListener("mousedown", (e) => {
          dragging = true;
          startX = e.clientX; startY = e.clientY;
          startTx = tx; startTy = ty;
          lastDragX = e.clientX;
          viewport.style.cursor = "grabbing";
        });
        window.addEventListener("mousemove", (e) => {
          if (!dragging || scale <= MIN_SCALE) return;
          tx = startTx + (e.clientX - startX);
          ty = startTy + (e.clientY - startY);
          lastDragX = e.clientX;
          clampPan();
          applyTransform();
        });
        window.addEventListener("mouseup", () => {
          if (dragging) {
            if (scale > MIN_SCALE) {
              const deltaX = lastDragX - startX;
              if (Math.abs(deltaX) > 80) {
                if (deltaX < 0 && current < total) { current++; render(); }
                else if (deltaX > 0 && current > 1) { current--; render(); }
              }
            }
            dragging = false;
            viewport.style.cursor = "";
          }
        });
      }

      const render = () => {
        img.src = dir + pages[current - 1];
        img.alt = title;
        indicator.textContent = current + " / " + total;
        prevBtn.disabled = current <= 1;
        nextBtn.disabled = current >= total;
        jumpBtns.forEach((btn, i) => {
          const active = i + 1 === current;
          btn.classList.toggle("bg-black/5", active);
          btn.classList.toggle("dark:bg-white/5", active);
          btn.classList.toggle("font-semibold", active);
          btn.classList.toggle("opacity-70", !active);
        });
        resetView();
      };

      prevBtn.addEventListener("click", () => { if (current > 1) { current--; render(); } });
      nextBtn.addEventListener("click", () => { if (current < total) { current++; render(); } });
      jumpBtns.forEach((btn) => {
        btn.addEventListener("click", () => { current = Number(btn.dataset.pdfJump); render(); });
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") { if (current > 1) { current--; render(); } }
        if (e.key === "ArrowRight") { if (current < total) { current++; render(); } }
        if (e.key === "+" || e.key === "=") zoomAt(1 + ZOOM_STEP);
        if (e.key === "-") zoomAt(1 - ZOOM_STEP);
        if (e.key === "0") resetView();
      });
      render();
    </script>
  )}
</BaseLayout>
