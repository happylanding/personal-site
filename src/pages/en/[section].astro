---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ColumnIcon from "../../components/ColumnIcon.astro";
import { useTranslations } from "../../i18n/utils";
import { ALL_SECTIONS } from "../../lib/sections";

export async function getStaticPaths() {
  return ALL_SECTIONS.map((section) => ({ params: { section } }));
}

const { section } = Astro.params;
const lang = "en" as const;
const t = useTranslations(lang);

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const sectionArticles = allArticles
  .filter((a) => a.data.section === section)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const isBooksSection = section === "books";
---

<BaseLayout title={t(`columns.${section}.name`)} description={t(`columns.${section}.desc`)}>
  <Breadcrumb
    crumbs={[
      { label: t(`columns.${section}.name`), href: `/en/${section}/` },
    ]}
  />

  <section data-reveal>
    <div class="mb-10">
      <span class="mb-4 block opacity-60"><ColumnIcon section={section as import("../../lib/sections").SectionKey} class="w-10 h-10" /></span>
      <h1 class="text-3xl font-serif font-bold mb-2">{t(`columns.${section}.name`)}</h1>
      <p class="text-sm text-black/40 dark:text-white/40">{t(`columns.${section}.enName`)}</p>
      <p class="text-base text-black/50 dark:text-white/50 mt-3 leading-relaxed max-w-2xl">
        {t(`columns.${section}.desc`)}
      </p>
    </div>

    {sectionArticles.length > 0 ? (
      isBooksSection ? (
        <div class="grid grid-cols-1 gap-6">
          {sectionArticles.map((article) => {
            const title = lang === "en" ? (article.data.titleEn || article.data.title) : article.data.title;
            const desc = lang === "en" ? (article.data.descriptionEn || article.data.description) : article.data.description;
            const author = lang === "en" ? (article.data.authorEn || article.data.author) : article.data.author;
            const displayTags = article.data.tagsEn?.length ? article.data.tagsEn : article.data.tags;
            const dateStr = article.data.date.toLocaleDateString("en-US", {
              year: "numeric", month: "long", day: "numeric",
            });
            const hasEpub = !!article.data.epubUrl;
            const hasPdf = !!article.data.pdfUrl;
            const hasMobi = !!article.data.mobiUrl;
            const hasAzw3 = !!article.data.azw3Url;
            const hasFb2 = !!article.data.fb2Url;
            const hasTxt = !!article.data.txtUrl;
            const hasBuy = !!article.data.buyUrl;
            const hasRead = !!article.data.readUrl;
            const hasReview = !!article.data.reviewUrl;
            return (
              <div class="flex flex-col sm:flex-row gap-5 p-5 rounded-xl border border-black/10 dark:border-white/10 hover-lift group">
                <div class="flex-shrink-0 w-20 h-28 bg-black/[0.04] dark:bg-white/[0.04] rounded flex items-center justify-center text-black/15 dark:text-white/15">
                  <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5A2.5 2.5 0 0 1 4 19.5Z"/>
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-bold font-serif group-hover:opacity-70 transition-opacity mb-1">
                    <a href={`/en/${section}/${article.slug}`} class="hover-scale-text inline-block">
                      {title}
                    </a>
                    {article.data.featured && <span class="ml-2 text-sm">★</span>}
                  </h3>
                  {author && <p class="text-sm text-black/50 dark:text-white/50 mb-2">{t("articles.author")}: {author}</p>}
                  {desc && <p class="text-sm text-black/40 dark:text-white/40 line-clamp-2 mb-3">{desc}</p>}
                  {article.data.rating && (
                    <div class="text-xs text-black/30 dark:text-white/30 mb-3">
                      {t("articles.rating")}: {"★".repeat(article.data.rating)}{"☆".repeat(5 - article.data.rating)}
                    </div>
                  )}
                  <div class="flex flex-wrap gap-2 mt-1">
                    {hasRead && (
                      <a href={article.data.readUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                        {t("articles.preview")}
                      </a>
                    )}
                    {hasReview && (
                      <a href={article.data.reviewUrl} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        {t("articles.review") || "Review"}
                      </a>
                    )}
                    {hasEpub && (
                      <a href={article.data.epubUrl} download class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        EPUB
                      </a>
                    )}
                    {hasMobi && (
                      <a href={article.data.mobiUrl} download class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        MOBI
                      </a>
                    )}
                    {hasAzw3 && (
                      <a href={article.data.azw3Url} download class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        AZW3
                      </a>
                    )}
                    {hasFb2 && (
                      <a href={article.data.fb2Url} download class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        FB2
                      </a>
                    )}
                    {hasTxt && (
                      <a href={article.data.txtUrl} download class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        TXT
                      </a>
                    )}
                    {hasPdf && (
                      <a href={article.data.pdfUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        PDF
                      </a>
                    )}
                    {hasBuy && (
                      <a href={article.data.buyUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black dark:bg-white text-white dark:text-black text-xs font-medium hover:opacity-80 transition-opacity">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        {t("articles.buyBook")}
                      </a>
                    )}
                  </div>
                  <div class="flex gap-2 mt-3">
                    {displayTags.slice(0, 3).map((tag: string) => (
                      <span class="text-xs text-black/25 dark:text-white/25">#{tag}</span>
                    ))}
                  </div>
                </div>
                <time class="text-xs text-black/25 dark:text-white/25 font-mono flex-shrink-0">{dateStr}</time>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="space-y-1">
          {sectionArticles.map((article) => {
            const title = lang === "en" ? (article.data.titleEn || article.data.title) : article.data.title;
            const desc = lang === "en" ? (article.data.descriptionEn || article.data.description) : article.data.description;
            const displayTags = article.data.tagsEn?.length ? article.data.tagsEn : article.data.tags;
            const dateStr = article.data.date.toLocaleDateString("en-US", {
              year: "numeric", month: "long", day: "numeric",
            });
            return (
              <a
                href={`/en/${section}/${article.slug}`}
                class="flex items-start justify-between py-4 px-4 rounded-lg hover:bg-black/[0.03] dark:hover:bg-white/[0.03] transition-colors group"
              >
                <div class="min-w-0">
                  <h3 class="text-base font-bold font-serif group-hover:opacity-70 transition-opacity mb-1 hover-scale-text">
                    {title}
                    {article.data.featured && <span class="ml-2 text-xs">★</span>}
                  </h3>
                  {desc && (
                    <p class="text-sm text-black/40 dark:text-white/40 line-clamp-1">{desc}</p>
                  )}
                  <div class="flex gap-2 mt-2">
                    {displayTags.slice(0, 3).map((tag: string) => (
                      <span class="text-xs text-black/25 dark:text-white/25">#{tag}</span>
                    ))}
                  </div>
                </div>
                <time class="text-xs text-black/25 dark:text-white/25 font-mono flex-shrink-0 ml-4 mt-1">
                  {dateStr}
                </time>
              </a>
            );
          })}
        </div>
      )
    ) : (
      <p class="py-12 text-center text-black/30 dark:text-white/30 italic">{t("articles.noArticles")}</p>
    )}
  </section>
</BaseLayout>
