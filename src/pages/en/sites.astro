---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/utils";

const isEn = true;
const lang = "en" as const;
const t = useTranslations(lang);

// 已收录的站点报告（按日期倒序）
const siteEntries = (await getCollection("sites", ({ data }) => !data.draft && !!data.siteUrl))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Design Inspiration Collection"
  description="Great sites & designs I come across, with breakdowns, creative analysis and highlights."
>
  <Breadcrumb
    crumbs={[{ label: "Collection", href: "/en/sites/" }]}
  />

  <section data-reveal>
    <header class="mb-10">
      <h1 class="text-3xl font-serif font-bold mb-2 flex items-center gap-3">
        <span class="block opacity-70 flex-shrink-0"><Icon name="bookmark" class="w-9 h-9" style="color:#0E96E9" /></span>
        <span>Design Inspiration Collection</span>
      </h1>
      <p class="text-sm text-black/40 dark:text-white/40">Curated sites & designs with breakdowns</p>
      <p class="text-base text-black/50 dark:text-white/50 mt-3 leading-relaxed max-w-2xl">
        Great sites & designs I come across are archived here — each entry is a breakdown of structure, creative analysis and highlights.
      </p>
    </header>

    {siteEntries.length > 0 ? (
      <div class="space-y-3">
        {siteEntries.map((entry, i) => {
          const title = entry.data.titleEn || entry.data.title;
          const desc = entry.data.descriptionEn || entry.data.description;
          const dateStr = entry.data.date.toLocaleDateString("en-US", {
            year: "numeric", month: "long", day: "numeric",
          });
          return (
            <a
              href={`/en/sites/${entry.slug}/`}
              class="block p-5 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 hover-lift transition-all duration-300 group"
            >
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-mono text-black/25 dark:text-white/25">
                  {String(i + 1).padStart(2, "0")}
                </span>
                {entry.data.siteUrl && (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/50 dark:text-white/50 inline-flex items-center gap-1">
                    <Icon name="link" class="w-3 h-3" />
                    {new URL(entry.data.siteUrl).hostname}
                  </span>
                )}
              </div>
              <h3 class="font-bold font-serif text-base mb-1.5 group-hover:opacity-70 transition-opacity leading-snug">{title}</h3>
              {desc && <p class="text-sm text-black/40 dark:text-white/40 line-clamp-2 leading-relaxed">{desc}</p>}
              <div class="flex items-center justify-between mt-3">
                <time class="text-xs text-black/25 dark:text-white/25 font-mono">{dateStr}</time>
                <span class="text-xs opacity-0 group-hover:opacity-40 transition-opacity"><Icon name="arrowRight" class="w-3.5 h-3.5" /></span>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="py-12 text-center text-black/30 dark:text-white/30 italic">Nothing collected yet.</p>
    )}
  </section>
</BaseLayout>
