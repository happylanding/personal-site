---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ToolIcon from "../../components/ToolIcon.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/utils";
import { TOOL_COLORS, TOOL_TYPE_ORDER, type ToolEntry } from "../../content/tools/config";

const lang = "en" as const;
const t = useTranslations(lang);
const isEn = true;

// 已入库工具（按置顶 + 更新日期倒序）
const tools = (await getCollection("tools", ({ data }) => !data.draft)) as unknown as ToolEntry[];
tools.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return (b.data.updated || b.data.date).getTime() - (a.data.updated || a.data.date).getTime();
});

const total = tools.length;
const appCount = tools.filter((x) => x.data.type === "app").length;
const scriptCount = tools.filter((x) => x.data.type === "script").length;
const statsText = t("tools.stats")
  .replace("{total}", String(total))
  .replace("{apps}", String(appCount))
  .replace("{scripts}", String(scriptCount));

// 扭蛋数据（供 define:vars 注入到客户端脚本）
const gachaTools = tools.map((x) => ({
  title: isEn ? x.data.titleEn || x.data.title : x.data.title,
  desc: (isEn ? x.data.descriptionEn || x.data.description : x.data.description) || "",
  type: x.data.type,
  href: x.data.type === "script"
    ? (x.data.downloadUrl || "#")
    : (x.data.url || "#"),
  external: x.data.type === "online",
}));
---

<BaseLayout
  title={t("tools.name")}
  description={t("tools.desc")}
>
  <Breadcrumb crumbs={[{ label: t("tools.name"), href: "/en/tools/" }]} />

  <section data-reveal>
    <!-- 页头 -->
    <header class="mb-8">
      <div class="w-12 h-1 rounded-full mb-4" style={{ backgroundColor: TOOL_COLORS.script }}></div>
      <h1 class="text-3xl font-serif font-bold mb-2">
        {t("tools.name")}
        <span class="ml-2 text-sm font-sans font-normal text-black/35 dark:text-white/35 align-middle">{t("tools.enName")}</span>
      </h1>
      <p class="text-sm text-black/40 dark:text-white/40">{t("tools.subtitle")}</p>
      <p class="text-base text-black/50 dark:text-white/50 mt-3 leading-relaxed max-w-2xl">{t("tools.desc")}</p>
      <p class="text-xs font-mono text-black/30 dark:text-white/30 mt-3">{statsText}</p>
    </header>

    <!-- 随机扭蛋：点击弹出扭蛋卡，可就地再看/直达工具 -->
    <div class="mb-8">
      <button
        id="tool-gacha-btn"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-black/15 dark:border-white/15 text-sm font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors"
      >
        {t("tools.gacha")}
      </button>
      <span id="tool-gacha-result" class="ml-3 text-sm text-black/40 dark:text-white/40"></span>
    </div>

    <!-- 扭蛋结果弹层 -->
    <div
      id="tool-gacha-modal"
      class="fixed inset-0 z-[90] hidden items-center justify-center p-4"
      role="dialog"
      aria-modal="true"
      aria-label={t("tools.gachaTitle")}
    >
      <div id="tool-gacha-backdrop" class="absolute inset-0 bg-black/40 dark:bg-black/70 backdrop-blur-sm"></div>
      <div
        class="relative w-full max-w-sm rounded-2xl border border-black/10 dark:border-white/10 bg-white dark:bg-neutral-900 shadow-2xl p-6 text-center overflow-hidden"
      >
        <span class="ghost-num text-black/5 dark:text-white/5 select-none pointer-events-none" aria-hidden="true">🎲</span>
        <button
          id="tool-gacha-close"
          class="absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-lg hover:bg-black/5 dark:hover:bg-white/5 text-black/40 dark:text-white/40 transition-colors"
          aria-label="Close"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
        <p class="text-xs uppercase tracking-[0.15em] opacity-40 font-medium mb-4">{t("tools.gachaTitle")}</p>
        <div id="tool-gacha-modal-body" class="mb-6"></div>
        <div class="flex items-center justify-center gap-3">
          <button
            id="tool-gacha-again"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-black/15 dark:border-white/15 text-sm font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors"
          >
            🎲 {t("tools.gachaHint")}
          </button>
          <a
            id="tool-gacha-open"
            href="#"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-black dark:bg-white text-white dark:text-black text-sm font-medium hover:opacity-80 transition-opacity"
          >
            🎯 {t("tools.gachaGo")}
          </a>
        </div>
      </div>
    </div>

    <!-- 分类 Tab -->
    <div class="flex flex-wrap gap-2 mb-8" role="tablist" aria-label={t("tools.name")}>
      <button
        class="tool-tab text-sm px-4 py-1.5 rounded-full border transition-colors"
        data-type="all"
        data-active="true"
      >
        {t("tools.all")}
      </button>
      {TOOL_TYPE_ORDER.map((tp) => (
        <button
          class="tool-tab text-sm px-4 py-1.5 rounded-full border transition-colors"
          data-type={tp}
          data-active="false"
        >
          <span class="inline-block w-1.5 h-1.5 rounded-full mr-1.5 align-middle" style={{ backgroundColor: TOOL_COLORS[tp] }}></span>
          {t(`tools.type.${tp}`)}
        </button>
      ))}
    </div>

    <!-- 工具卡片 -->
    {tools.length > 0 ? (
      <div id="tool-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {tools.map((tool, i) => {
          const title = isEn ? (tool.data.titleEn || tool.data.title) : tool.data.title;
          const desc = isEn ? (tool.data.descriptionEn || tool.data.description) : tool.data.description;
          const type = tool.data.type;
          const color = TOOL_COLORS[type];
          const statusLabel = t(`tools.status.${tool.data.status}`);
          const statusColor =
            tool.data.status === "online" ? "#16A34A"
            : tool.data.status === "stable" ? "#B45309"
            : tool.data.status === "beta" ? "#0E96E9"
            : "#737373";
          const tags = isEn ? (tool.data.tagsEn?.length ? tool.data.tagsEn : tool.data.tags) : tool.data.tags;
          const version = tool.data.version;
          const updated = tool.data.updated || tool.data.date;

          return (
            <div
              class="tool-card roll-card group block p-5 rounded-xl border border-black/10 dark:border-white/10 hover-lift transition-all duration-300 hover:border-black/30 dark:hover:border-white/30 relative overflow-hidden"
              data-type={type}
              style={`--roll-index:${i}`}
            >
              <span class="ghost-num text-black/5 dark:text-white/5 select-none pointer-events-none" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>

              <div class="flex items-center gap-2 mb-3">
                <span class="block opacity-60"><ToolIcon type={type} class="w-7 h-7" /></span>
                <span
                  class="inline-flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5"
                  style={{ color: statusColor }}
                >
                  <span class="w-1.5 h-1.5 rounded-full" style={{ backgroundColor: statusColor }}></span>
                  {statusLabel}
                </span>
              </div>

              <h3 class="font-bold font-serif text-base mb-1.5 leading-snug">{title}</h3>
              <p class="text-xs font-mono text-black/30 dark:text-white/30 mb-2">
                {t(`tools.type.${type}`)}
                {version && <span class="ml-2">v{version}</span>}
              </p>
              {desc && <p class="text-sm text-black/40 dark:text-white/40 line-clamp-2 leading-relaxed mb-4">{desc}</p>}

              <!-- 脚本工具：有可执行命令 → 终端框 + 复制；否则 → 使用方法步骤 + 下载 -->
              {type === "script" ? (
                <div class="mt-2">
                  {tool.data.command ? (
                    <>
                      <div class="rounded-lg border border-black/15 dark:border-white/15 bg-black/[0.04] dark:bg-white/[0.04] font-mono text-xs overflow-hidden">
                        <div class="flex items-center gap-1.5 px-3 py-2 border-b border-black/10 dark:border-white/10">
                          <span class="w-2 h-2 rounded-full bg-red-400/70"></span>
                          <span class="w-2 h-2 rounded-full bg-amber-400/70"></span>
                          <span class="w-2 h-2 rounded-full bg-green-400/70"></span>
                          <span class="ml-2 text-black/40 dark:text-white/40 truncate">~/tools/{title}</span>
                        </div>
                        <div class="px-3 py-2.5 break-all leading-relaxed">
                          {tool.data.command}
                        </div>
                      </div>
                      <div class="flex gap-2 mt-3">
                        <button
                          class="tool-copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors"
                          data-copy={tool.data.command}
                        >
                          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                          <span class="copy-label">{t("tools.copy")}</span>
                        </button>
                        {tool.data.downloadUrl && (
                          <a
                            href={tool.data.downloadUrl}
                            download
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black dark:bg-white text-white dark:text-black text-xs font-medium hover:opacity-80 transition-opacity"
                          >
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            {t("tools.download")}
                          </a>
                        )}
                      </div>
                    </>
                  ) : (
                    <>
                      <div class="rounded-lg border border-black/15 dark:border-white/15 bg-black/[0.02] dark:bg-white/[0.02] p-3">
                        <p class="text-xs font-semibold text-black/50 dark:text-white/50 mb-2">
                          {t("tools.usage")}
                          <span class="ml-1 font-normal text-black/30 dark:text-white/30">
                            {t("tools.usageSteps").replace("{count}", String((tool.data.usage || []).length))}
                          </span>
                        </p>
                        <ol class="space-y-1.5">
                          {(tool.data.usage || []).map((step, si) => (
                            <li class="flex items-start gap-2 text-xs text-black/40 dark:text-white/40 leading-relaxed">
                              <span class="flex-shrink-0 w-4 h-4 rounded-full bg-black/10 dark:bg-white/10 text-[10px] font-semibold flex items-center justify-center mt-px">{si + 1}</span>
                              <span>{step}</span>
                            </li>
                          ))}
                        </ol>
                        <p class="text-[11px] text-black/25 dark:text-white/25 mt-2">{t("tools.usageHint")}</p>
                      </div>
                      <div class="flex gap-2 mt-3">
                        {tool.data.downloadUrl && (
                          <a
                            href={tool.data.downloadUrl}
                            download
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black dark:bg-white text-white dark:text-black text-xs font-medium hover:opacity-80 transition-opacity"
                          >
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            {t("tools.download")}
                          </a>
                        )}
                      </div>
                    </>
                  )}
                </div>
              ) : (
                <div class="flex items-center justify-between mt-4">
                  <a
                    href={tool.data.url}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-black/15 dark:border-white/15 text-xs font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors"
                  >
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    {t("tools.open")}
                  </a>
                  {tool.data.url && (
                    <span class="text-xs text-black/25 dark:text-white/25">
                      {t("tools.external")} · {new URL(tool.data.url).hostname}
                    </span>
                  )}
                </div>
              )}

              <div class="flex items-center justify-between mt-4">
                <div class="flex gap-2">
                  {tags.slice(0, 3).map((tag: string) => (
                    <span class="text-xs text-black/25 dark:text-white/25">#{tag}</span>
                  ))}
                </div>
                <time class="text-xs text-black/25 dark:text-white/25 font-mono flex-shrink-0 ml-4">
                  {updated.toLocaleDateString(isEn ? "en-US" : "zh-CN", { year: "numeric", month: "short" })}
                </time>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <p class="py-12 text-center text-black/30 dark:text-white/30 italic">{t("tools.empty")}</p>
    )}

    <!-- 页脚说明 -->
    <p class="mt-12 text-center text-sm text-black/40 dark:text-white/40">{t("tools.footer")}</p>
  </section>

  <script define:vars={{ gachaTools }}>
    window.__TOOL_GACHA__ = gachaTools || [];
  </script>
</BaseLayout>

<style>
  .tool-tab[data-active="true"] {
    background-color: rgba(0, 0, 0, 0.08);
    font-weight: 600;
  }
  :global(.dark) .tool-tab[data-active="true"] {
    background-color: rgba(255, 255, 255, 0.12);
  }
  .tool-card[hidden] {
    display: none;
  }
</style>

<script>
  // 分类 Tab 过滤
  (function () {
    const tabs = document.querySelectorAll(".tool-tab");
    const cards = document.querySelectorAll(".tool-card");
    if (!tabs.length || !cards.length) return;

    function applyFilter(type) {
      tabs.forEach((tb) => {
        tb.dataset.active = tb.dataset.type === type ? "true" : "false";
      });
      cards.forEach((c) => {
        c.hidden = type !== "all" && c.dataset.type !== type;
      });
    }

    tabs.forEach((tb) => {
      tb.addEventListener("click", () => applyFilter(tb.dataset.type));
    });
  })();

  // 一键复制命令
  (function () {
    const btns = document.querySelectorAll(".tool-copy-btn");
    if (!btns.length) return;

    btns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text = btn.dataset.copy || "";
        const label = btn.querySelector(".copy-label");
        const old = label ? label.textContent : "";
        try {
          await navigator.clipboard.writeText(text);
          if (label) label.textContent = "✓ 已复制";
        } catch (e) {
          // 剪贴板不可用时降级：选中文本
          const ta = document.createElement("textarea");
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          document.body.removeChild(ta);
          if (label) label.textContent = "✓ 已复制";
        }
        if (label) {
          setTimeout(() => {
            label.textContent = old;
          }, 1500);
        }
      });
    });
  })();

  // 随机扭蛋：弹出式扭蛋卡
  (function () {
    const btn = document.getElementById("tool-gacha-btn");
    const result = document.getElementById("tool-gacha-result");
    const modal = document.getElementById("tool-gacha-modal");
    const backdrop = document.getElementById("tool-gacha-backdrop");
    const closeBtn = document.getElementById("tool-gacha-close");
    const againBtn = document.getElementById("tool-gacha-again");
    const openLink = document.getElementById("tool-gacha-open");
    const modalBody = document.getElementById("tool-gacha-modal-body");
    if (!btn || !result || !modal || !backdrop || !closeBtn || !againBtn || !openLink || !modalBody) return;

    // 读取 SSR 注入的工具列表（含标题/简介/类型/链接）
    const pool = (window.__TOOL_GACHA__ || []).slice();
    if (!pool.length) {
      btn.addEventListener("click", () => {
        result.textContent = window.__TOOL_EMPTY_MSG__ || "No tools to recommend yet";
      });
      return;
    }

    function openModal() {
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.documentElement.style.overflow = "hidden";
    }
    function closeModal() {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.documentElement.style.overflow = "";
    }

    function renderPick(pick) {
      const color =
        pick.type === "online" ? "#0E96E9"
        : pick.type === "app" ? "#16A34A"
        : "#B45309";
      const typeLabel =
        pick.type === "online" ? (window.__GACHA_TYPE_ONLINE__ || "Online Tool")
        : pick.type === "app" ? (window.__GACHA_TYPE_APP__ || "Mini App")
        : (window.__GACHA_TYPE_SCRIPT__ || "Script");
      modalBody.innerHTML =
        '<div class="w-12 h-12 mx-auto rounded-xl flex items-center justify-center mb-4" style="background:' + color + '22;color:' + color + '">' +
        '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
        '<path d="M9.5 4.5h5a2 2 0 0 1 2 2v1h3.5a1 1 0 0 1 1 1v9.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8.5a1 1 0 0 1 1-1h3.5v-1a2 2 0 0 1 2-2z"/><path d="M3 13.5h18"/>' +
        '</svg></div>' +
        '<p class="text-[11px] font-mono mb-2" style="color:' + color + '">' + typeLabel + '</p>' +
        '<h3 class="text-lg font-serif font-bold mb-2">' + pick.title + '</h3>' +
        (pick.desc ? '<p class="text-sm text-black/40 dark:text-white/40 leading-relaxed line-clamp-3">' + pick.desc + '</p>' : '');
      openLink.setAttribute("href", pick.href);
      if (pick.external) {
        openLink.setAttribute("target", "_blank");
        openLink.setAttribute("rel", "noopener");
      } else {
        openLink.removeAttribute("target");
        openLink.removeAttribute("rel");
      }
    }

    function spin() {
      const pick = pool[Math.floor(Math.random() * pool.length)];
      result.textContent = "🔧 " + pick.title;
      renderPick(pick);
      openModal();
    }

    btn.addEventListener("click", spin);
    againBtn.addEventListener("click", spin);
    closeBtn.addEventListener("click", closeModal);
    backdrop.addEventListener("click", closeModal);
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeModal();
    });
    // Astro view-transition 时关闭
    document.addEventListener("astro:after-swap", closeModal);
  })();
</script>
