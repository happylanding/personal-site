---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import ScrollReveal from "../../../components/ScrollReveal.astro";
import { useTranslations } from "../../../i18n/utils";
import { getCollection } from "astro:content";

const lang = "en" as const;
const t = useTranslations(lang);

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const tagMap = new Map<string, number>();
allArticles.forEach((a) => {
  const tags = a.data.tagsEn.length > 0 ? a.data.tagsEn : a.data.tags;
  tags.forEach((tag: string) => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});
const sortedTags = [...tagMap.entries()].sort(([, a], [, b]) => b - a);
---

<BaseLayout title={t("tags.title")} description={t("tags.description")}>
  <Breadcrumb crumbs={[{ label: t("tags.title"), href: "/en/tags/" }]} />

  <section data-reveal>
    <h1 class="text-3xl font-serif font-bold mb-12">{t("tags.title")}</h1>
    <div class="flex flex-wrap gap-3">
      {sortedTags.map(([tag, count]) => (
        <a
          href={`/en/tags/${tag}`}
          class="px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 hover-lift transition-all text-sm"
        >
          #{tag}
          <span class="ml-1 text-[13px] text-black/50 dark:text-white/65">({count})</span>
        </a>
      ))}
    </div>
  </section>

  <ScrollReveal />
</BaseLayout>
