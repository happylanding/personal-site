---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import ScrollReveal from "../../../components/ScrollReveal.astro";
import { useTranslations } from "../../../i18n/utils";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  const tags = [...new Set(articles.flatMap((a) => a.data.tagsEn.length > 0 ? a.data.tagsEn : a.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const lang = "en" as const;
const t = useTranslations(lang);

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const filtered = allArticles
  .filter((a) => {
    const tags = a.data.tagsEn.length > 0 ? a.data.tagsEn : a.data.tags;
    return tags.includes(tag);
  })
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={`#${tag}`} description={`${t("tags.articleCount")} ${filtered.length}`}>
  <Breadcrumb
    crumbs={[
      { label: t("tags.title"), href: "/en/tags/" },
      { label: `#${tag}`, href: "#" },
    ]}
  />

  <section data-reveal>
    <h1 class="text-3xl font-serif font-bold mb-4">#{tag}</h1>
    <p class="text-sm text-black/40 dark:text-white/40 mb-8">{filtered.length} {t("tags.articleCount")}</p>

    <div class="space-y-1">
      {filtered.map((article) => {
        const title = article.data.titleEn || article.data.title;
        return (
          <a
            href={`/en/${article.data.section}/${article.id}`}
            class="flex items-center justify-between py-3 px-4 rounded-lg hover:bg-black/[0.03] dark:hover:bg-white/[0.03] transition-colors group"
          >
            <span class="text-sm group-hover:text-black dark:group-hover:text-white transition-colors font-medium">{title}</span>
            <time class="text-[13px] text-black/45 dark:text-white/60 font-mono flex-shrink-0 ml-4">
              {article.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
            </time>
          </a>
        );
      })}
    </div>
  </section>

  <ScrollReveal />
</BaseLayout>
