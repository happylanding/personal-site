---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import Icon from "../../../components/Icon.astro";
import { useTranslations } from "../../../i18n/utils";

export async function getStaticPaths() {
  const sites = await getCollection("sites", ({ data }) => !data.draft && !!data.siteUrl);
  return sites.map((site) => ({ params: { slug: site.id } }));
}

const { slug } = Astro.params;
const lang = "en" as const;
const t = useTranslations(lang);

const allSites = await getCollection("sites", ({ data }) => !data.draft && !!data.siteUrl);
const entry = allSites.find((s) => s.id === slug);
if (!entry) return Astro.redirect("/404");

// 同系列内按日期排序，用于上一篇 / 下一篇
const sectionSites = allSites.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const idx = sectionSites.findIndex((s) => s.id === slug);
const prevEntry = idx > 0 ? sectionSites[idx - 1] : undefined;
const nextEntry = idx >= 0 && idx < sectionSites.length - 1 ? sectionSites[idx + 1] : undefined;

const { Content } = await render(entry);

const isEn = true;
const title = entry.data.titleEn || entry.data.title;
const desc = entry.data.descriptionEn || entry.data.description;
const dateStr = entry.data.date.toLocaleDateString("en-US", {
  year: "numeric", month: "long", day: "numeric",
});
const host = entry.data.siteUrl ? new URL(entry.data.siteUrl).hostname : "";
const displayTags = entry.data.tagsEn?.length ? entry.data.tagsEn : entry.data.tags;
---

<BaseLayout title={title} description={desc}>
  <Breadcrumb
    crumbs={[
      { label: "Collection", href: "/en/sites/" },
      { label: title, href: "#" },
    ]}
  />

  <article class="max-w-2xl mx-auto" data-reveal>
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-[13px] px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75 inline-flex items-center gap-1">
          <Icon name="bookmark" class="w-3 h-3" />
          Collection
        </span>
        {entry.data.siteUrl && (
          <a
            href={entry.data.siteUrl}
            target="_blank"
            rel="noopener"
            class="text-[13px] px-2 py-0.5 rounded-full border border-black/15 dark:border-white/15 text-black/60 dark:text-white/75 hover:bg-black/[0.04] dark:hover:bg-white/[0.04] inline-flex items-center gap-1 transition-colors"
          >
            <Icon name="link" class="w-3 h-3" />
            {host}
          </a>
        )}
      </div>

      <h1 class="text-3xl md:text-4xl font-serif font-bold leading-tight mb-4">{title}</h1>
      {desc && <p class="text-base text-black/50 dark:text-white/50 mb-4 leading-relaxed">{desc}</p>}

      <time class="text-sm text-black/45 dark:text-white/60 font-mono" datetime={entry.data.date.toISOString()}>
        {dateStr}
      </time>

      {displayTags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {displayTags.slice(0, 5).map((tag: string) => (
            <span class="text-[13px] px-2 py-1 rounded-md bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose dark:prose-invert article-content max-w-none">
      <Content />
    </div>

    <!-- Previous / Next -->
    <nav class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {prevEntry ? (
        <a
          href={`/en/sites/${prevEntry.id}/`}
          class="group p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-colors"
        >
          <p class="text-xs text-black/30 dark:text-white/30 mb-1 inline-flex items-center gap-1"><Icon name="arrowLeft" class="w-3 h-3" /> Previous</p>
          <p class="text-sm font-medium group-hover:opacity-70 transition-opacity line-clamp-2">
            {prevEntry.data.titleEn || prevEntry.data.title}
          </p>
        </a>
      ) : (
        <span></span>
      )}
      {nextEntry ? (
        <a
          href={`/en/sites/${nextEntry.id}/`}
          class="group p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-colors sm:text-right"
        >
          <p class="text-xs text-black/30 dark:text-white/30 mb-1 inline-flex items-center gap-1">Next <Icon name="arrowRight" class="w-3 h-3" /></p>
          <p class="text-sm font-medium group-hover:opacity-70 transition-opacity line-clamp-2">
            {nextEntry.data.titleEn || nextEntry.data.title}
          </p>
        </a>
      ) : (
        <span></span>
      )}
    </nav>

    <nav class="mt-12">
      <a
        href="/en/sites/"
        class="inline-flex items-center gap-2 text-sm text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors"
      >
        <Icon name="arrowLeft" class="w-4 h-4" />
        Back to collection
      </a>
    </nav>
  </article>
</BaseLayout>
