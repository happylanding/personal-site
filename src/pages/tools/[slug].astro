---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ToolIcon from "../../components/ToolIcon.astro";
import Icon from "../../components/Icon.astro";
import AIIsmDetector from "../../components/AIIsmDetector.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { TOOL_COLORS } from "../../content/tools/config";

export async function getStaticPaths() {
  const tools = await getCollection("tools", ({ data }) => !data.draft);
  return tools.map((tool) => ({ params: { slug: tool.id } }));
}

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEn = lang === "en";

const allTools = await getCollection("tools", ({ data }) => !data.draft);
const tool = allTools.find((x) => x.id === slug);
if (!tool) return Astro.redirect("/404");

const { Content } = await render(tool);

const type = tool.data.type;
const title = isEn ? (tool.data.titleEn || tool.data.title) : tool.data.title;
const desc = isEn ? (tool.data.descriptionEn || tool.data.description) : tool.data.description;
const statusLabel = t(`tools.status.${tool.data.status}`);
const statusColor =
  tool.data.status === "online" ? "#16A34A"
  : tool.data.status === "stable" ? "#B45309"
  : tool.data.status === "beta" ? "#0E96E9"
  : "#737373";
const tags = isEn ? (tool.data.tagsEn?.length ? tool.data.tagsEn : tool.data.tags) : tool.data.tags;
const usage = isEn ? (tool.data.usageEn?.length ? tool.data.usageEn : tool.data.usage) : tool.data.usage;
const updated = tool.data.updated || tool.data.date;
const dateStr = updated.toLocaleDateString(isEn ? "en-US" : "zh-CN", {
  year: "numeric", month: "long", day: "numeric",
});
const listHref = isEn ? "/en/tools/" : "/tools/";
const downloadUrl = tool.data.downloadUrl;
---

<BaseLayout title={title} description={desc}>
  <Breadcrumb
    crumbs={[
      { label: t("tools.name"), href: listHref },
      { label: title, href: "#" },
    ]}
  />

  <article class="max-w-2xl mx-auto" data-reveal>
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="block opacity-80"><ToolIcon type={type} class="w-6 h-6" /></span>
        <span
          class="inline-flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5"
          style={{ color: statusColor }}
        >
          <span class="w-1.5 h-1.5 rounded-full" style={{ backgroundColor: statusColor }}></span>
          {statusLabel}
        </span>
        <span class="text-[13px] px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75">
          {t(`tools.type.${type}`)}
          {tool.data.version && <span class="ml-1">v{tool.data.version}</span>}
        </span>
      </div>

      <h1 class="text-3xl md:text-4xl font-serif font-bold leading-tight mb-4">{title}</h1>
      {desc && <p class="text-base text-black/50 dark:text-white/50 mb-4 leading-relaxed">{desc}</p>}

      <div class="flex flex-wrap items-center gap-3">
        {type === "script" && downloadUrl && (
          <a
            href={downloadUrl}
            download
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-black dark:bg-white text-white dark:text-black text-sm font-medium hover:opacity-80 transition-opacity"
          >
            <Icon name="download" class="w-4 h-4" />
            {t("tools.download")}
          </a>
        )}
        {tool.data.url && (
          <a
            href={tool.data.url}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-black/15 dark:border-white/15 text-sm font-medium hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-colors"
          >
            <Icon name="link" class="w-4 h-4" />
            {t("tools.open")}
          </a>
        )}
        <time class="text-sm text-black/45 dark:text-white/60 font-mono" datetime={updated.toISOString()}>
          {dateStr}
        </time>
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.slice(0, 5).map((tag: string) => (
            <span class="text-[13px] px-2 py-1 rounded-md bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/75">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    {slug === "ai-ism-detector" && (
      <div class="mb-10">
        <AIIsmDetector lang="zh" />
      </div>
    )}

    {type === "script" && usage && usage.length > 0 && (
      <div class="mb-8 p-6 rounded-xl border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02]">
        <h2 class="font-bold font-serif mb-4 inline-flex items-center gap-2">
          <Icon name="list" class="w-4 h-4" />
          {t("tools.stepsTitle")} · {t("tools.usageSteps").replace("{count}", String(usage.length))}
        </h2>
        <ol class="space-y-3">
          {usage.map((step: string, i: number) => (
            <li class="flex gap-3 items-start">
              <span
                class="flex-shrink-0 w-6 h-6 rounded-full inline-flex items-center justify-center text-xs font-bold"
                style={{ backgroundColor: TOOL_COLORS[type] + "22", color: TOOL_COLORS[type] }}
              >
                {i + 1}
              </span>
              <span class="text-sm leading-relaxed text-black/60 dark:text-white/60 pt-0.5">{step}</span>
            </li>
          ))}
        </ol>
      </div>
    )}

    <div class="prose dark:prose-invert article-content">
      <Content />
    </div>

    <nav class="mt-12">
      <a
        href={listHref}
        class="inline-flex items-center gap-2 text-sm text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors"
      >
        <Icon name="arrowLeft" class="w-4 h-4" />
        {t("tools.backToList")}
      </a>
    </nav>
  </article>
</BaseLayout>
