---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ScrollReveal from "../../components/ScrollReveal.astro";
import { getCollection } from "astro:content";

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const tagMap = new Map<string, number>();
allArticles.forEach((a) => {
  a.data.tags.forEach((tag: string) => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});
const sortedTags = [...tagMap.entries()].sort(([, a], [, b]) => b - a);
---

<BaseLayout title="标签" description="按标签浏览文章">
  <Breadcrumb crumbs={[{ label: "标签", href: "/tags/" }]} />

  <section data-reveal>
    <h1 class="text-3xl font-serif font-bold mb-12">标签</h1>
    <div class="flex flex-wrap gap-3">
      {sortedTags.map(([tag, count]) => (
        <a
          href={`/tags/${tag}`}
          class="px-4 py-2 rounded-lg border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 hover-lift transition-all text-sm"
        >
          #{tag}
          <span class="ml-1 text-[13px] text-black/50 dark:text-white/65">({count})</span>
        </a>
      ))}
    </div>
  </section>

  <ScrollReveal />
</BaseLayout>
