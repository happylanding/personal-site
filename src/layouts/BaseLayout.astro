---
/* Galvin design reminder: the global shell is a quiet deep-blue AI editorial workspace.
   Dark is the default; one local violet/cyan signal may guide, never decorate every surface. */
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import ReadingProgress from "../components/ReadingProgress.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const defaultTitle = "Galvin — 把好奇心，做成一点有用的东西。";
const defaultDesc = "Galvin 的个人 AI 学习与创作空间，记录工具、思考、工作方法与生活轨迹。";

const pageTitle = Astro.props.title ? `${Astro.props.title} — Galvin` : defaultTitle;
const pageDesc = Astro.props.description || defaultDesc;
const ogImg = Astro.props.ogImage || "/favicon.svg";
const path = Astro.url.pathname;
const canonical = path.replace(/^\/en/, "") || "/";
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImg} />
    <meta property="og:site_name" content="Galvin" />
    <link rel="canonical" href={new URL(canonical, Astro.site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        var savedTheme = localStorage.getItem("theme");
        if (savedTheme === "light") document.documentElement.classList.remove("dark");
        else document.documentElement.classList.add("dark");
      })();
    </script>

    <title>{pageTitle}</title>
  </head>
  <body class="galvin-site flex min-h-screen flex-col">
    <ReadingProgress />
    <Header />
    <script src="../scripts/scroll-effects.js"></script>
    <main class="galvin-main flex-1">
      <slot />
      <ScrollReveal />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>

<style is:global>
  @view-transition {
    navigation: auto;
  }
</style>
