---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import UiEffects from "../components/UiEffects.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const siteTitle = "Galvin";
const siteSubtitle = "从好奇，到创造";
const defaultTitle = siteTitle + " — " + siteSubtitle;
const defaultDesc = "Galvin 的个人网站 — AI 学习 × 数字经济，记录思考、分享知识";

const pageTitle = Astro.props.title ? `${Astro.props.title} — ${siteTitle}` : defaultTitle;
const pageDesc = Astro.props.description || defaultDesc;
const ogImg = Astro.props.ogImage || "/favicon.svg";
const canonical = Astro.url.pathname;
---

<!doctype html>
<html lang="zh" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={pageDesc} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImg} />
    <meta property="og:site_name" content={siteTitle} />

    <link rel="canonical" href={new URL(canonical, Astro.site).href} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: V2 人文温暖（瘦身版：正文 Source Sans/Noto Sans 各 2~3 字重，衬线/手写体非阻塞按需加载） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 正文（阻塞首屏）：Source Sans 3 + Noto Sans SC 各 3 个字重 -->
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- 衬线/手写体（标题、hero、motto）：非阻塞按需加载，不拖首屏 -->
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800;900&family=Noto+Serif+SC:wght@400;500;600;700;900&family=Caveat:wght@500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800;900&family=Noto+Serif+SC:wght@400;500;600;700;900&family=Caveat:wght@500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- FOUC prevention: set dark before render -->
    <script is:inline>
      (function () {
        const t = localStorage.getItem("theme");
        if (t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <!-- P2-4 字体就绪门控：先标 .js，等 document.fonts 就绪后加 .fonts-ready，
         启动 hero 遮罩上拉动画；1s 超时兜底避免字体加载过慢导致首屏空白。
         body 级淡入（见 global.css html.js body）也由 fonts-ready 驱动，
         抑制跨栏目录 MPA 导航时字体 swap 造成的文字闪烁。 -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        html.classList.add("js");
        var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        function ready() {
          html.classList.add("fonts-ready");
        }
        if (reduced || !document.fonts || !document.fonts.ready) {
          ready();
          return;
        }
        var done = false;
        function finish() {
          if (done) return;
          done = true;
          ready();
        }
        document.fonts.ready.then(finish, finish);
        setTimeout(finish, 1000); // 首屏遮罩超时收紧到 1s，避免字体加载慢时首屏卡在遮罩下
      })();
    </script>

    <title>{pageTitle}</title>
  </head>
  <body class="bg-white dark:bg-black text-black dark:text-white font-sans transition-colors duration-300 flex min-h-screen flex-col">
    <ReadingProgress />
    <Header />

    <!-- 合并后的滚动/进度/视差统一驱动（一次 scroll 回调 + 一次 rAF） -->
    <script src="../scripts/scroll-effects.js"></script>
    <main class="mx-auto w-full max-w-6xl px-6 pt-12 pb-6 flex-1 2xl:max-w-[1400px]">
      <slot />
      <ScrollReveal />
    </main>
    <Footer />
    <BackToTop />
    <UiEffects />
  </body>
</html>

<!-- Page transitions (effect C) -->
<style is:global>
  @view-transition {
    navigation: auto;
  }
</style>
