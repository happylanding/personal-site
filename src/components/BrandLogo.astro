---
/**
 * BrandLogo — 个人品牌图标
 *
 * 设计概念「星野极光 · 上升之星」：
 *   - 极光山脊：三层渐层山脊自左向右拾级而上（呼应全站「星野极光」背景主题）
 *   - 上升之星：山巅之上的四芒星（呼应 Hero 光尘 / 栏目琥珀色，寓意「持续精进，复利成长」）
 *   - 配色沿用全站品牌色：深蓝 #1E3A8A → 紫罗兰 #7C3AED → 酒红 #E11D48 渐变底 + 琥珀金星 #FBBF24
 *   - 圆角方形徽章：与 favicon 完全同源，保证浏览器标签页与站内品牌一致
 *
 * 用法：<BrandLogo class="w-7 h-7" />
 */

interface Props {
  class?: string;
}

const { class: cls = "w-7 h-7" } = Astro.props;
// 生成唯一渐变 ID，避免同一页面多次渲染时 SVG id 冲突
const gradientId = `brand-logo-aurora-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  class={cls}
  viewBox="0 0 48 48"
  role="img"
  aria-label="Galvin"
>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1E3A8A"/>
      <stop offset="0.5" stop-color="#7C3AED"/>
      <stop offset="1" stop-color="#E11D48"/>
    </linearGradient>
  </defs>
  <rect x="2.5" y="2.5" width="43" height="43" rx="13" fill={`url(#${gradientId})`}/>
  <!-- aurora ridges -->
  <path d="M8 28 L16 19 L22 27 L29.5 18 L40.5 28" fill="none" stroke="#fff" stroke-opacity="0.38" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M8 34 L16 25 L22.5 32 L30.5 23 L40.5 32" fill="none" stroke="#fff" stroke-opacity="0.68" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M8 40 L16.5 31 L23 38 L31 29 L40.5 37.5" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- 4-point rising star -->
  <path d="M31.5 4 L33.7 9.3 L39 11.5 L33.7 13.7 L31.5 19 L29.3 13.7 L24 11.5 L29.3 9.3 Z" fill="#FBBF24"/>
</svg>
