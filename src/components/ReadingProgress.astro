---
// ReadingProgress — 顶部阅读进度条（oil 同款细条 + 百分比，带 reduced-motion 降级）
// 样式见 src/styles/global.css
---

<div id="reading-progress" class="reading-progress" aria-hidden="true">
  <div id="reading-progress-bar" class="reading-progress-bar"></div>
  <span id="reading-progress-num" class="reading-progress-num font-mono">0%</span>
</div>

<script>
  (function () {
    var bar = document.getElementById("reading-progress-bar");
    var num = document.getElementById("reading-progress-num");
    if (!bar || !num) return;
    // 无障碍降级：reduced-motion 时隐藏百分比数字，只保留细条
    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) num.style.display = "none";

    var ticking = false;
    function update() {
      ticking = false;
      var doc = document.documentElement;
      var total = doc.scrollHeight - window.innerHeight;
      if (total <= 0) {
        bar.style.width = "0%";
        num.textContent = "0%";
        return;
      }
      var pct = Math.min(100, Math.max(0, (window.scrollY / total) * 100));
      bar.style.width = pct + "%";
      num.textContent = Math.round(pct) + "%";
    }

    function requestUpdate() {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(update);
      }
    }

    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate, { passive: true });
    update();

    // View Transitions 后重新计算
    document.addEventListener("astro:page-load", update);
  })();
</script>
