---
/**
 * AboutPage — 关于页主体（中英文共用）
 *
 * 设计语言：延续全站「星野极光 · 人文温暖」——
 *   - Hero：超大衬线渐变标题 + 遮罩上拉（lmask），与首页 Hero 呼应
 *   - 数据卡：磨砂玻璃（glass-card）+ 聚光 + 3D 倾斜 + 数字滚动（count-up）
 *   - 旅程：竖向时间线，圆点 + 连接线，章节卡片 hover 主题色
 *   - 自我介绍：全宽身份卡（头像 + 姓名 + 角色徽章 + 坐标 + 签名），已移除长篇正文
 *   - 专栏：复用首页 roll-card（玻璃卡 + spotlight + tilt + ghost-num）
 *   - CTA：联系动作卡，俏皮收尾
 *
 * 数据全部动态统计（文章/专栏/工具/书籍数量），随站内内容自动变化。
 */
import Breadcrumb from "./Breadcrumb.astro";
import ColumnIcon from "./ColumnIcon.astro";
import Icon from "./Icon.astro";
import { getCollection } from "astro:content";
import { SECTION_ORDER } from "../lib/sections";

// ---- 中文文案（本站不再提供英文版）----
const text = {
  aboutTitle: "关于",
  heroKicker: "ABOUT ME · 关于我",
  heroSubtitle: "从好奇，到创造",
  heroIntro: "这里是我的数字小窝——记录思考、折腾工具、分享成长，顺便把故事讲得有趣一点。",
  statsLabel: "这个窝里 · 攒下的一点家当",
  statsArticles: "篇文章",
  statsColumns: "个专栏",
  statsTools: "件效率工具",
  statsBooks: "本书",
  bioKicker: "HELLO · 自我介绍",
  bioTitleEn: "Hi,",
  bioTitleMid: "I am",
  bioTitleName: "Galvin!",
  bioRole: "终身学习者 · 数字经济从业者 · 工具折腾党",
  bioLocation: "坐标中国·南京",
  bioSignature: "把「终身学习」当主业，把「折腾」当副业。",
  galleryLabel: "精选文章",
  exploreColumns: "探索专栏",
  columnsDesc: "四个方向，构建个人知识体系",
  columnsName: {
    insights: "行业洞察",
    ai: "AI 学习",
    tips: "实用技巧",
    books: "阅读思考",
  },
  columnsEnName: {
    insights: "Industry Insights",
    ai: "AI Learning",
    tips: "Practical Tips",
    books: "Reading & Thinking",
  },
  columnsDesc2: {
    insights: "数字经济与产业观察，记录我在这个行业里的一点见闻和思考",
    ai: "AI 工具实测、学习路径与实战笔记，从入门到上手，一起慢慢摸索",
    tips: "效率工具、办公技巧与折腾心得，让技术为你所用",
    books: "书评与阅读笔记，经典好书支持在线阅读与下载",
  },
  goExplore: "去逛逛",
  ctaKicker: "SAY HELLO · 打个招呼",
  ctaTitle: "想认识一下？",
  ctaDesc: "不管是对文章有想法、想交流 AI，还是单纯想打个招呼，都欢迎来找我。",
  ctaEmail: "发封邮件",
  ctaX: "关注 X",
  ctaWechat: "加个微信",
  ctaFooter: "留言必回——除非消息太多，那就排着队慢慢回 😄",
};

const prefix = "";

// ---- 动态统计 ----
const allArticles = await getCollection("articles", ({ data }) => !data.draft && !data.hidden);
const bookCount = allArticles.filter((a) => a.data.author).length;
const articleCount = allArticles.length;
const columnCount = SECTION_ORDER.length;
const tools = await getCollection("tools", ({ data }) => !data.draft && !data.hidden);
const toolCount = tools.length;

const stats: Array<{ value: number; unit: string; icon: "fileText" | "listTree" | "toolbox" | "bookOpen" }> = [
  { value: articleCount, unit: text.statsArticles, icon: "fileText" },
  { value: columnCount, unit: text.statsColumns, icon: "listTree" },
  { value: toolCount, unit: text.statsTools, icon: "toolbox" },
  { value: bookCount, unit: text.statsBooks, icon: "bookOpen" },
];

const roles = text.bioRole.split("·").map((s) => s.trim()).filter(Boolean);
const email = "cgaojiacheng@gmail.com";
const xLink = "https://x.com/galvin0119";
const xHandle = "@galvin0119";
const wechatName = "Galvin 的成长笔记";

// ---- 精选文章（无图列表）----
// 精选文章（排除书籍），按发布日期倒序，以文字列表展示（文章不再生成配图，见 Issue #153）
const carouselArticles = allArticles
  .filter((a) => a.data.featured && a.data.section !== "books")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const articleTitle = (a: (typeof allArticles)[number]) => a.data.title;
---

<Breadcrumb crumbs={[{ label: text.aboutTitle, href: `${prefix}/about/` }]} class="mb-4" />

<section class="max-w-6xl 2xl:max-w-[1400px]">

  <!-- ============ Hero：超大衬线标题 + 遮罩上拉 ============ -->
  <header class="about-hero" data-reveal>
    <div class="about-hero-head">
      <span class="about-kicker" aria-hidden="true">{text.heroKicker}</span>
      <span class="about-kicker-bar" aria-hidden="true"></span>
    </div>

    <h1 class="about-hero-title lmask">
      <span class="lmask-inner" style="--lmask-delay:0.08s">{text.heroSubtitle}</span>
    </h1>

    <p class="about-hero-intro lmask">
      <span class="lmask-inner" style="--lmask-delay:0.22s">{text.heroIntro}</span>
    </p>

  </header>

  <!-- ============ 数据卡：磨砂玻璃 + 数字滚动 ============ -->
  <section class="about-stats" aria-label={text.statsLabel} data-reveal>
    <p class="about-stats-label">{text.statsLabel}</p>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3" data-reveal-stagger>
      {stats.map((s, i) => (
        <div
          class="about-stat-card glass-card"
          style={`--roll-index:${i}`}
          data-spotlight
          data-tilt
        >
          <span class="about-stat-icon" aria-hidden="true">
            <Icon name={s.icon} class="w-5 h-5" />
          </span>
          <p class="about-stat-value">
            <span data-count-up={s.value}>0</span>
            <span class="about-stat-unit">{s.unit}</span>
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ 自我介绍：全宽身份卡（左身份 + 右图片区 A+C） ============ -->
  <section class="about-bio" id="about-me" aria-label={text.bioTitle}>
    <div class="about-person-card glass-card relative overflow-hidden" data-reveal data-spotlight>
      <span class="about-person-glow" aria-hidden="true"></span>

      <div class="about-person-grid">
        <!-- 左：身份信息 -->
        <div class="about-person-main">
          <div class="about-person-avatar" aria-hidden="true">
            <Icon name="user" class="w-10 h-10" />
          </div>

          <div class="about-person-info">
            <p class="about-person-kicker">{text.bioKicker}</p>
            <h2 class="about-person-name">
              <span class="apn-en" aria-hidden="true">{text.bioTitleEn}</span>
              <span class="apn-en">{text.bioTitleMid}</span>
              <span class="apn-en">{text.bioTitleName}</span>
            </h2>

            <ul class="about-person-roles">
              {roles.map((r: string) => (
                <li class="about-person-role">{r}</li>
              ))}
            </ul>

            <p class="about-person-location">
              <span class="about-location-pin" aria-hidden="true">
                <Icon name="mapPin" class="w-3.5 h-3.5" />
              </span>
              {text.bioLocation}
            </p>

            <p class="about-person-signature">{text.bioSignature}</p>
          </div>
        </div>

        <!-- 右：精选文章（无图列表） -->
        <div class="about-person-media">
          {carouselArticles.length > 0 && (
            <div class="about-featured">
              <p class="about-media-label">{text.galleryLabel}</p>
              <ul class="about-featured-list">
                {carouselArticles.map((a) => (
                  <li class="about-featured-item">
                    <a href={`${prefix}/${a.data.section}/${a.id}`} class="about-featured-link group" data-spotlight data-tilt>
                      <span class="about-featured-section">{text.columnsName[a.data.section]}</span>
                      <span class="about-featured-title">{articleTitle(a)}</span>
                      <Icon name="arrowRight" class="about-featured-arrow" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 专栏导航 ============ -->
  <section class="about-columns" aria-label={text.exploreColumns} data-reveal>
    <div class="about-journey-head">
      <div class="about-journey-kicker">
        <span class="about-kicker">{text.exploreColumns}</span>
        <span class="about-kicker-bar" aria-hidden="true"></span>
      </div>
      <p class="about-columns-desc">{text.columnsDesc}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" data-reveal-stagger>
      {SECTION_ORDER.map((s, i) => (
        <a
          href={`${prefix}/${s}/`}
          class="roll-card group block p-5 rounded-xl border border-black/10 dark:border-white/10 hover-lift transition-all duration-300 hover:border-black/30 dark:hover:border-white/30 relative overflow-hidden"
          style={`--roll-index:${i}`}
          data-spotlight
          data-tilt
          data-c-accent={s}
        >
          <span class="ghost-num text-black/10 dark:text-white/20 select-none pointer-events-none" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <span class="mb-3 block opacity-80 dark:opacity-100 relative"><ColumnIcon section={s} class="w-8 h-8" /></span>
          <h3 class="font-bold text-base mb-1 hover-glow relative">
            {text.columnsName[s]}
          </h3>
          <p class="text-xs text-black/40 dark:text-white/40 mb-3 relative">
            {text.columnsEnName[s]}
          </p>
          <p class="text-sm text-black/50 dark:text-white/50 leading-relaxed mb-3 relative">
            {text.columnsDesc2[s]}
          </p>
          <span class="text-[13px] text-black/45 dark:text-white/60 font-mono relative inline-flex items-center gap-1">
            {text.goExplore}
            <Icon name="arrowRight" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ CTA：联系 ============ -->
  <section class="about-cta" aria-label={text.ctaTitle} data-reveal>
    <div class="about-cta-card glass-card relative overflow-hidden" data-spotlight>
      <span class="ghost-num text-black/10 dark:text-white/20" aria-hidden="true">HI</span>
      <p class="about-person-kicker">{text.ctaKicker}</p>
      <h2 class="about-cta-title">{text.ctaTitle}</h2>
      <p class="about-cta-desc">{text.ctaDesc}</p>

      <div class="about-cta-actions">
        <a href={`mailto:${email}`} class="about-cta-btn" data-tilt>
          <Icon name="mail" class="w-4 h-4" />
          {text.ctaEmail}
        </a>
        <a href={`https://x.com/${xHandle.replace(/^@/, "")}`} target="_blank" rel="noopener" class="about-cta-btn" data-tilt>
          <Icon name="radio" class="w-4 h-4" />
          {text.ctaX}
        </a>
        <span class="about-cta-btn about-cta-btn-static" title={wechatName} data-tilt>
          <Icon name="link" class="w-4 h-4" />
          {text.ctaWechat}
        </span>
      </div>

      <p class="about-cta-footer">{text.ctaFooter}</p>
    </div>
  </section>
</section>
