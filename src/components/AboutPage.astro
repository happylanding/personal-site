---
/**
 * AboutPage — 关于页主体（中英文共用）
 *
 * 设计语言：延续全站「星野极光 · 人文温暖」——
 *   - Hero：超大衬线渐变标题 + 遮罩上拉（lmask），与首页 Hero 呼应
 *   - 数据卡：磨砂玻璃（glass-card）+ 聚光 + 3D 倾斜 + 数字滚动（count-up）
 *   - 旅程：竖向时间线，圆点 + 连接线，章节卡片 hover 主题色
 *   - 自我介绍：全宽身份卡（头像 + 姓名 + 角色徽章 + 坐标 + 签名），已移除长篇正文
 *   - 专栏：复用首页 roll-card（玻璃卡 + spotlight + tilt + ghost-num）
 *   - CTA：联系动作卡，俏皮收尾
 *
 * 数据全部动态统计（文章/专栏/工具/公版书数量），随站内内容自动变化。
 */
import Breadcrumb from "./Breadcrumb.astro";
import ColumnIcon from "./ColumnIcon.astro";
import Icon from "./Icon.astro";
import { useTranslations } from "../i18n/utils";
import { getCollection } from "astro:content";
import { SECTION_ORDER } from "../lib/sections";

interface Props {
  lang: "zh" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === "en" ? "/en" : "";

// ---- 动态统计 ----
const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const bookCount = allArticles.filter((a) => a.data.author).length;
const articleCount = allArticles.length;
const columnCount = SECTION_ORDER.length;
const tools = await getCollection("tools", ({ data }) => !data.draft);
const toolCount = tools.length;

const stats: Array<{ value: number; unit: string; icon: "fileText" | "listTree" | "toolbox" | "bookOpen" }> = [
  { value: articleCount, unit: t("about.stats.articles"), icon: "fileText" },
  { value: columnCount, unit: t("about.stats.columns"), icon: "listTree" },
  { value: toolCount, unit: t("about.stats.tools"), icon: "toolbox" },
  { value: bookCount, unit: t("about.stats.books"), icon: "bookOpen" },
];

const journeyChapters = t("about.journey.chapters") as string[];
const roles = (t("about.bio.role") as string)
  .split("·")
  .map((s) => s.trim())
  .filter(Boolean);
const email = t("contact.emailValue");
const xLink = t("contact.xLink");
const xHandle = t("contact.xHandle");
const wechatName = t("contact.officialAccountName");

// ---- 图片区（单图轮播）----
// 轮播：精选文章（排除书籍），按发布日期倒序，单图左右自动切换
const carouselArticles = allArticles
  .filter((a) => a.data.featured && a.data.section !== "books")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const articleCover = (a: (typeof allArticles)[number]) =>
  (lang === "en" ? a.data.ogImageEn || a.data.ogImage : a.data.ogImage || "").replace(/\.png$/, ".webp");
const articleTitle = (a: (typeof allArticles)[number]) =>
  lang === "en" ? a.data.titleEn || a.data.title : a.data.title;
---

<Breadcrumb crumbs={[{ label: t("about.title"), href: `${prefix}/about/` }]} class="mb-4" />

<section class="max-w-6xl 2xl:max-w-[1400px]">

  <!-- ============ Hero：超大衬线标题 + 遮罩上拉 ============ -->
  <header class="about-hero" data-reveal>
    <div class="about-hero-head">
      <span class="about-kicker" aria-hidden="true">{t("about.hero.kicker")}</span>
      <span class="about-kicker-bar" aria-hidden="true"></span>
    </div>

    <h1 class="about-hero-title lmask">
      <span class="lmask-inner" style="--lmask-delay:0.08s">{t("about.hero.subtitle")}</span>
    </h1>

    <p class="about-hero-intro lmask">
      <span class="lmask-inner" style="--lmask-delay:0.22s">{t("about.hero.intro")}</span>
    </p>

    <a href="#about-journey" class="about-hero-cta group" aria-label={t("about.hero.cta")}>
      <span>{t("about.hero.cta")}</span>
      <Icon name="chevronDown" class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" />
    </a>
  </header>

  <!-- ============ 数据卡：磨砂玻璃 + 数字滚动 ============ -->
  <section class="about-stats" aria-label={t("about.stats.label")} data-reveal>
    <p class="about-stats-label">{t("about.stats.label")}</p>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3" data-reveal-stagger>
      {stats.map((s, i) => (
        <div
          class="about-stat-card glass-card"
          style={`--roll-index:${i}`}
          data-spotlight
          data-tilt
        >
          <span class="about-stat-icon" aria-hidden="true">
            <Icon name={s.icon} class="w-5 h-5" />
          </span>
          <p class="about-stat-value">
            <span data-count-up={s.value}>0</span>
            <span class="about-stat-unit">{s.unit}</span>
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ 自我介绍：全宽身份卡（左身份 + 右图片区 A+C） ============ -->
  <section class="about-bio" id="about-me" aria-label={t("about.bio.title")}>
    <div class="about-person-card glass-card relative overflow-hidden" data-reveal data-spotlight>
      <span class="about-person-glow" aria-hidden="true"></span>

      <div class="about-person-grid">
        <!-- 左：身份信息 -->
        <div class="about-person-main">
          <div class="about-person-avatar" aria-hidden="true">
            <Icon name="user" class="w-10 h-10" />
          </div>

          <div class="about-person-info">
            <p class="about-person-kicker">{t("about.bio.kicker")}</p>
            <h2 class="about-person-name">{t("about.bio.title")}</h2>

            <ul class="about-person-roles">
              {roles.map((r: string) => (
                <li class="about-person-role">{r}</li>
              ))}
            </ul>

            <p class="about-person-location">
              <span class="about-location-pin" aria-hidden="true">
                <Icon name="mapPin" class="w-3.5 h-3.5" />
              </span>
              {t("about.bio.location")}
            </p>

            <p class="about-person-signature">{t("about.bio.signature")}</p>
          </div>
        </div>

        <!-- 右：图片区（单图轮播） -->
        <div class="about-person-media">
          {carouselArticles.length > 0 && (
            <div class="about-carousel">
              <p class="about-media-label">{t("about.media.galleryLabel")}</p>
              <div class="about-carousel-viewport" data-about-carousel>
                <ul class="about-carousel-track">
                  {carouselArticles.map((a, i) => (
                    <li class="about-carousel-slide" aria-hidden={i === 0 ? "false" : "true"}>
                      <a
                        href={`${prefix}/${a.data.section}/${a.id}`}
                        class="about-carousel-item group"
                        data-spotlight
                        data-tilt
                      >
                        <img
                          src={articleCover(a)}
                          alt={articleTitle(a)}
                          loading={i === 0 ? "eager" : "lazy"}
                          decoding="async"
                        />
                        <span class="about-gallery-overlay">
                          <span class="about-gallery-section">{t(`columns.${a.data.section}.name`)}</span>
                          <span class="about-gallery-title">{articleTitle(a)}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>

                <button class="about-carousel-arrow about-carousel-prev" type="button" data-carousel-prev aria-label="Previous">
                  <Icon name="arrowLeft" class="w-4 h-4" />
                </button>
                <button class="about-carousel-arrow about-carousel-next" type="button" data-carousel-next aria-label="Next">
                  <Icon name="arrowRight" class="w-4 h-4" />
                </button>

                {carouselArticles.length > 1 && (
                  <div class="about-carousel-dots" role="tablist" aria-label="Slides">
                    {carouselArticles.map((_, i) => (
                      <button
                        class="about-carousel-dot"
                        type="button"
                        data-carousel-dot={i}
                        aria-label={`Go to slide ${i + 1}`}
                        aria-selected={i === 0 ? "true" : "false"}
                      ></button>
                    ))}
                  </div>
                )}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 旅程时间线 ============ -->
  <section class="about-journey" id="about-journey" aria-label={t("about.journey.title")}>
    <div class="about-journey-head" data-reveal>
      <div class="about-journey-kicker">
        <span class="about-kicker">{t("about.journey.kicker")}</span>
        <span class="about-kicker-bar" aria-hidden="true"></span>
      </div>
      <h2 class="about-journey-title">{t("about.journey.title")}</h2>
      <p class="about-journey-quote">{t("about.journey.quote")}</p>
    </div>

    <ol class="about-timeline" data-reveal-stagger>
      {journeyChapters.map((c: string) => (
        <li class="about-timeline-item" data-tilt>
          <span class="about-timeline-node" aria-hidden="true">
            <span class="about-timeline-dot"></span>
          </span>
          <div class="about-timeline-card glass-card">
            <p>{c}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============ 专栏导航 ============ -->
  <section class="about-columns" aria-label={t("home.exploreColumns")} data-reveal>
    <div class="about-journey-head">
      <div class="about-journey-kicker">
        <span class="about-kicker">{t("home.exploreColumns")}</span>
        <span class="about-kicker-bar" aria-hidden="true"></span>
      </div>
      <p class="about-columns-desc">{t("home.columnsDesc")}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" data-reveal-stagger>
      {SECTION_ORDER.map((s, i) => (
        <a
          href={`${prefix}/${s}/`}
          class="roll-card group block p-5 rounded-xl border border-black/10 dark:border-white/10 hover-lift transition-all duration-300 hover:border-black/30 dark:hover:border-white/30 relative overflow-hidden"
          style={`--roll-index:${i}`}
          data-spotlight
          data-tilt
          data-c-accent={s}
        >
          <span class="ghost-num text-black/5 dark:text-white/5 select-none pointer-events-none" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <span class="mb-3 block opacity-60 relative"><ColumnIcon section={s} class="w-8 h-8" /></span>
          <h3 class="font-bold text-base mb-1 group-hover:opacity-70 transition-opacity hover-glow relative">
            {t(`columns.${s}.name`)}
          </h3>
          <p class="text-xs text-black/40 dark:text-white/40 mb-3 relative">
            {t(`columns.${s}.enName`)}
          </p>
          <p class="text-sm text-black/50 dark:text-white/50 leading-relaxed mb-3 relative">
            {t(`columns.${s}.desc`)}
          </p>
          <span class="text-[13px] text-black/45 dark:text-white/60 font-mono relative inline-flex items-center gap-1">
            {lang === "en" ? "Explore" : "去逛逛"}
            <Icon name="arrowRight" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ CTA：联系 ============ -->
  <section class="about-cta" aria-label={t("about.cta.title")} data-reveal>
    <div class="about-cta-card glass-card relative overflow-hidden" data-spotlight>
      <span class="ghost-num text-black/5 dark:text-white/5" aria-hidden="true">HI</span>
      <p class="about-person-kicker">{t("about.cta.kicker")}</p>
      <h2 class="about-cta-title">{t("about.cta.title")}</h2>
      <p class="about-cta-desc">{t("about.cta.desc")}</p>

      <div class="about-cta-actions">
        <a href={`mailto:${email}`} class="about-cta-btn" data-tilt>
          <Icon name="mail" class="w-4 h-4" />
          {t("about.cta.email")}
        </a>
        <a href={`https://x.com/${xHandle.replace(/^@/, "")}`} target="_blank" rel="noopener" class="about-cta-btn" data-tilt>
          <Icon name="radio" class="w-4 h-4" />
          {t("about.cta.x")}
        </a>
        <span class="about-cta-btn about-cta-btn-static" title={wechatName} data-tilt>
          <Icon name="link" class="w-4 h-4" />
          {t("about.cta.wechat")}
        </span>
      </div>

      <p class="about-cta-footer">{t("about.cta.footer")}</p>
    </div>
  </section>
</section>

<script>
  /**
   * 精选文章单图轮播：左右自动切换 + 手动切图
   * - 自动播放：每 4.5s 切到下一张（无缝循环）
   * - 鼠标悬停暂停自动播放，离开继续
   * - 左右箭头手动切；底部圆点可直接跳转
   * - 尊重 prefers-reduced-motion（关闭自动播放，但仍可手动切换）
   */
  (function () {
    var viewport = document.querySelector("[data-about-carousel]");
    if (!viewport) return;

    var track = viewport.querySelector(".about-carousel-track");
    var slides = Array.prototype.slice.call(viewport.querySelectorAll(".about-carousel-slide"));
    if (!track || slides.length < 2) return;

    var index = 0;
    var timer = null;
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var interval = 4500;

    var dots = Array.prototype.slice.call(viewport.querySelectorAll("[data-carousel-dot]"));
    var prevBtn = viewport.querySelector("[data-carousel-prev]");
    var nextBtn = viewport.querySelector("[data-carousel-next]");

    function update(animate) {
      if (animate === false) {
        track.style.transition = "none";
      } else {
        track.style.transition = "";
      }
      track.style.transform = "translateX(-" + index * 100 + "%)";
      slides.forEach(function (s, i) {
        s.setAttribute("aria-hidden", i === index ? "false" : "true");
      });
      dots.forEach(function (d, i) {
        d.setAttribute("aria-selected", i === index ? "true" : "false");
        d.classList.toggle("is-active", i === index);
      });
      // 强制回流，确保 disable-transition 后位置立即生效
      if (animate === false) void track.offsetWidth;
    }

    function go(i) {
      var n = slides.length;
      index = ((i % n) + n) % n;
      update(true);
    }

    function start() {
      if (reduce) return;
      stop();
      timer = setInterval(function () {
        go(index + 1);
      }, interval);
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function restart() {
      stop();
      start();
    }

    if (prevBtn) prevBtn.addEventListener("click", function () { go(index - 1); restart(); });
    if (nextBtn) nextBtn.addEventListener("click", function () { go(index + 1); restart(); });
    dots.forEach(function (d, i) {
      d.addEventListener("click", function () { go(i); restart(); });
    });

    // 悬停暂停、离开继续
    viewport.addEventListener("mouseenter", stop);
    viewport.addEventListener("mouseleave", start);
    // 页面可见时才播放，切走标签页暂停
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) stop();
      else start();
    });

    update(false);
    start();
  })();
</script>
