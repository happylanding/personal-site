<!-- Scroll reveal: elements with data-reveal class fade/slide in on scroll
     此处仅保留「IntersectionObserver 驱动的入场动画」；
     Hero 视差 / 阅读进度 / 返回顶部等滚动逻辑已合并到 src/scripts/scroll-effects.js。 -->
<script>
  function initScrollReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      // 注意：不能用固定的 ratio threshold（如 0.1）——对超长页面（如长篇正文）
      // 10% 高度可能超过视口，永远无法触发，导致内容一直 opacity:0。
      // 改为 threshold: 0（任意可见即触发），对短元素和超长元素都可靠。
      { threshold: 0, rootMargin: window.innerWidth < 768 ? "0px 0px -10px 0px" : "0px 0px -40px 0px" }
    );

    document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));

    // 兜底：3s 后对「已进入视口但仍未 reveal」的元素强制显示，防止极端情况永久 opacity:0。
    // （视口外的元素不强制，保留滚动渐入效果）
    window.setTimeout(() => {
      const vh = window.innerHeight;
      document.querySelectorAll("[data-reveal]:not(.revealed)").forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.top < vh && r.bottom > 0) el.classList.add("revealed");
      });
    }, 3000);
  }

  // Stagger reveal（方案 A 升级）：容器进入视口时，子元素带交错延迟逐个弹性入场
  function initStaggerReveal() {
    const containers = document.querySelectorAll("[data-reveal-stagger]");
    if (!containers.length) return;

    const staggerObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const container = entry.target as HTMLElement;
          const children = Array.from(container.children) as HTMLElement[];
          // 先写入索引（供 CSS transition-delay 计算），下一帧再加 revealed 触发动画
          children.forEach((child, i) => child.style.setProperty("--reveal-index", String(i)));
          requestAnimationFrame(() => {
            children.forEach((child) => child.classList.add("revealed"));
          });
          staggerObserver.unobserve(container);
        });
      },
      // 容器出现 10% 即触发；超长容器用 threshold:0 配合底部 rootMargin 兜底
      { threshold: 0.05, rootMargin: window.innerWidth < 768 ? "0px 0px -8% 0px" : "0px 0px -15% 0px" }
    );

    containers.forEach((el) => staggerObserver.observe(el));
  }

  // Card 3D roll-in (oil 同款 card-roll-hitbox)
  function initRollCards() {
    const cards = document.querySelectorAll(".roll-card");
    if (!cards.length) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) {
      cards.forEach((c) => c.classList.add("roll-in"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target;
            // 交错延迟：基于 --roll-index，逐个翻入
            const idx = parseInt(el.style.getPropertyValue("--roll-index") || "0", 10) || 0;
            el.style.transitionDelay = `${idx * 0.08}s`;
            el.classList.add("roll-in");
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.15 }
    );

    cards.forEach((c) => observer.observe(c));
  }

  // Run on initial page load
  initScrollReveal();
  initStaggerReveal();
  initRollCards();

  // Re-run on Astro View Transition navigations
  document.addEventListener("astro:page-load", () => {
    initScrollReveal();
    initStaggerReveal();
    initRollCards();
  });
</script>
