---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  article: CollectionEntry<"articles">;
  lang?: string;
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { article } = Astro.props;

const displayTitle = lang === "en" ? (article.data.titleEn || article.data.title) : article.data.title;
const displayDesc = lang === "en" ? (article.data.descriptionEn || article.data.description) : article.data.description;
const displayTags = lang === "en" ? (article.data.tagsEn?.length ? article.data.tagsEn : article.data.tags) : article.data.tags;
const section = article.data.section;
const sectionPath = lang === "en" ? `/en/${section}/${article.id}` : `/${section}/${article.id}`;
const dateStr = article.data.date.toLocaleDateString(lang === "en" ? "en-US" : "zh-CN", {
  year: "numeric", month: "long", day: "numeric",
});
---

<article class="group cursor-pointer" data-reveal>
  <a href={sectionPath} class="block">
    <div
      class="flex flex-col gap-3 p-5 rounded-xl border border-transparent hover:border-black/10 dark:hover:border-white/10 hover-lift transition-all duration-300"
    >
      <div class="flex items-center gap-2">
        <span class="text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-black/50 dark:text-white/50 inline-flex items-center gap-1">
          <ColumnIcon section={section as "insights"|"tips"|"books"|"invest"} class="w-3 h-3" />
          {t(`columns.${section}.name`)}
        </span>
        {article.data.featured && (
          <span class="text-xs px-2 py-0.5 rounded-full bg-black dark:bg-white text-white dark:text-black">
            ★
          </span>
        )}
      </div>

      <h3 class="text-lg font-bold font-serif group-hover:opacity-70 transition-opacity leading-snug">
        {displayTitle}
      </h3>

      {displayDesc && (
        <p class="text-sm text-black/50 dark:text-white/50 line-clamp-2 leading-relaxed">{displayDesc}</p>
      )}

      <div class="flex items-center gap-3 mt-1">
        <time datetime={article.data.date.toISOString()} class="text-xs text-black/30 dark:text-white/30 font-mono">
          {dateStr}
        </time>
        {displayTags.slice(0, 3).map((tag: string) => (
          <span class="text-xs text-black/30 dark:text-white/30">#{tag}</span>
        ))}
      </div>
    </div>
  </a>
</article>
