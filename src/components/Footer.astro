---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEn = lang === "en";
const sitesHref = isEn ? "/en/sites/" : "/sites/";
const toolsHref = isEn ? "/en/tools/" : "/tools/";
---

<footer class="border-t border-black/10 dark:border-white/10 mt-20">
  <div class="mx-auto max-w-6xl px-6 py-8 text-center 2xl:max-w-[1400px]">
    <!-- 隐藏入口：收藏夹（低调的小书签图标，放在版权说明右侧同一行，仅供站主快速访问） -->
    <p class="inline-flex items-center justify-center gap-2 text-xs text-black/40 dark:text-white/40">
      &copy; {new Date().getFullYear()} {t("footer.rights")}
      <a
        href={sitesHref}
        id="sites-hidden-link"
        class="inline-flex items-center text-black/25 dark:text-white/25 hover:text-black/50 dark:hover:text-white/50 transition-colors"
        title="收藏夹"
        aria-label="收藏夹"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
        </svg>
        <span class="hidden">收藏夹</span>
      </a>
      <a
        href={toolsHref}
        id="tools-hidden-link"
        class="inline-flex items-center text-black/25 dark:text-white/25 hover:text-black/50 dark:hover:text-white/50 transition-colors"
        title="工具箱"
        aria-label="工具箱"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"/>
          <polyline points="8 6 2 12 8 18"/>
        </svg>
        <span class="hidden">工具箱</span>
      </a>
    </p>
  </div>
</footer>

<script>
  // 键盘快捷键：按 g 再按 s 跳转收藏夹；按 t 直达工具箱（低调入口，方便站主快速取用）
  (function () {
    var buffer = "";
    var timer = -1;
    var sitesLink = document.getElementById("sites-hidden-link");
    var toolsLink = document.getElementById("tools-hidden-link");

    document.addEventListener("keydown", function (e) {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.target && (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA" || e.target.isContentEditable)) return;

      var k = e.key.toLowerCase();

      // 单键 t → 工具箱
      if (k === "t" && toolsLink) {
        e.preventDefault();
        window.location.href = toolsLink.getAttribute("href");
        return;
      }

      if (k.length !== 1) return;
      buffer = (buffer + k).slice(-2);
      clearTimeout(timer);
      timer = setTimeout(function () {
        buffer = "";
      }, 800);

      if (buffer === "gs" && sitesLink) {
        e.preventDefault();
        window.location.href = sitesLink.getAttribute("href");
      }
    });
  })();
</script>
