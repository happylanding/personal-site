---
/* Galvin design reminder: reading progress is an understated editorial signal.
   It measures the article body, not the whole document or decorative page chrome. */
---

<div class="galvin-article-progress" id="article-reading-progress" role="progressbar" aria-label="文章阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
  <span class="galvin-article-progress__label">READING</span>
  <span class="galvin-article-progress__track" aria-hidden="true"><i id="article-reading-progress-bar"></i></span>
  <span class="galvin-article-progress__value" id="article-reading-progress-value">0%</span>
</div>

<script>
  (function () {
    var progress: HTMLElement | null = null;
    var bar: HTMLElement | null = null;
    var value: HTMLElement | null = null;
    var content: HTMLElement | null = null;
    var ticking = false;

    function query() {
      progress = document.getElementById("article-reading-progress");
      bar = document.getElementById("article-reading-progress-bar");
      value = document.getElementById("article-reading-progress-value");
      content = document.querySelector(".galvin-article-content");
    }

    function sync() {
      ticking = false;
      if (!progress || !bar || !value || !content) return;

      var rect = content.getBoundingClientRect();
      var contentTop = window.scrollY + rect.top;
      var contentHeight = content.offsetHeight;
      var start = contentTop - window.innerHeight * 0.2;
      var end = contentTop + contentHeight - window.innerHeight * 0.55;
      var total = Math.max(1, end - start);
      var percent = Math.round(Math.min(100, Math.max(0, ((window.scrollY - start) / total) * 100)));

      progress.setAttribute("aria-valuenow", String(percent));
      bar.style.width = percent + "%";
      value.textContent = percent + "%";
    }

    function requestSync() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sync);
    }

    function init() {
      query();
      sync();
    }

    window.addEventListener("scroll", requestSync, { passive: true });
    window.addEventListener("resize", requestSync, { passive: true });
    document.addEventListener("astro:page-load", init);
    init();
  })();
</script>
