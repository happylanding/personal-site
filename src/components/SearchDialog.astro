---
/* Galvin design reminder: search is an operational deep-blue command panel.
   Keep the panel sober and useful: violet for the active result, cyan for load status, no decorative gradients. */
import Icon from "./Icon.astro";
---

<button id="search-trigger-desktop" class="galvin-search-trigger galvin-search-trigger--desktop" type="button" aria-label="打开全站搜索">
  <Icon name="search" class="w-4 h-4" />
  <span>搜索内容</span><kbd>⌘ K</kbd>
</button>
<button id="search-trigger-mobile" class="galvin-search-trigger galvin-search-trigger--mobile" type="button" aria-label="打开全站搜索">
  <Icon name="search" class="w-[18px] h-[18px]" />
</button>

<div id="search-overlay" class="galvin-search-overlay" aria-hidden="true">
  <button id="search-backdrop" class="galvin-search-overlay__backdrop" type="button" tabindex="-1" aria-label="关闭搜索"></button>
  <section id="search-panel" class="galvin-search-panel" role="dialog" aria-modal="true" aria-label="全站搜索">
    <div class="galvin-search-panel__input-wrap">
      <Icon name="search" class="w-[18px] h-[18px]" />
      <input id="search-input" type="search" autocomplete="off" placeholder="搜索文章、工具、藏页与书架" enterkeyhint="search" />
      <kbd class="galvin-search-panel__esc">ESC</kbd>
      <button id="search-close-btn" type="button" aria-label="关闭搜索"><Icon name="close" class="w-4 h-4" /></button>
    </div>
    <div id="search-results" class="galvin-search-results">
      <div id="search-loading" class="galvin-search-state" hidden>正在加载内容索引…</div>
      <div id="search-idle" class="galvin-search-idle"></div>
      <div id="search-tabs" class="galvin-search-tabs" hidden></div>
      <div id="search-results-list" class="galvin-search-results__list"></div>
      <div id="search-empty" class="galvin-search-state" hidden>没有找到相关内容，换一个词试试。</div>
    </div>
    <footer class="galvin-search-panel__footer">
      <span id="search-count">等待检索</span>
      <span><kbd>↑↓</kbd> 选择 <kbd>↵</kbd> 打开</span>
    </footer>
  </section>
</div>

<style is:global>
  .galvin-search-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 38px;
    border: 1px solid var(--galvin-line);
    color: var(--galvin-text-secondary);
    background: rgba(17, 25, 43, 0.58);
    font: 11px var(--galvin-font-utility);
    transition: color 180ms var(--galvin-ease-out), border-color 180ms var(--galvin-ease-out), background-color 180ms var(--galvin-ease-out), transform 120ms var(--galvin-ease-out);
  }
  .galvin-search-trigger:hover { border-color: rgba(155, 140, 255, 0.7); color: var(--galvin-text-primary); background: rgba(155, 140, 255, 0.09); }
  .galvin-search-trigger:active { transform: scale(0.97); }
  .galvin-search-trigger--desktop { min-width: 146px; padding: 0 9px 0 12px; }
  .galvin-search-trigger--desktop kbd { margin-left: auto; padding: 3px 5px; border: 1px solid var(--galvin-line-subtle); color: var(--galvin-text-tertiary); background: var(--galvin-canvas-elevated); font: inherit; }
  .galvin-search-trigger--mobile { display: none; width: 38px; }

  .galvin-search-overlay { position: fixed; inset: 0; z-index: 100; display: grid; place-items: start center; padding: max(70px, 11vh) 20px 20px; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 190ms var(--galvin-ease-out), visibility 0s linear 190ms; }
  .galvin-search-overlay.is-open { opacity: 1; visibility: visible; pointer-events: auto; transition-delay: 0s; }
  .galvin-search-overlay__backdrop { position: absolute; inset: 0; border: 0; background: rgba(1, 4, 10, 0.72); backdrop-filter: blur(7px); }
  .galvin-search-panel { position: relative; width: min(760px, 100%); overflow: hidden; border: 1px solid rgba(88, 107, 155, 0.7); background: #0d1424; box-shadow: 0 28px 100px rgba(0, 0, 0, 0.6), inset 0 1px rgba(255, 255, 255, 0.06); transform: translateY(10px) scale(0.98); transition: transform 220ms var(--galvin-ease-out); }
  .galvin-search-overlay.is-open .galvin-search-panel { transform: translateY(0) scale(1); }
  .galvin-search-panel__input-wrap { display: flex; align-items: center; gap: 12px; min-height: 66px; padding: 0 16px; border-bottom: 1px solid var(--galvin-line); color: var(--galvin-signal-violet); }
  .galvin-search-panel__input-wrap input { min-width: 0; flex: 1; border: 0; outline: 0; color: var(--galvin-text-primary); background: transparent; font: 16px var(--galvin-font-body); }
  .galvin-search-panel__input-wrap input::placeholder { color: var(--galvin-text-tertiary); }
  .galvin-search-panel__input-wrap button { display: grid; width: 30px; height: 30px; place-items: center; border: 1px solid transparent; color: var(--galvin-text-tertiary); background: transparent; transition: color 180ms var(--galvin-ease-out), border-color 180ms var(--galvin-ease-out); }
  .galvin-search-panel__input-wrap button:hover { border-color: var(--galvin-line); color: var(--galvin-text-primary); }
  .galvin-search-panel__esc, .galvin-search-panel__footer kbd { color: var(--galvin-text-tertiary); font: 10px var(--galvin-font-utility); }
  .galvin-search-panel__esc { padding: 4px 5px; border: 1px solid var(--galvin-line-subtle); background: var(--galvin-canvas-elevated); }
  .galvin-search-results { max-height: min(570px, 65dvh); overflow-y: auto; }
  .galvin-search-state { padding: 48px 20px; color: var(--galvin-text-tertiary); text-align: center; font-size: 13px; }
  .galvin-search-idle { padding: 18px; }
  .galvin-search-idle__label { margin: 0 0 10px; color: var(--galvin-text-tertiary); font: 10px var(--galvin-font-utility); letter-spacing: 0.1em; }
  .galvin-search-idle__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .galvin-search-idle__chip { display: inline-flex; align-items: center; gap: 8px; min-height: 31px; padding: 0 9px; border: 1px solid var(--galvin-line); color: var(--galvin-text-secondary); background: rgba(17, 25, 43, 0.46); font-size: 12px; text-decoration: none; transition: border-color 180ms var(--galvin-ease-out), color 180ms var(--galvin-ease-out); }
  .galvin-search-idle__chip:hover { border-color: rgba(155, 140, 255, 0.7); color: var(--galvin-text-primary); }
  .galvin-search-idle__chip small { color: var(--galvin-signal-cyan); font: 10px var(--galvin-font-utility); }
  .galvin-search-tabs { display: flex; gap: 7px; overflow-x: auto; padding: 12px 16px; border-bottom: 1px solid var(--galvin-line-subtle); scrollbar-width: none; }
  .galvin-search-tabs::-webkit-scrollbar { display: none; }
  .galvin-search-tab { flex: 0 0 auto; min-height: 29px; padding: 0 9px; border: 1px solid var(--galvin-line); color: var(--galvin-text-secondary); background: transparent; font: 11px var(--galvin-font-body); }
  .galvin-search-tab.is-active { border-color: rgba(155, 140, 255, 0.8); color: #070b14; background: var(--galvin-signal-violet); }
  .galvin-search-tab small { margin-left: 5px; font: 10px var(--galvin-font-utility); opacity: 0.7; }
  .galvin-search-result { display: grid; grid-template-columns: 38px minmax(0, 1fr) auto; gap: 13px; align-items: start; padding: 15px 18px; border-bottom: 1px solid var(--galvin-line-subtle); color: var(--galvin-text-primary); text-decoration: none; transition: background-color 160ms var(--galvin-ease-out); }
  .galvin-search-result:hover, .galvin-search-result.is-active { background: rgba(24, 34, 58, 0.82); }
  .galvin-search-result__kind { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid rgba(155, 140, 255, 0.4); color: var(--galvin-signal-violet); background: rgba(155, 140, 255, 0.08); font: 10px var(--galvin-font-utility); }
  .galvin-search-result h3 { margin: 0; color: var(--galvin-text-primary); font-size: 15px; font-weight: 600; line-height: 1.45; }
  .galvin-search-result h3 mark, .galvin-search-result p mark { padding: 0 1px; color: var(--galvin-text-primary); background: rgba(155, 140, 255, 0.35); }
  .galvin-search-result p { display: -webkit-box; margin: 5px 0 0; overflow: hidden; color: var(--galvin-text-secondary); font-size: 12px; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .galvin-search-result__meta { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 7px; color: var(--galvin-text-tertiary); font: 10px var(--galvin-font-utility); }
  .galvin-search-result__arrow { padding-top: 8px; color: var(--galvin-signal-violet); font: 16px var(--galvin-font-utility); }
  .galvin-search-panel__footer { display: flex; justify-content: space-between; gap: 16px; padding: 10px 16px; border-top: 1px solid var(--galvin-line); color: var(--galvin-text-tertiary); font: 10px var(--galvin-font-utility); }
  .galvin-search-panel__footer span:last-child { display: flex; align-items: center; gap: 5px; }
  .galvin-search-panel__footer kbd { padding: 2px 3px; border: 1px solid var(--galvin-line-subtle); }
  .galvin-search-open { overflow: hidden; }
  @media (max-width: 920px) { .galvin-search-trigger--desktop { display: none; } .galvin-search-trigger--mobile { display: inline-flex; } }
  @media (max-width: 640px) { .galvin-search-overlay { padding: max(16px, env(safe-area-inset-top)) 12px 12px; align-items: start; } .galvin-search-panel { margin-top: 0; } .galvin-search-results { max-height: calc(100dvh - 112px); } .galvin-search-panel__footer span:last-child { display: none; } .galvin-search-result { grid-template-columns: 32px minmax(0, 1fr); padding: 14px; } .galvin-search-result__kind { width: 30px; height: 30px; } .galvin-search-result__arrow { display: none; } }
  @media (prefers-reduced-motion: reduce) { .galvin-search-overlay, .galvin-search-panel, .galvin-search-trigger, .galvin-search-result { transition: none; } }
</style>

<script>
  (() => {
    const triggerDesktop = document.getElementById("search-trigger-desktop");
    const triggerMobile = document.getElementById("search-trigger-mobile");
    const overlay = document.getElementById("search-overlay");
    const backdrop = document.getElementById("search-backdrop");
    const panel = document.getElementById("search-panel");
    const input = document.getElementById("search-input") as HTMLInputElement | null;
    const closeButton = document.getElementById("search-close-btn");
    const loading = document.getElementById("search-loading");
    const idle = document.getElementById("search-idle");
    const tabs = document.getElementById("search-tabs");
    const results = document.getElementById("search-results-list");
    const empty = document.getElementById("search-empty");
    const count = document.getElementById("search-count");
    if (!triggerDesktop || !triggerMobile || !overlay || !panel || !input || !loading || !idle || !tabs || !results || !empty || !count) return;

    type SearchItem = { title: string; excerpt: string; tags: string; tagsArr: string[]; category: string; section: string; date: string; href: string; };
    const sectionMeta: Record<string, { label: string; href: string; short: string; order: number }> = {
      now: { label: "此刻", href: "/", short: "此", order: 0 },
      making: { label: "造物", href: "/tools/", short: "造", order: 1 },
      question: { label: "叩问", href: "/archive/", short: "问", order: 2 },
      journey: { label: "行迹", href: "/", short: "行", order: 3 },
      archive: { label: "藏页", href: "/sites/", short: "藏", order: 4 },
      shelf: { label: "书架", href: "/books/", short: "书", order: 5 },
      about: { label: "关于", href: "/about/", short: "关", order: 6 },
    };
    let index: SearchItem[] | null = null;
    let activeGroup: string | null = null;
    let activeIndex = -1;
    let open = false;
    let timer = 0;

    const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" }[char] || char));
    const normalize = (value: string) => value.toLowerCase().trim();
    const highlight = (value: string, query: string) => {
      const safe = escapeHtml(value);
      const term = query.trim().replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      return term ? safe.replace(new RegExp(`(${term})`, "gi"), "<mark>$1</mark>") : safe;
    };
    const matches = (item: SearchItem, query: string) => {
      const needle = normalize(query);
      const haystack = normalize([item.title, item.excerpt, item.tags, item.category].join(" "));
      return needle.split(/\s+/).filter(Boolean).every((word) => haystack.includes(word));
    };
    const sorted = (items: SearchItem[]) => [...items].sort((a, b) => (sectionMeta[a.section]?.order ?? 99) - (sectionMeta[b.section]?.order ?? 99) || a.title.localeCompare(b.title, "zh-CN"));

    const loadIndex = async () => {
      if (index) return index;
      const response = await fetch("/search-index.json");
      if (!response.ok) throw new Error(`search-index:${response.status}`);
      const data = await response.json();
      index = Array.isArray(data) ? data : [];
      return index;
    };

    const renderIdle = () => {
      if (!index) return;
      const counts = index.reduce<Record<string, number>>((acc, item) => {
        acc[item.section] = (acc[item.section] || 0) + 1;
        return acc;
      }, {});
      const chips = Object.entries(sectionMeta)
        .filter(([section]) => counts[section])
        .sort(([a], [b]) => sectionMeta[a].order - sectionMeta[b].order)
        .map(([section, meta]) => `<a class="galvin-search-idle__chip" href="${meta.href}">${meta.label}<small>${String(counts[section]).padStart(2, "0")}</small></a>`)
        .join("");
      idle.innerHTML = `<p class="galvin-search-idle__label">浏览内容工作区</p><div class="galvin-search-idle__chips">${chips}</div>`;
      count.textContent = `已索引 ${index.length} 项内容`;
    };

    const groupResults = (items: SearchItem[]) => items.reduce<Record<string, SearchItem[]>>((acc, item) => {
      (acc[item.category] ||= []).push(item);
      return acc;
    }, {});

    const renderTabs = (groups: Record<string, SearchItem[]>, total: number) => {
      const labels = Object.keys(groups).sort((a, b) => {
        const firstA = groups[a][0]; const firstB = groups[b][0];
        return (sectionMeta[firstA.section]?.order ?? 99) - (sectionMeta[firstB.section]?.order ?? 99);
      });
      tabs.innerHTML = `<button class="galvin-search-tab ${activeGroup === null ? "is-active" : ""}" type="button" data-search-group="">全部<small>${total}</small></button>` + labels.map((label) => `<button class="galvin-search-tab ${activeGroup === label ? "is-active" : ""}" type="button" data-search-group="${escapeHtml(label)}">${escapeHtml(label)}<small>${groups[label].length}</small></button>`).join("");
      tabs.hidden = false;
    };

    const renderResults = (items: SearchItem[], query: string) => {
      const filtered = activeGroup ? items.filter((item) => item.category === activeGroup) : items;
      activeIndex = -1;
      if (!filtered.length) {
        results.innerHTML = "";
        empty.hidden = false;
        return;
      }
      empty.hidden = true;
      results.innerHTML = sorted(filtered).map((item) => {
        const meta = sectionMeta[item.section] || { short: "内" };
        const tags = item.tagsArr.slice(0, 3).map((tag) => `#${escapeHtml(tag)}`).join(" ");
        return `<a class="galvin-search-result" href="${escapeHtml(item.href)}"><span class="galvin-search-result__kind">${meta.short}</span><span><h3>${highlight(item.title, query)}</h3>${item.excerpt ? `<p>${highlight(item.excerpt, query)}</p>` : ""}<span class="galvin-search-result__meta"><span>${escapeHtml(item.category)}</span>${item.date ? `<span>${escapeHtml(item.date)}</span>` : ""}${tags ? `<span>${tags}</span>` : ""}</span></span><span class="galvin-search-result__arrow">↗</span></a>`;
      }).join("");
    };

    const search = () => {
      if (!index) return;
      const query = input.value.trim();
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (!query) {
          activeGroup = null;
          tabs.hidden = true;
          results.innerHTML = "";
          empty.hidden = true;
          idle.hidden = false;
          renderIdle();
          return;
        }
        idle.hidden = true;
        const matched = index!.filter((item) => matches(item, query));
        const groups = groupResults(matched);
        renderTabs(groups, matched.length);
        renderResults(matched, query);
        count.textContent = `命中 ${matched.length} / ${index!.length} 项内容`;
      }, 80);
    };

    const openSearch = async () => {
      if (open) return;
      open = true;
      overlay.classList.add("is-open");
      overlay.setAttribute("aria-hidden", "false");
      document.documentElement.classList.add("galvin-search-open");
      input.value = "";
      results.innerHTML = "";
      tabs.hidden = true;
      empty.hidden = true;
      idle.hidden = true;
      loading.hidden = false;
      input.focus();
      try {
        await loadIndex();
        if (!open) return;
        loading.hidden = true;
        idle.hidden = false;
        renderIdle();
        if (input.value.trim()) search();
      } catch {
        loading.hidden = true;
        empty.textContent = "内容索引暂时不可用，请稍后再试。";
        empty.hidden = false;
      }
    };

    const closeSearch = () => {
      if (!open) return;
      open = false;
      overlay.classList.remove("is-open");
      overlay.setAttribute("aria-hidden", "true");
      document.documentElement.classList.remove("galvin-search-open");
      activeGroup = null;
      activeIndex = -1;
    };

    triggerDesktop.addEventListener("click", openSearch);
    triggerMobile.addEventListener("click", openSearch);
    backdrop?.addEventListener("click", closeSearch);
    closeButton?.addEventListener("click", closeSearch);
    input.addEventListener("input", search);
    tabs.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-search-group]");
      if (!target || !index) return;
      activeGroup = target.dataset.searchGroup || null;
      search();
    });
    results.addEventListener("click", closeSearch);
    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        openSearch();
        return;
      }
      if (!open) return;
      if (event.key === "Escape") { event.preventDefault(); closeSearch(); return; }
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp" && event.key !== "Enter") return;
      const cards = Array.from(results.querySelectorAll<HTMLAnchorElement>(".galvin-search-result"));
      if (!cards.length) return;
      if (event.key === "Enter" && activeIndex >= 0) { event.preventDefault(); cards[activeIndex].click(); return; }
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        activeIndex = event.key === "ArrowDown" ? Math.min(activeIndex + 1, cards.length - 1) : Math.max(activeIndex - 1, 0);
        cards.forEach((card, cardIndex) => card.classList.toggle("is-active", cardIndex === activeIndex));
        cards[activeIndex].scrollIntoView({ block: "nearest" });
      }
    });
    document.addEventListener("astro:after-swap", closeSearch);
  })();
</script>
