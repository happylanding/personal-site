---
import Icon from "./Icon.astro";
---

<!-- Back to top button (effect H)；滚动显隐逻辑已合并到 src/scripts/scroll-effects.js -->

<button
  id="back-to-top"
  class="fixed bottom-[max(2rem,calc(env(safe-area-inset-bottom,0px)+1.5rem))] right-8 z-40 w-11 h-11 md:w-10 md:h-10 rounded-full bg-black dark:bg-white text-white dark:text-black shadow-lg opacity-0 invisible transition-all duration-300 hover:scale-110 flex items-center justify-center"
  aria-label="Back to top"
>
  <Icon name="arrowUp" class="w-5 h-5" />
</button>
