---
/* Galvin design reminder: navigation is a quiet index for seven Chinese sections.
   Use low-contrast structure, one violet active signal, and a full-height mobile index without card clutter. */
import GalvinMark from "./GalvinMark.astro";
import Icon from "./Icon.astro";
import SearchDialog from "./SearchDialog.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { GALVIN_NAVIGATION } from "../lib/galvin-navigation";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="galvin-header">
  <nav class="galvin-header__inner" aria-label="主导航">
    <a class="galvin-brand" href="/" aria-label="Galvin 首页">
      <GalvinMark />
      <span class="galvin-brand__wordmark">Galvin</span>
    </a>

    <div class="galvin-nav" aria-label="栏目">
      {GALVIN_NAVIGATION.map((item) => (
        <a
          class:list={["galvin-nav__link", { "is-active": isActive(item.href) }]}
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          <span class="galvin-nav__index">{item.index}</span>
          <span>{item.label}</span>
        </a>
      ))}
    </div>

    <div class="galvin-header__controls">
      <SearchDialog />
      <ThemeToggle />
      <button
        id="galvin-menu-toggle"
        class="galvin-menu-toggle"
        aria-label="打开栏目导航"
        aria-expanded="false"
        aria-controls="galvin-mobile-menu"
      >
        <Icon name="menu" class="w-[19px] h-[19px]" />
      </button>
    </div>
  </nav>

  <div id="galvin-mobile-menu" class="galvin-mobile-menu" aria-hidden="true">
    <div class="galvin-mobile-menu__inner">
      <p class="galvin-mobile-menu__eyebrow">INDEX / 07</p>
      <div class="galvin-mobile-menu__links">
        {GALVIN_NAVIGATION.map((item) => (
          <a class="galvin-mobile-menu__link" href={item.href}>
            <span class="galvin-mobile-menu__index">{item.index}</span>
            <span>{item.label}</span>
            <Icon name="arrowRight" class="w-4 h-4" />
          </a>
        ))}
      </div>
      <p class="galvin-mobile-menu__note">把好奇心，做成一点有用的东西。</p>
    </div>
  </div>
</header>

<script>
  (function () {
    const toggle = document.getElementById("galvin-menu-toggle");
    const menu = document.getElementById("galvin-mobile-menu");
    const root = document.documentElement;
    const openClass = "galvin-menu-open";

    if (!toggle || !menu) return;

    const close = () => {
      root.classList.remove(openClass);
      toggle.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-hidden", "true");
      toggle.setAttribute("aria-label", "打开栏目导航");
    };

    const open = () => {
      root.classList.add(openClass);
      toggle.setAttribute("aria-expanded", "true");
      menu.setAttribute("aria-hidden", "false");
      toggle.setAttribute("aria-label", "关闭栏目导航");
    };

    toggle.addEventListener("click", () => {
      root.classList.contains(openClass) ? close() : open();
    });

    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) close();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });

    document.addEventListener("astro:after-swap", close);
  })();
</script>
