---
// ArticleTOC v2 — 文章目录
// 单个组件根节点内同时包含：
//   - 桌面（≥lg）：左侧 sticky 侧栏，随滚动高亮当前章节
//   - 移动端 / 平板：文章顶部可折叠目录卡片（默认收起）
// 两个变体通过 responsive class 切换显隐，页面只需渲染一份，避免重复 DOM id。
//
// 样式全部放在全局作用域（src/styles/global.css）：
// 目录项由 JS 动态创建，Astro 的 data-astro-cid 作用域属性不会打到动态节点，
// 放在组件 scoped <style> 里会导致样式失效（旧版 bug）。
//
// Props:
//   @param {string} [label] - 目录标题文案（默认「目录」），中英文由页面传入

interface Props {
  label?: string;
  /** 计数格式，{count} 会被替换为标题数，如 "{count} 节" / "{count} items" */
  countFormat?: string;
}

const { label = "目录", countFormat = "{count} 节" } = Astro.props;
---

<div class="article-toc-root">
  <!-- 桌面端：左侧 sticky 目录栏（lg+ 显示；标题数 >= 2 时显示，JS 控制 .toc-hide） -->
  <nav id="article-toc-rail" class="article-toc-rail" aria-label={label}>
    <p class="article-toc-rail-label">
      <svg class="article-toc-list-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      {label}
    </p>
    <ul id="article-toc-rail-list" class="article-toc-list"></ul>
  </nav>

  <!-- 移动端 / 平板：文章内可折叠目录卡片（<lg 显示；JS 在标题数不足 2 时加 hidden 隐藏） -->
  <div id="article-toc-mobile" class="article-toc-mobile lg:hidden">
    <button id="article-toc-toggle" class="article-toc-toggle" type="button" aria-expanded="false" aria-controls="article-toc-mobile-body">
      <svg class="article-toc-toggle-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <span class="article-toc-label">{label}</span>
      <span id="article-toc-count" class="article-toc-count hidden" data-count-format={countFormat}></span>
      <svg class="article-toc-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
    <div id="article-toc-mobile-body" class="article-toc-mobile-body hidden">
      <ul id="article-toc-mobile-list" class="article-toc-list"></ul>
    </div>
  </div>
</div>

<script>
  (function () {
    function initArticleTOC() {
      var rail = document.getElementById("article-toc-rail");
      var railList = document.getElementById("article-toc-rail-list");
      var mobile = document.getElementById("article-toc-mobile");
      var mobileList = document.getElementById("article-toc-mobile-list");
      var mobileBody = document.getElementById("article-toc-mobile-body");
      var countEl = document.getElementById("article-toc-count");
      var toggle = document.getElementById("article-toc-toggle");

      var article = document.querySelector(".article-content");
      if (!article || !rail || !railList || !mobile || !mobileList) return;

      // 无目录时把外层 .article-grid 退回单栏，避免左侧空出一列
      var grid = document.getElementById("article-grid");

      var headings = Array.prototype.slice.call(article.querySelectorAll("h2, h3"));

      // 目录项太少时不展示
      if (headings.length < 2) {
        rail.classList.add("toc-hide");
        mobile.classList.add("hidden");
        if (grid) grid.classList.add("no-toc");
        return;
      } else if (grid) {
        grid.classList.remove("no-toc");
      }

      // 为标题生成稳定锚点 id
      var slugify = function (text) {
        return (
          text
            .toLowerCase()
            .replace(/[^\w\u4e00-\u9fa5]+/g, "-")
            .replace(/^-+|-+$/g, "") || "section"
        );
      };

      var items = [];
      headings.forEach(function (h, i) {
        var id = h.id || slugify(h.textContent || "") + "-" + i;
        h.id = id;
        items.push({
          id: id,
          text: (h.textContent || "").trim(),
          level: h.tagName === "H2" ? 2 : 3,
        });
      });

      function buildList(container) {
        container.innerHTML = "";
        items.forEach(function (item) {
          var li = document.createElement("li");
          li.className = "article-toc-item level-" + item.level;
          var a = document.createElement("a");
          a.href = "#" + item.id;
          a.textContent = item.text;
          a.className = "article-toc-link";
          a.dataset.tocId = item.id;
          li.appendChild(a);
          container.appendChild(li);
        });
      }

      buildList(railList);
      buildList(mobileList);

      rail.classList.remove("hidden");
      mobile.classList.remove("hidden");

      // 移动端：显示标题计数
      if (countEl) {
        var fmt = countEl.getAttribute("data-count-format") || "{count}";
        countEl.textContent = fmt.replace("{count}", String(items.length));
        countEl.classList.remove("hidden");
      }

      // 移动端：折叠 / 展开
      if (toggle) {
        // 直接赋值，避免重复绑定导致多次 toggle
        toggle.onclick = function () {
          var open = mobile.classList.toggle("open");
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
          if (mobileBody) mobileBody.classList.toggle("hidden", !open);
        };
      }

      // 滚动高亮当前章节（桌面 + 移动端共用）
      var links = Array.prototype.slice.call(railList.querySelectorAll(".article-toc-link"));
      var mobileLinks = Array.prototype.slice.call(mobileList.querySelectorAll(".article-toc-link"));

      function setActive(activeId) {
        links.forEach(function (l) {
          l.classList.toggle("active", l.dataset.tocId === activeId);
        });
        mobileLinks.forEach(function (l) {
          l.classList.toggle("active", l.dataset.tocId === activeId);
        });
      }

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              setActive(entry.target.id);
            }
          });
        },
        { rootMargin: "-80px 0px -70% 0px", threshold: 0 }
      );
      headings.forEach(function (h) {
        observer.observe(h);
      });

      // 清理旧 observer（view transition 时旧 DOM 被替换，但以防万一）
      if (initArticleTOC._observer) {
        initArticleTOC._observer.disconnect();
      }
      initArticleTOC._observer = observer;
    }

    // 事件委托：点击目录链接平滑滚动到目标（兼容动态创建的节点）
    // 移动端点击后自动收起目录卡片
    document.addEventListener("click", function (e) {
      var t = e.target;
      if (!t || !t.classList || !t.classList.contains("article-toc-link")) return;
      var id = t.dataset.tocId;
      if (!id) return;
      var target = document.getElementById(id);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        history.replaceState(null, "", "#" + id);
        // 移动端：点击后收起目录卡片
        var mobile = document.getElementById("article-toc-mobile");
        var toggle = document.getElementById("article-toc-toggle");
        var mobileBody = document.getElementById("article-toc-mobile-body");
        if (mobile && mobile.classList.contains("open")) {
          mobile.classList.remove("open");
          if (toggle) toggle.setAttribute("aria-expanded", "false");
          if (mobileBody) mobileBody.classList.add("hidden");
        }
      }
    });

    initArticleTOC();

    // Astro View Transition 导航后重新初始化（旧 DOM 被替换）
    document.addEventListener("astro:page-load", function () {
      setTimeout(initArticleTOC, 0);
    });
  })();
</script>
