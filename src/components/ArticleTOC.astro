---
/* Galvin design reminder: desktop uses a quiet sticky index; compact screens use a
   reading-location dock that reveals a short-lived, accessible chapter chooser. */
import Icon from "./Icon.astro";

interface Props {
  label?: string;
  countFormat?: string;
}

const { label = "目录", countFormat = "{count} 节" } = Astro.props;
---

<div class="article-toc-root">
  <nav id="article-toc-rail" class="article-toc-rail" aria-label={label}>
    <p class="article-toc-rail-label"><Icon name="list" class="article-toc-list-icon" />{label}</p>
    <ul id="article-toc-rail-list" class="article-toc-list"></ul>
  </nav>

  <div id="article-toc-overlay" class="article-toc-overlay hidden" aria-hidden="true"></div>
  <section id="article-toc-mobile" class="article-toc-panel hidden" role="dialog" aria-modal="true" aria-labelledby="article-toc-mobile-title">
    <div class="article-toc-panel-head">
      <Icon name="listTree" class="article-toc-panel-icon" />
      <div class="article-toc-panel-title-group">
        <span id="article-toc-mobile-title" class="article-toc-label">{label}</span>
        <span id="article-toc-current" class="article-toc-current" aria-live="polite"></span>
      </div>
      <span id="article-toc-count" class="article-toc-count hidden" data-count-format={countFormat}></span>
      <button id="article-toc-close" class="article-toc-close" type="button" aria-label="关闭目录"><Icon name="close" class="article-toc-close-icon" /></button>
    </div>
    <ul id="article-toc-mobile-list" class="article-toc-list"></ul>
  </section>

  <button id="article-toc-dock" class="article-toc-dock hidden" type="button" aria-label="打开章节目录" aria-haspopup="dialog" aria-controls="article-toc-mobile" aria-expanded="false" aria-hidden="true">
    <span class="article-toc-dock__signal" aria-hidden="true"></span>
    <span class="article-toc-dock__copy"><span class="article-toc-dock__eyebrow">READING</span><span id="article-toc-dock-current" class="article-toc-dock__current">章节目录</span></span>
    <span id="article-toc-dock-index" class="article-toc-dock__index">章节</span>
    <Icon name="arrowUp" class="article-toc-dock__icon" />
  </button>
</div>

<script>
  (function () {
    var allLinks = [];
    var itemById = {};
    var desktopRail = null;
    var mobilePanel = null;
    var mobileList = null;
    var dock = null;
    var overlay = null;
    var closeMobilePanel = null;
    var lastTrigger = null;

    function reducedMotion() {
      return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    }

    function keepActiveRailLinkVisible(link) {
      if (!desktopRail || !link || window.innerWidth < 1024) return;
      var railRect = desktopRail.getBoundingClientRect();
      var linkRect = link.getBoundingClientRect();
      var inset = 22;
      if (linkRect.top >= railRect.top + inset && linkRect.bottom <= railRect.bottom - inset) return;
      desktopRail.scrollTo({
        top: Math.max(0, desktopRail.scrollTop + linkRect.top - railRect.top - desktopRail.clientHeight / 2 + linkRect.height / 2),
        behavior: reducedMotion() ? "auto" : "smooth",
      });
    }

    function keepActiveMobileLinkVisible() {
      if (!mobilePanel || !mobilePanel.classList.contains("open")) return;
      var active = mobilePanel.querySelector(".article-toc-link.active");
      if (active) active.scrollIntoView({ block: "nearest", behavior: reducedMotion() ? "auto" : "smooth" });
    }

    function syncDockCopy(activeId) {
      if (!dock) return;
      var item = itemById[activeId];
      if (!item) return;
      var current = document.getElementById("article-toc-dock-current");
      var currentInPanel = document.getElementById("article-toc-current");
      var index = document.getElementById("article-toc-dock-index");
      if (current) current.textContent = item.text;
      if (currentInPanel) currentInPanel.textContent = item.text;
      if (index) index.textContent = "章节 " + (item.index + 1) + "/" + Object.keys(itemById).length;
    }

    function setActive(activeId) {
      var activeRailLink = null;
      allLinks.forEach(function (link) {
        var active = link.dataset.tocId === activeId;
        link.classList.toggle("active", active);
        if (active && link.closest("#article-toc-rail")) activeRailLink = link;
      });
      syncDockCopy(activeId);
      keepActiveRailLinkVisible(activeRailLink);
      keepActiveMobileLinkVisible();
    }

    function updateDockVisibility() {
      if (!dock) return;
      var article = document.querySelector(".galvin-article-content");
      var start = article ? window.scrollY + article.getBoundingClientRect().top - 160 : 560;
      var visible = window.innerWidth < 1024 && window.scrollY > start;
      dock.classList.toggle("is-visible", visible);
      dock.setAttribute("aria-hidden", String(!visible));
      if (!visible && closeMobilePanel && mobilePanel?.classList.contains("open")) closeMobilePanel(false);
    }

    function flashHeading(el) {
      if (!el) return;
      el.classList.remove("toc-flash");
      void el.offsetWidth;
      el.classList.add("toc-flash");
      setTimeout(function () { el.classList.remove("toc-flash"); }, 1600);
    }

    function getFocusable(container) {
      return Array.prototype.slice.call(container.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'));
    }

    function initArticleTOC() {
      var rail = document.getElementById("article-toc-rail");
      var railList = document.getElementById("article-toc-rail-list");
      var panel = document.getElementById("article-toc-mobile");
      var panelList = document.getElementById("article-toc-mobile-list");
      var countEl = document.getElementById("article-toc-count");
      var closeButton = document.getElementById("article-toc-close");
      var dockButton = document.getElementById("article-toc-dock");
      var panelOverlay = document.getElementById("article-toc-overlay");
      var article = document.querySelector(".article-content");
      if (!article || !rail || !railList || !panel || !panelList || !dockButton || !panelOverlay) return;

      desktopRail = rail;
      mobilePanel = panel;
      mobileList = panelList;
      dock = dockButton;
      overlay = panelOverlay;

      function mountToBody(el) {
        if (el && el.parentNode && el.parentNode !== document.body) document.body.appendChild(el);
      }
      mountToBody(dock);
      mountToBody(panel);
      mountToBody(overlay);

      var grid = document.getElementById("article-grid");
      var headings = Array.prototype.slice.call(article.querySelectorAll("h2, h3"));
      if (headings.length < 2) {
        rail.classList.add("toc-hide");
        panel.classList.add("hidden");
        dock.classList.add("hidden");
        if (grid) grid.classList.add("no-toc");
        var prevnext = document.querySelector(".article-prevnext");
        if (prevnext) prevnext.classList.add("no-toc");
        return;
      }

      if (grid) grid.classList.remove("no-toc");
      var prevnext2 = document.querySelector(".article-prevnext");
      if (prevnext2) prevnext2.classList.remove("no-toc");

      function slugify(text) {
        return text.toLowerCase().replace(/[^\w\u4e00-\u9fa5]+/g, "-").replace(/^-+|-+$/g, "") || "section";
      }

      var items = headings.map(function (heading, index) {
        var id = heading.id || slugify(heading.textContent || "") + "-" + index;
        heading.id = id;
        var item = { id: id, text: (heading.textContent || "").trim(), level: heading.tagName === "H2" ? 2 : 3, index: index };
        itemById[id] = item;
        return item;
      });

      function buildList(container) {
        container.innerHTML = "";
        items.forEach(function (item) {
          var li = document.createElement("li");
          li.className = "article-toc-item level-" + item.level;
          var link = document.createElement("a");
          link.href = "#" + item.id;
          link.textContent = item.text;
          link.className = "article-toc-link";
          link.dataset.tocId = item.id;
          li.appendChild(link);
          container.appendChild(li);
        });
      }
      buildList(railList);
      buildList(panelList);
      allLinks = Array.prototype.slice.call(railList.querySelectorAll(".article-toc-link")).concat(Array.prototype.slice.call(panelList.querySelectorAll(".article-toc-link")));

      rail.classList.remove("hidden");
      panel.classList.remove("hidden");
      dock.classList.remove("hidden");
      overlay.classList.remove("hidden");
      overlay.setAttribute("aria-hidden", "true");

      if (countEl) {
        countEl.textContent = (countEl.getAttribute("data-count-format") || "{count}").replace("{count}", String(items.length));
        countEl.classList.remove("hidden");
      }

      function openPanel() {
        if (!dock.classList.contains("is-visible")) return;
        lastTrigger = document.activeElement;
        panel.classList.add("open");
        overlay.classList.add("open");
        overlay.setAttribute("aria-hidden", "false");
        dock.setAttribute("aria-expanded", "true");
        document.body.classList.add("article-toc-open");
        requestAnimationFrame(function () {
          keepActiveMobileLinkVisible();
          if (closeButton) closeButton.focus();
        });
      }

      closeMobilePanel = function (returnFocus) {
        if (!panel.classList.contains("open")) return;
        panel.classList.remove("open");
        overlay.classList.remove("open");
        overlay.setAttribute("aria-hidden", "true");
        dock.setAttribute("aria-expanded", "false");
        document.body.classList.remove("article-toc-open");
        if (returnFocus !== false) requestAnimationFrame(function () { (lastTrigger || dock).focus(); });
      };

      dock.onclick = function () { panel.classList.contains("open") ? closeMobilePanel(true) : openPanel(); };
      overlay.onclick = function () { closeMobilePanel(true); };
      if (closeButton) closeButton.onclick = function () { closeMobilePanel(true); };

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) { if (entry.isIntersecting) setActive(entry.target.id); });
      }, { rootMargin: "-80px 0px -70% 0px", threshold: 0 });
      headings.forEach(function (heading) { observer.observe(heading); });
      if (initArticleTOC._observer) initArticleTOC._observer.disconnect();
      initArticleTOC._observer = observer;

      if (!dock.__galvinDockBound) {
        dock.__galvinDockBound = true;
        window.addEventListener("scroll", updateDockVisibility, { passive: true });
        window.addEventListener("resize", updateDockVisibility, { passive: true });
      }
      setActive(items[0].id);
      updateDockVisibility();
    }

    document.addEventListener("click", function (event) {
      var targetLink = event.target?.closest?.(".article-toc-link");
      if (!targetLink) return;
      var id = targetLink.dataset.tocId;
      var target = id && document.getElementById(id);
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: reducedMotion() ? "auto" : "smooth", block: "start" });
      history.replaceState(null, "", "#" + id);
      setActive(id);
      flashHeading(target);
      if (targetLink.closest("#article-toc-mobile") && closeMobilePanel) {
        closeMobilePanel(false);
        target.setAttribute("tabindex", "-1");
        requestAnimationFrame(function () { target.focus({ preventScroll: true }); });
      }
    });

    document.addEventListener("keydown", function (event) {
      if (!mobilePanel?.classList.contains("open")) return;
      if (event.key === "Escape") { event.preventDefault(); closeMobilePanel?.(true); return; }
      if (event.key !== "Tab") return;
      var focusable = getFocusable(mobilePanel);
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });

    initArticleTOC();
    document.addEventListener("astro:page-load", function () { setTimeout(initArticleTOC, 0); });
  })();
</script>
