---
// ArticleTOC v4 — 文章目录
// 单个组件根节点内同时包含：
//   - 桌面（≥lg）：右侧 sticky 侧栏，随滚动高亮当前章节
//   - 移动端 / 平板：右下角可拖拽目录悬浮球，点击弹出章节选择面板
// 两个变体通过 responsive class 切换显隐，页面只需渲染一份，避免重复 DOM id。
//
// 样式全部放在全局作用域（src/styles/global.css）：
// 目录项由 JS 动态创建，Astro 的 data-astro-cid 作用域属性不会打到动态节点，
// 放在组件 scoped <style> 里会导致样式失效（旧版 bug）。
//
// Props:
//   @param {string} [label] - 目录标题文案（默认「目录」），中英文由页面传入

interface Props {
  label?: string;
  /** 计数格式，{count} 会被替换为标题数，如 "{count} 节" / "{count} items" */
  countFormat?: string;
}

import Icon from "./Icon.astro";
const { label = "目录", countFormat = "{count} 节" } = Astro.props;
---

<div class="article-toc-root">
  <!-- 桌面端：右侧 sticky 目录栏（lg+ 显示；标题数 >= 2 时显示，JS 控制 .toc-hide） -->
  <nav id="article-toc-rail" class="article-toc-rail" aria-label={label}>
    <p class="article-toc-rail-label">
      <Icon name="list" class="article-toc-list-icon" />
      {label}
    </p>
    <ul id="article-toc-rail-list" class="article-toc-list"></ul>
  </nav>

  <!-- 移动端 / 平板：章节选择弹出面板（<lg 显示；JS 在标题数不足 2 时加 hidden 隐藏） -->
  <div id="article-toc-overlay" class="article-toc-overlay hidden"></div>
  <div id="article-toc-mobile" class="article-toc-panel hidden" role="dialog" aria-modal="true" aria-label={label}>
    <div class="article-toc-panel-head">
      <Icon name="listTree" class="article-toc-panel-icon" />
      <span class="article-toc-label">{label}</span>
      <span id="article-toc-count" class="article-toc-count hidden" data-count-format={countFormat}></span>
      <button id="article-toc-close" class="article-toc-close" type="button" aria-label="关闭目录">
        <Icon name="close" class="article-toc-close-icon" />
      </button>
    </div>
    <ul id="article-toc-mobile-list" class="article-toc-list"></ul>
  </div>

  <!-- 移动端 / 平板：目录悬浮球（<lg 显示；可拖拽，点击弹出章节面板） -->
  <button id="article-toc-fab" class="article-toc-fab" type="button" aria-label={label} aria-haspopup="dialog" aria-controls="article-toc-mobile">
    <Icon name="listTree" class="article-toc-fab-icon" />
    <span id="article-toc-fab-count" class="article-toc-fab-count hidden"></span>
  </button>
</div>

<script>
  (function () {
    // 收集桌面 + 移动端所有目录链接，供 setActive 统一高亮
    var allLinks = [];

    function setActive(activeId) {
      allLinks.forEach(function (l) {
        l.classList.toggle("active", l.dataset.tocId === activeId);
      });
    }

    // 目标标题闪烁提示（点击目录后的明确反馈）
    function flashHeading(el) {
      if (!el) return;
      el.classList.remove("toc-flash");
      void el.offsetWidth; // 强制 reflow，保证动画可重播
      el.classList.add("toc-flash");
      setTimeout(function () {
        el.classList.remove("toc-flash");
      }, 1600);
    }

    function initArticleTOC() {
      var rail = document.getElementById("article-toc-rail");
      var railList = document.getElementById("article-toc-rail-list");
      var mobile = document.getElementById("article-toc-mobile");
      var mobileList = document.getElementById("article-toc-mobile-list");
      var countEl = document.getElementById("article-toc-count");
      var fab = document.getElementById("article-toc-fab");
      var fabCount = document.getElementById("article-toc-fab-count");
      var closeBtn = document.getElementById("article-toc-close");

      var article = document.querySelector(".article-content");
      if (!article || !rail || !railList || !mobile || !mobileList || !fab) return;

      // 无目录时把外层 .article-grid 退回单栏，避免右侧空出一列
      var grid = document.getElementById("article-grid");

      var headings = Array.prototype.slice.call(article.querySelectorAll("h2, h3"));

      // 目录项太少时不展示
      if (headings.length < 2) {
        rail.classList.add("toc-hide");
        mobile.classList.add("hidden");
        fab.classList.add("hidden");
        if (grid) grid.classList.add("no-toc");
        // 上一篇/下一篇导航同步退回整行（无目录时右侧不留空白列）
        var prevnext = document.querySelector(".article-prevnext");
        if (prevnext) prevnext.classList.add("no-toc");
        return;
      } else if (grid) {
        grid.classList.remove("no-toc");
        var prevnext2 = document.querySelector(".article-prevnext");
        if (prevnext2) prevnext2.classList.remove("no-toc");
      }

      // 为标题生成稳定锚点 id
      var slugify = function (text) {
        return (
          text
            .toLowerCase()
            .replace(/[^\w\u4e00-\u9fa5]+/g, "-")
            .replace(/^-+|-+$/g, "") || "section"
        );
      };

      var items = [];
      headings.forEach(function (h, i) {
        var id = h.id || slugify(h.textContent || "") + "-" + i;
        h.id = id;
        items.push({
          id: id,
          text: (h.textContent || "").trim(),
          level: h.tagName === "H2" ? 2 : 3,
        });
      });

      function buildList(container) {
        container.innerHTML = "";
        items.forEach(function (item) {
          var li = document.createElement("li");
          li.className = "article-toc-item level-" + item.level;
          var a = document.createElement("a");
          a.href = "#" + item.id;
          a.textContent = item.text;
          a.className = "article-toc-link";
          a.dataset.tocId = item.id;
          li.appendChild(a);
          container.appendChild(li);
        });
      }

      buildList(railList);
      buildList(mobileList);

      allLinks = Array.prototype.slice.call(railList.querySelectorAll(".article-toc-link")).concat(
        Array.prototype.slice.call(mobileList.querySelectorAll(".article-toc-link"))
      );

      rail.classList.remove("hidden");
      fab.classList.remove("hidden");
      // 弹出面板初始隐藏，点击悬浮球后才显示
      mobile.classList.add("hidden");

      // 移动端：显示标题计数（面板头部 + 悬浮球角标）
      if (countEl) {
        var fmt = countEl.getAttribute("data-count-format") || "{count}";
        countEl.textContent = fmt.replace("{count}", String(items.length));
        countEl.classList.remove("hidden");
      }
      if (fabCount) {
        fabCount.textContent = String(items.length);
        fabCount.classList.remove("hidden");
      }

      // ---- 移动端：悬浮球交互 ----
      var dragging = false; // 拖拽中不触发点击
      var overlay = document.getElementById("article-toc-overlay");

      function openPanel() {
        mobile.classList.remove("hidden");
        mobile.classList.add("open");
        fab.classList.add("open");
        if (overlay) overlay.classList.remove("hidden");
      }
      function closePanel() {
        mobile.classList.add("hidden");
        mobile.classList.remove("open");
        fab.classList.remove("open");
        if (overlay) overlay.classList.add("hidden");
      }

      // 点击悬浮球开关面板（直接赋值避免重复绑定）
      fab.onclick = function () {
        if (dragging) return;
        if (mobile.classList.contains("hidden")) {
          openPanel();
        } else {
          closePanel();
        }
      };
      if (closeBtn) {
        closeBtn.onclick = closePanel;
      }
      // 点击面板背景 / 遮罩关闭
      if (overlay) overlay.onclick = closePanel;

      // 悬浮球拖拽（pointer 事件，兼容触屏 / 鼠标）
      var startX = 0, startY = 0, originX = 0, originY = 0;
      var left, top;

      function getPos() {
        var rect = fab.getBoundingClientRect();
        return { left: rect.left, top: rect.top };
      }

      fab.addEventListener("pointerdown", function (e) {
        if (e.pointerType === "mouse" && e.button !== 0) return;
        // 用户开始操作后停止首次加载的引导动画，避免动画干扰拖拽/点击
        fab.style.animation = "none";
        dragging = false;
        startX = e.clientX;
        startY = e.clientY;
        var p = getPos();
        originX = p.left;
        originY = p.top;
        fab.setPointerCapture(e.pointerId);
        fab.classList.add("dragging");
      });

      fab.addEventListener("pointermove", function (e) {
        if (!fab.classList.contains("dragging")) return;
        var dx = e.clientX - startX;
        var dy = e.clientY - startY;
        if (!dragging && Math.abs(dx) + Math.abs(dy) < 8) return; // 小于阈值为点击
        dragging = true;
        left = originX + dx;
        top = originY + dy;
        // 限制在视口内
        var vw = document.documentElement.clientWidth;
        var vh = document.documentElement.clientHeight;
        var fw = fab.offsetWidth;
        var fh = fab.offsetHeight;
        var m = 8;
        left = Math.max(m, Math.min(vw - fw - m, left));
        top = Math.max(m, Math.min(vh - fh - m, top));
        fab.style.left = left + "px";
        fab.style.top = top + "px";
        fab.style.right = "auto";
        fab.style.bottom = "auto";
      });

      function endDrag(e) {
        if (!fab.classList.contains("dragging")) return;
        fab.classList.remove("dragging");
        // 手指抬起时如果有指针捕获需释放
        try { fab.releasePointerCapture(e.pointerId); } catch (err) {}
      }
      fab.addEventListener("pointerup", endDrag);
      fab.addEventListener("pointercancel", endDrag);

      // 滚动高亮当前章节（桌面 + 移动端共用）
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              setActive(entry.target.id);
            }
          });
        },
        { rootMargin: "-80px 0px -70% 0px", threshold: 0 }
      );
      headings.forEach(function (h) {
        observer.observe(h);
      });

      // 清理旧 observer（view transition 时旧 DOM 被替换，但以防万一）
      if (initArticleTOC._observer) {
        initArticleTOC._observer.disconnect();
      }
      initArticleTOC._observer = observer;
    }

    // 事件委托：点击目录链接平滑滚动到目标（兼容动态创建的节点）
    // 立即高亮 + 目标标题闪烁，保证短章节也有明确反馈；移动端点击后自动关闭面板
    document.addEventListener("click", function (e) {
      var t = e.target;
      if (!t || !t.classList || !t.classList.contains("article-toc-link")) return;
      var id = t.dataset.tocId;
      if (!id) return;
      var target = document.getElementById(id);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        history.replaceState(null, "", "#" + id);
        // 立即高亮，不等 IntersectionObserver（短章节可能不会触发交叉回调）
        setActive(id);
        // 目标标题闪烁，明确"跳到了这里"
        flashHeading(target);
        // 移动端：点击后关闭弹出面板
        var mobile = document.getElementById("article-toc-mobile");
        if (mobile) {
          mobile.classList.add("hidden");
          mobile.classList.remove("open");
        }
        var fab = document.getElementById("article-toc-fab");
        if (fab) fab.classList.remove("open");
        var overlay = document.getElementById("article-toc-overlay");
        if (overlay) overlay.classList.add("hidden");
      }
    });

    // 按 Esc 关闭移动端弹出面板
    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      var mobile = document.getElementById("article-toc-mobile");
      var fab = document.getElementById("article-toc-fab");
      if (mobile && !mobile.classList.contains("hidden")) {
        mobile.classList.add("hidden");
        mobile.classList.remove("open");
        if (fab) fab.classList.remove("open");
        var overlay = document.getElementById("article-toc-overlay");
        if (overlay) overlay.classList.add("hidden");
      }
    });

    initArticleTOC();

    // Astro View Transition 导航后重新初始化（旧 DOM 被替换）
    document.addEventListener("astro:page-load", function () {
      setTimeout(initArticleTOC, 0);
    });
  })();
</script>
