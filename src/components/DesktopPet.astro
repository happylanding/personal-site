---
import { useTranslations, getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const label = t("pet.label");
const hint = t("pet.hint");
const lines = t("pet.lines");
const greetings = t("pet.greetings");
---

<!--
  Desktop Pet: Gali 小猫头鹰
  程序化 AI 设计的矢量吉祥物 —— 寓意智慧与终身学习，绿色呼应站点品牌色。
  交互：待机呼吸浮动 / 眼睛追踪鼠标 / 随机眨眼 / 点击弹气泡 / 可拖拽换位置
-->
<div
  id="pet"
  class="pet"
  role="button"
  tabindex="0"
  aria-label={label}
  data-lines={JSON.stringify(lines)}
  data-hint={hint}
  data-greetings={JSON.stringify(greetings)}
>
  <div id="pet-bubble" class="pet-bubble" aria-live="polite"></div>

  <!-- 角色成长进度条（P2 #7 彩蛋）：随页面滚动成长，Lv.1 → Lv.4 -->
  <div class="pet-growth" aria-hidden="true">
    <span class="pet-growth-bar"></span>
    <span class="pet-growth-stage">Lv.1</span>
  </div>

  <!-- 移动端最小化/恢复按钮（P2 #9 体验兜底） -->
  <button class="pet-min-btn" type="button" aria-label={label} data-min-label>
    <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M4 4 L12 12 M12 4 L4 12" />
    </svg>
  </button>

  <svg class="pet-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <!-- 渐变：颜色走主题令牌，亮/暗色自动适配 -->
      <linearGradient id="pet-g-body" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" style="stop-color:var(--pet-body)" />
        <stop offset="100%" style="stop-color:var(--pet-body-deep)" />
      </linearGradient>
      <linearGradient id="pet-g-belly" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" style="stop-color:var(--pet-belly)" />
        <stop offset="100%" style="stop-color:var(--pet-belly-deep)" />
      </linearGradient>
      <linearGradient id="pet-g-wing" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" style="stop-color:var(--pet-dark)" />
        <stop offset="100%" style="stop-color:var(--pet-dark-deep)" />
      </linearGradient>
      <linearGradient id="pet-g-beak" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" style="stop-color:var(--pet-beak)" />
        <stop offset="100%" style="stop-color:var(--pet-beak-deep)" />
      </linearGradient>
      <radialGradient id="pet-g-face" cx="50%" cy="42%" r="65%">
        <stop offset="0%" style="stop-color:var(--pet-face)" />
        <stop offset="100%" style="stop-color:var(--pet-face-deep)" />
      </radialGradient>
    </defs>

    <!-- 尾巴（身体后方） -->
    <g class="pet-tail">
      <path d="M52 156 Q28 166 32 182 Q52 176 58 168 Z" style="fill:var(--pet-dark)" />
      <path d="M148 156 Q172 166 168 182 Q148 176 142 168 Z" style="fill:var(--pet-dark)" />
    </g>

    <!-- 脚 -->
    <g class="pet-feet">
      <ellipse cx="70" cy="174" rx="13" ry="6" style="fill:var(--pet-feet)" />
      <ellipse cx="130" cy="174" rx="13" ry="6" style="fill:var(--pet-feet)" />
      <path d="M70 174 q-6 0 -8 -3 M70 174 q0 -4 0 -7 M70 174 q6 0 8 -3" stroke="var(--pet-feet-deep)" stroke-width="1.6" stroke-linecap="round" fill="none" opacity="0.6" />
      <path d="M130 174 q-6 0 -8 -3 M130 174 q0 -4 0 -7 M130 174 q6 0 8 -3" stroke="var(--pet-feet-deep)" stroke-width="1.6" stroke-linecap="round" fill="none" opacity="0.6" />
    </g>

    <!-- 身体 -->
    <ellipse cx="100" cy="122" rx="54" ry="52" fill="url(#pet-g-body)" stroke="var(--pet-outline)" stroke-width="2" />
    <!-- 肚皮 -->
    <path d="M100 92 C82 92 72 110 72 130 C72 152 82 166 100 166 C118 166 128 152 128 130 C128 110 118 92 100 92 Z" fill="url(#pet-g-belly)" />
    <!-- 肚皮羽毛纹理 -->
    <g class="pet-belly-marks" stroke="var(--pet-belly-deep)" stroke-width="1.8" stroke-linecap="round" fill="none" opacity="0.45">
      <path d="M86 112 q8 -5 16 0" />
      <path d="M92 126 q8 -5 16 0" />
      <path d="M86 140 q8 -5 16 0" />
      <path d="M92 152 q8 -5 16 0" />
    </g>

    <!-- 翅膀（待机轻微扑扇 + hover 抬翅） -->
    <g class="pet-wing pet-wing-l">
      <path d="M52 96 C30 104 22 130 30 158 C44 152 56 136 58 112 Z" fill="url(#pet-g-wing)" stroke="var(--pet-outline)" stroke-width="2" />
      <path d="M40 116 q10 -4 16 2 M38 132 q11 -3 18 3 M40 146 q9 -2 15 4" stroke="var(--pet-dark-deep)" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.5" />
    </g>
    <g class="pet-wing pet-wing-r">
      <path d="M148 96 C170 104 178 130 170 158 C156 152 144 136 142 112 Z" fill="url(#pet-g-wing)" stroke="var(--pet-outline)" stroke-width="2" />
      <path d="M160 116 q-10 -4 -16 2 M162 132 q-11 -3 -18 3 M160 146 q-9 -2 -15 4" stroke="var(--pet-dark-deep)" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.5" />
    </g>

    <!-- 头部（整体可转向，眼睛在脸部盘上） -->
    <g class="pet-head">
      <g class="pet-head-turn">
      <!-- 耳朵（羽簇） -->
      <path d="M62 44 L52 20 L84 34 Q70 40 62 44 Z" style="fill:var(--pet-dark)" stroke="var(--pet-outline)" stroke-width="1.6" />
      <path d="M138 44 L148 20 L116 34 Q130 40 138 44 Z" style="fill:var(--pet-dark)" stroke="var(--pet-outline)" stroke-width="1.6" />
      <!-- 头顶小羽簇 -->
      <path d="M88 36 L84 22 L96 32 Q90 34 88 36 Z" style="fill:var(--pet-dark)" />
      <path d="M100 34 L100 18 L108 32 Q104 34 100 34 Z" style="fill:var(--pet-dark)" />
      <path d="M112 36 L116 22 L104 32 Q110 34 112 36 Z" style="fill:var(--pet-dark)" />
      <!-- 头 -->
      <circle cx="100" cy="58" r="36" fill="url(#pet-g-face)" stroke="var(--pet-outline)" stroke-width="2" />
      <!-- 脸部盘 -->
      <ellipse cx="76" cy="62" rx="25" ry="22" fill="var(--pet-face-disc)" opacity="0.9" />
      <ellipse cx="124" cy="62" rx="25" ry="22" fill="var(--pet-face-disc)" opacity="0.9" />
      <!-- 眉毛 -->
      <path d="M56 48 Q74 38 92 46" stroke="var(--pet-outline)" stroke-width="3.2" stroke-linecap="round" fill="none" />
      <path d="M144 48 Q126 38 108 46" stroke="var(--pet-outline)" stroke-width="3.2" stroke-linecap="round" fill="none" />
      <!-- 腮红 -->
      <ellipse cx="56" cy="80" rx="8" ry="4.5" style="fill:var(--pet-blush)" opacity="0.85" />
      <ellipse cx="144" cy="80" rx="8" ry="4.5" style="fill:var(--pet-blush)" opacity="0.85" />

      <!-- 眼睛（眨眼 / 瞳孔追踪作用于此 group） -->
      <g class="pet-eye pet-eye-l">
        <circle cx="76" cy="62" r="16" style="fill:var(--pet-eye-bg);stroke:var(--pet-outline)" stroke-width="2.5" />
        <g class="pet-pupil">
          <circle cx="76" cy="63" r="8.5" style="fill:var(--pet-pupil)" />
          <circle cx="73.3" cy="60.3" r="3" style="fill:var(--pet-pupil-hi)" />
          <circle cx="77.9" cy="66" r="1.5" style="fill:var(--pet-pupil-hi)" opacity="0.7" />
        </g>
      </g>
      <g class="pet-eye pet-eye-r">
        <circle cx="124" cy="62" r="16" style="fill:var(--pet-eye-bg);stroke:var(--pet-outline)" stroke-width="2.5" />
        <g class="pet-pupil">
          <circle cx="124" cy="63" r="8.5" style="fill:var(--pet-pupil)" />
          <circle cx="121.3" cy="60.3" r="3" style="fill:var(--pet-pupil-hi)" />
          <circle cx="125.9" cy="66" r="1.5" style="fill:var(--pet-pupil-hi)" opacity="0.7" />
        </g>
      </g>
      <!-- 喙 -->
      <path d="M90 70 Q100 66 110 70 Q104 82 100 86 Q96 82 90 70 Z" fill="url(#pet-g-beak)" stroke="var(--pet-beak-deep)" stroke-width="1.6" stroke-linejoin="round" />

      <!-- 成长配饰（P2 #7 角色成长彩蛋）：由 data-growth 切换，默认隐藏，随头部一起转向 -->
      <!-- 蝴蝶结：Lv.2 成长阶段佩戴 -->
      <g class="growth-badge growth-ribbon">
        <circle cx="100" cy="34" r="5" fill="#ec4899" />
        <path d="M100 34 Q80 26 76 40 Q88 46 100 34 Z" fill="#f472b6" />
        <path d="M100 34 Q120 26 124 40 Q112 46 100 34 Z" fill="#f472b6" />
      </g>
      <!-- 圆框眼镜：Lv.3 及以上佩戴 -->
      <g class="growth-badge growth-glasses">
        <circle cx="76" cy="62" r="18" fill="none" stroke="#475569" stroke-width="2.4" />
        <circle cx="124" cy="62" r="18" fill="none" stroke="#475569" stroke-width="2.4" />
        <path d="M94 62 q6 -5 12 0" stroke="#475569" stroke-width="2.4" fill="none" />
        <path d="M58 58 q-7 -4 -12 1" stroke="#475569" stroke-width="2.4" fill="none" />
        <path d="M142 58 q7 -4 12 1" stroke="#475569" stroke-width="2.4" fill="none" />
      </g>
      <!-- 学士帽：Lv.4 毕业造型 -->
      <g class="growth-badge growth-hat">
        <ellipse cx="100" cy="32" rx="36" ry="8" fill="#1e293b" />
        <path d="M66 30 L134 30 L134 22 Q134 14 122 14 L78 14 Q66 14 66 22 Z" fill="#1e293b" />
        <path d="M134 22 q11 7 6 17" stroke="#f59e0b" stroke-width="3" fill="none" />
        <circle cx="140" cy="39" r="3.5" fill="#f59e0b" />
      </g>
      </g>
    </g>

    <!-- 姿态附加元素（默认隐藏，由 data-pose 切换） -->
    <!-- 挥手：抬起挥动的右翅膀 -->
    <g class="pose-waving">
      <path d="M158 88 C186 72 200 92 188 108 C174 98 166 92 156 94 Z" fill="url(#pet-g-wing)" stroke="var(--pet-outline)" stroke-width="2" />
      <path d="M202 74 q9 2 12 12" stroke="var(--pet-outline)" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.5" />
    </g>
    <!-- 抱书：肚皮前一本摊开的书 -->
    <g class="pose-reading">
      <rect x="68" y="126" width="64" height="40" rx="5" style="fill:var(--pet-book)" />
      <path d="M68 137 H132 M68 148 H132 M68 159 H132" stroke="var(--pet-belly)" stroke-width="1.6" opacity="0.6" />
      <path d="M100 126 V166" stroke="var(--pet-book-edge)" stroke-width="1.6" opacity="0.6" />
    </g>
    <!-- 睡觉：闭眼 + 头顶冒 Z -->
    <g class="pose-sleeping">
      <path d="M62 62 q14 -8 28 0 M116 62 q14 -8 28 0" stroke="var(--pet-outline)" stroke-width="3" stroke-linecap="round" fill="none" />
      <text x="150" y="84" text-anchor="middle" class="pet-zzz pet-zzz-big" font-size="17" font-weight="700">Z</text>
      <text x="166" y="66" text-anchor="middle" class="pet-zzz pet-zzz-small" font-size="11" font-weight="700">z</text>
    </g>
  </svg>
</div>

<script>
  const pet = document.getElementById("pet");
  const bubble = document.getElementById("pet-bubble");
  if (!pet || !bubble) throw new Error("DesktopPet: #pet/#pet-bubble not found");

  const pupils = pet.querySelectorAll(".pet-pupil");
  const lines: string[] = JSON.parse(pet.dataset.lines || "[]");
  const hint = pet.dataset.hint || "";
  const greetings: Record<string, string> = JSON.parse(pet.dataset.greetings || "{}");

  // ===== 系统偏好 =====
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ===== 按节令选取问候语 =====
  function greetingForNow(): string {
    const now = new Date();
    const day = now.getDay();
    if (day === 0 || day === 6) return greetings.weekend || "";
    const h = now.getHours();
    if (h >= 5 && h < 11) return greetings.morning || "";
    if (h >= 11 && h < 17) return greetings.afternoon || "";
    if (h >= 17 && h < 23) return greetings.evening || "";
    return greetings.night || "";
  }

  // ===== 姿态切换（视觉升级：挥手 / 抱书 / 睡觉，按节令/时段自动切换） =====
  const POSE_WAVING = "waving";
  const POSE_READING = "reading";
  const POSE_SLEEPING = "sleeping";
  const poseEls = {
    [POSE_WAVING]: pet.querySelector(".pose-waving"),
    [POSE_READING]: pet.querySelector(".pose-reading"),
    [POSE_SLEEPING]: pet.querySelector(".pose-sleeping"),
  };

  function setPose(pose: string | null) {
    (Object.keys(poseEls) as string[]).forEach((key) => {
      const el = poseEls[key];
      if (el) el.setAttribute("data-active", pose === key ? "true" : "false");
    });
    if (pose) pet.setAttribute("data-pose", pose);
    else pet.removeAttribute("data-pose");
  }

  function poseForNow(): string | null {
    const now = new Date();
    const h = now.getHours();
    const day = now.getDay();
    // 深夜或凌晨（23-5 点）→ 睡觉
    if (h >= 23 || h < 5) return POSE_SLEEPING;
    // 周末白天 → 放松抱书读
    if (day === 0 || day === 6) return POSE_READING;
    // 工作日早晨 → 元气挥手打招呼
    if (h >= 7 && h < 10) return POSE_WAVING;
    // 其余时间 → 抱书（阅读者形象）
    return POSE_READING;
  }

  setPose(poseForNow());
  // 跨午夜/时段切换时更新姿态（每小时核对一次，代价极小）
  window.setInterval(() => setPose(poseForNow()), 60 * 60 * 1000);

  // ===== 滚动跟随：宠物随阅读区块上下浮动 =====
  let followRAF = false;
  let isDragging = false;
  let petX = 20; // 当前锚定的水平位置（默认左下）
  let petY = 20; // 当前锚定的垂直位置
  const PET_W = 108;
  const PET_H = 108;
  const GAP = 20;

  // 收集当前页面可跟随的锚点（首页各 section；其他页无区块时退化为空）
  const anchorSel = ["main section", "main article", "#currently", "[data-reveal]"].join(",");

  function pickAnchor(): Element | null {
    const anchors = Array.from(document.querySelectorAll(anchorSel)).filter(
      (el) => (el as HTMLElement).offsetHeight > 0
    );
    if (!anchors.length) return null;
    // 取第一个已进入视口且仍在视口内的区块；否则取最后一个已滚过的区块
    const vh = window.innerHeight;
    for (const el of anchors) {
      const r = el.getBoundingClientRect();
      if (r.top < vh * 0.85 && r.bottom > 0) return el;
    }
    return anchors[anchors.length - 1];
  }

  function clampToViewport(x: number, y: number) {
    const w = pet.offsetWidth || PET_W;
    const h = pet.offsetHeight || PET_H;
    const margin = 8;
    x = Math.max(margin, Math.min(window.innerWidth - w - margin, x));
    y = Math.max(margin, Math.min(window.innerHeight - h - margin, y));
    return { x, y };
  }

  function followScroll() {
    followRAF = false;
    if (isDragging) return; // 拖拽中不自动跟
    if (
      document.documentElement.classList.contains("search-overlay-open") ||
      document.documentElement.classList.contains("mobile-overlay-open")
    ) {
      return; // 弹窗/菜单打开时保持隐藏
    }
    const anchor = pickAnchor();
    // 水平位置：保持用户拖拽后的 petX（未拖拽时为默认 20）
    const targetX = petX;
    const HEADER_OFFSET = 72; // sticky header 高度 + 间距，避免盖住导航
    if (anchor) {
      const r = anchor.getBoundingClientRect();
      let targetY = Math.max(HEADER_OFFSET, r.top + GAP);
      // 锚点在视口下方时，让宠物停在底部
      if (r.top > window.innerHeight - PET_H - GAP) targetY = window.innerHeight - PET_H - GAP;
      targetY = Math.max(HEADER_OFFSET, Math.min(window.innerHeight - PET_H - GAP, targetY));
      const pos = avoidBackToTop(targetX, targetY);
      const { x, y } = clampToViewport(pos.x, pos.y);
      pet.style.left = `${x}px`;
      pet.style.top = `${y}px`;
      petX = x;
      petY = y;
    } else {
      const pos = avoidBackToTop(targetX, 20);
      const { x, y } = clampToViewport(pos.x, pos.y);
      pet.style.left = `${x}px`;
      pet.style.top = `${y}px`;
      petX = x;
      petY = y;
    }
  }

  function requestFollow() {
    if (followRAF) return;
    followRAF = true;
    requestAnimationFrame(followScroll);
  }

  // 仅在桌面端启用滚动跟随（移动端保持固定，避免干扰阅读）
  const isFinePointer = () => window.matchMedia("(pointer: fine)").matches;
  if (isFinePointer() && !reduceMotion) {
    window.addEventListener("scroll", requestFollow, { passive: true });
    window.addEventListener("resize", requestFollow, { passive: true });
    requestFollow();
  }

  // ===== 随机眨眼（reduced-motion 时完全静止） =====
  let blinkTimer: ReturnType<typeof setTimeout>;
  function scheduleBlink() {
    if (reduceMotion) return;
    clearTimeout(blinkTimer);
    blinkTimer = setTimeout(() => {
      pet.classList.remove("blink");
      void pet.offsetWidth; // 重触发动画
      pet.classList.add("blink");
      setTimeout(() => pet.classList.remove("blink"), 420);
      scheduleBlink();
    }, 2600 + Math.random() * 3400);
  }
  scheduleBlink();

  // ===== 瞳孔跟随鼠标（reduced-motion 时静止） =====
  const head = pet.querySelector(".pet-head-turn");
  let raf = false;
  window.addEventListener("mousemove", (e) => {
    if (reduceMotion) return;
    if (raf) return;
    raf = true;
    requestAnimationFrame(() => {
      const rect = pet.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      let dx = (e.clientX - cx) / (rect.width / 2);
      let dy = (e.clientY - cy) / (rect.height / 2);
      dx = Math.max(-1, Math.min(1, dx));
      dy = Math.max(-1, Math.min(1, dy));
      const maxMove = 6;
      pupils.forEach((p) => {
        p.setAttribute("transform", `translate(${(dx * maxMove).toFixed(1)} ${(dy * maxMove * 0.8).toFixed(1)})`);
      });
      // 头部整体小角度转向鼠标（类似 oiloil 狗狗转头，但更克制、不遮挡内容）
      if (head) {
        head.style.transform = `rotate(${(dx * 5).toFixed(1)}deg)`;
      }
      raf = false;
    });
  });

  // ===== 随机闭一只眼（wink，逗趣） =====
  function scheduleWink() {
    if (reduceMotion) return;
    clearTimeout(winkTimer);
    winkTimer = setTimeout(() => {
      pet.classList.add("wink");
      setTimeout(() => pet.classList.remove("wink"), 180);
      scheduleWink();
    }, 9000 + Math.random() * 7000);
  }
  let winkTimer: ReturnType<typeof setTimeout>;
  scheduleWink();

  // ===== 气泡 =====
  let bubbleTimer: ReturnType<typeof setTimeout>;
  function say(text: string) {
    bubble.textContent = text;
    bubble.classList.add("show");
    clearTimeout(bubbleTimer);
    bubbleTimer = setTimeout(() => bubble.classList.remove("show"), 3200);
  }

  // ===== P2 #8：宠物 × Currently 联动 =====
  // 从 Currently 卡片读取站内真实内容（在读哪本书 / 最近写了什么），让宠物“说人话”
  const pageLang = document.documentElement.lang || "zh";
  let currentlyRows: { label: string; title: string }[] = [];
  function collectCurrently() {
    const rows: { label: string; title: string }[] = [];
    document.querySelectorAll("[data-currently-row]").forEach((row) => {
      const label = row.querySelector(".font-mono")?.textContent?.trim() || "";
      const title = row.querySelector(".truncate")?.textContent?.trim() || "";
      if (title) rows.push({ label, title });
    });
    currentlyRows = rows;
  }

  // 从 Currently 行生成一句“说人话”的台词（长度 ≤ 20 字，超出截断）
  function currentlyLine(): string {
    if (!currentlyRows.length) return "";
    const row = currentlyRows[Math.floor(Math.random() * currentlyRows.length)];
    const clean = row.title.replace(/《|》/g, "").replace(/:.*$/g, "").trim();
    if (!clean) return "";
    const prefix = pageLang?.startsWith("en") ? "Currently" : "最近";
    return `${prefix} ${clean}`.slice(0, 22);
  }

  // 首次收集 + 每次 View Transition 后重新收集（SPA 导航时内容会变）
  collectCurrently();
  document.addEventListener("astro:page-load", collectCurrently);

  // ===== P2 #7：角色成长彩蛋 =====
  // 随页面滚动进度从 Lv.1（小萌新）成长到 Lv.4（老学究），佩戴蝴蝶结/眼镜/学士帽
  const growthBar = pet.querySelector(".pet-growth-bar");
  const growthStage = pet.querySelector(".pet-growth-stage");
  const growthBadges = {
    ribbon: pet.querySelector(".growth-ribbon"),
    glasses: pet.querySelector(".growth-glasses"),
    hat: pet.querySelector(".growth-hat"),
  };

  function growthLevel(progress: number): number {
    if (progress >= 0.9) return 4;
    if (progress >= 0.6) return 3;
    if (progress >= 0.3) return 2;
    return 1;
  }

  function updateGrowth() {
    if (!growthBar) return;
    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? Math.min(1, Math.max(0, scrollTop / docHeight)) : 0;
    const level = growthLevel(progress);

    // 进度条宽度 + 等级标签
    growthBar.style.width = `${(progress * 100).toFixed(0)}%`;
    if (growthStage) growthStage.textContent = `Lv.${level}`;
    pet.setAttribute("data-growth", String(level));

    // 配饰切换：Lv.2 蝴蝶结、Lv.3 眼镜、Lv.4 学士帽（Lv.4 叠加眼镜）
    (Object.keys(growthBadges) as (keyof typeof growthBadges)[]).forEach((k) => {
      const el = growthBadges[k];
      if (!el) return;
      const active =
        (k === "ribbon" && level >= 2) || (k === "glasses" && level >= 3) || (k === "hat" && level >= 4);
      el.setAttribute("data-active", active ? "true" : "false");
    });
  }

  // 成长随滚动更新（复用 rAF 合并，不重复监听）
  let growthRAF = false;
  function requestGrowth() {
    if (growthRAF) return;
    growthRAF = true;
    requestAnimationFrame(() => {
      growthRAF = false;
      updateGrowth();
    });
  }
  updateGrowth();
  window.addEventListener("scroll", requestGrowth, { passive: true });
  window.addEventListener("resize", requestGrowth, { passive: true });
  document.addEventListener("astro:page-load", requestGrowth);

  // ===== P2 #9：移动端最小化 / 恢复 =====
  const minBtn = pet.querySelector(".pet-min-btn");
  let petMinimized = false;
  function setMinimized(min: boolean) {
    petMinimized = min;
    pet.classList.toggle("pet-minimized", min);
    if (min) {
      // 收进角落：隐藏成长条，仅留一个“小 Gali”圆点
      if (minBtn) minBtn.setAttribute("data-state", "restore");
    } else {
      if (minBtn) minBtn.setAttribute("data-state", "min");
    }
  }
  if (minBtn) {
    minBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      setMinimized(!petMinimized);
    });
    pet.addEventListener("click", (e) => {
      if (petMinimized && !(e.target as Element).closest(".pet-min-btn")) {
        setMinimized(false);
      }
    });
  }

  // 首次进入弹一句引导（每次会话一次）
  if (!sessionStorage.getItem("pet-hint-shown")) {
    setTimeout(() => {
      say(hint || lines[0] || "");
      sessionStorage.setItem("pet-hint-shown", "1");
    }, 1200);
  }

  // ===== 点击 / 拖拽（仅桌面端拖拽） =====
  let moved = false;
  let startX = 0,
    startY = 0,
    origLeft = 0,
    origTop = 0;

  // 拖拽结束/过程中检测是否与「返回顶部」按钮重叠，重叠则自动弹到按钮左侧
  function avoidBackToTop(x: number, y: number) {
    const btn = document.getElementById("back-to-top");
    if (!btn) return { x, y };
    const w = pet.offsetWidth || PET_W;
    const h = pet.offsetHeight || PET_H;
    const br = btn.getBoundingClientRect();
    const overlap = x < br.right && x + w > br.left && y < br.bottom && y + h > br.top;
    if (!overlap) return { x, y };
    const nx = Math.max(8, br.left - w - 12);
    return { x: nx, y };
  }

  pet.addEventListener("pointerdown", (e) => {
    if (!isFinePointer()) return; // 触屏不启用拖拽，保持页面滚动
    if ((e.target as Element).closest?.(".pet-min-btn")) return; // 最小化按钮不触发拖拽
    startX = e.clientX;
    startY = e.clientY;
    moved = false;
    const rect = pet.getBoundingClientRect();
    origLeft = rect.left;
    origTop = rect.top;
    pet.setPointerCapture(e.pointerId);
    pet.style.touchAction = "none";
    pet.classList.add("dragging");
    isDragging = true;
  });

  pet.addEventListener("pointermove", (e) => {
    if (!isDragging) return;
    const dx = e.clientX - startX;
    const dy = e.clientY - startY;
    if (Math.abs(dx) + Math.abs(dy) > 8) moved = true;
    if (moved) {
      let x = origLeft + dx;
      let y = origTop + dy;
      x = Math.max(8, Math.min(window.innerWidth - pet.offsetWidth - 8, x));
      y = Math.max(8, Math.min(window.innerHeight - pet.offsetHeight - 8, y));
      const pos = avoidBackToTop(x, y);
      pet.style.left = `${pos.x}px`;
      pet.style.top = `${pos.y}px`;
      petX = pos.x;
      petY = pos.y;
    }
  });

  // 点击台词：30% 概率说节令问候（周末/早晚/深夜），
  // 30% 概率说 Currently 真实内容（P2 #8 联动），否则随机台词
  function randomLine() {
    const g = greetingForNow();
    const roll = Math.random();
    if (g && roll < 0.3) return g;
    const c = currentlyLine();
    if (c && roll < 0.6) return c;
    return lines[Math.floor(Math.random() * lines.length)] || "";
  }

  const endDrag = () => {
    if (!isDragging) return;
    isDragging = false;
    pet.classList.remove("dragging");
    pet.style.touchAction = "";
    if (!moved) {
      // 视为点击：跳一下 + 台词（reduced-motion 时不跳）
      if (!reduceMotion) {
        pet.classList.remove("blink");
        void pet.offsetWidth;
        pet.classList.add("blink");
        setTimeout(() => pet.classList.remove("blink"), 420);
      }
      say(randomLine());
    }
  };
  pet.addEventListener("pointerup", endDrag);
  pet.addEventListener("pointercancel", endDrag);

  // 键盘支持
  pet.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      say(randomLine());
    }
  });

  // ===== 搜索弹窗 / 移动端菜单联动：打开时隐藏宠物（避免层级冲突） =====
  const htmlEl = document.documentElement;
  const overlayClasses = ["search-overlay-open", "mobile-overlay-open"];
  function syncPetHidden() {
    const hidden = overlayClasses.some((c) => htmlEl.classList.contains(c));
    pet.classList.toggle("pet-hidden", hidden);
  }
  const obs = new MutationObserver(syncPetHidden);
  obs.observe(htmlEl, { attributes: true, attributeFilter: ["class"] });
  syncPetHidden();
</script>
