---
import { useTranslations, getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const label = t("pet.label");
const hint = t("pet.hint");
const lines = t("pet.lines");
const greetings = t("pet.greetings");
---

<!--
  Desktop Pet: Gali 小猫头鹰
  程序化 AI 设计的矢量吉祥物 —— 寓意智慧与终身学习，绿色呼应站点品牌色。
  交互：待机呼吸浮动 / 眼睛追踪鼠标 / 随机眨眼 / 点击弹气泡 / 可拖拽换位置
-->
<div
  id="pet"
  class="pet"
  role="button"
  tabindex="0"
  aria-label={label}
  data-lines={JSON.stringify(lines)}
  data-hint={hint}
  data-greetings={JSON.stringify(greetings)}
>
  <div id="pet-bubble" class="pet-bubble" aria-live="polite"></div>

  <svg class="pet-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <!-- 耳朵 -->
    <path d="M40 74 L28 26 L76 56 Z" style="fill:var(--pet-dark)" />
    <path d="M160 74 L172 26 L124 56 Z" style="fill:var(--pet-dark)" />
    <!-- 头顶羽毛 -->
    <path d="M100 62 L88 44 L100 52 L112 44 Z" style="fill:var(--pet-dark)" />
    <!-- 身体 -->
    <ellipse cx="100" cy="120" rx="60" ry="56" style="fill:var(--pet-body)" />
    <!-- 翅膀 -->
    <path d="M36 98 C20 122 24 154 44 168 C52 158 56 140 54 118 Z" style="fill:var(--pet-dark)" />
    <path d="M164 98 C180 122 176 154 156 168 C148 158 144 140 146 118 Z" style="fill:var(--pet-dark)" />
    <!-- 肚皮 -->
    <ellipse cx="100" cy="134" rx="38" ry="36" style="fill:var(--pet-belly)" />
    <!-- 脚 -->
    <ellipse cx="72" cy="176" rx="9" ry="5" style="fill:var(--pet-feet)" />
    <ellipse cx="128" cy="176" rx="9" ry="5" style="fill:var(--pet-feet)" />
    <!-- 腮红 -->
    <ellipse cx="56" cy="118" rx="9" ry="5" style="fill:var(--pet-blush)" opacity="0.8" />
    <ellipse cx="144" cy="118" rx="9" ry="5" style="fill:var(--pet-blush)" opacity="0.8" />
    <!-- 眉毛 -->
    <path d="M60 70 Q76 62 90 70" stroke="var(--pet-outline)" stroke-width="3.5" stroke-linecap="round" fill="none" />
    <path d="M140 70 Q124 62 110 70" stroke="var(--pet-outline)" stroke-width="3.5" stroke-linecap="round" fill="none" />

    <!-- 姿态附加元素（默认隐藏，由 data-pose 切换） -->
    <!-- 挥手：抬起挥动的右翅膀 -->
    <g class="pose-waving">
      <path d="M160 92 C184 74 200 92 190 108 C176 98 168 94 158 96 Z" style="fill:var(--pet-dark)" />
      <path d="M202 76 q8 2 10 10" stroke="var(--pet-outline)" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.5" />
    </g>
    <!-- 抱书：肚皮前一本摊开的书 -->
    <g class="pose-reading">
      <rect x="70" y="130" width="60" height="38" rx="4" style="fill:var(--pet-book)" />
      <path d="M70 141 H130 M70 151 H130 M70 161 H130" stroke="var(--pet-belly)" stroke-width="1.5" opacity="0.55" />
    </g>
    <!-- 睡觉：闭眼 + 头顶冒 Z -->
    <g class="pose-sleeping">
      <text x="146" y="82" text-anchor="middle" class="pet-zzz pet-zzz-big" font-size="17" font-weight="700">Z</text>
      <text x="162" y="66" text-anchor="middle" class="pet-zzz pet-zzz-small" font-size="11" font-weight="700">z</text>
    </g>

    <!-- 眼睛（眨眼动画作用于此 group） -->
    <g class="pet-eye">
      <circle cx="76" cy="96" r="21" style="fill:var(--pet-eye-bg);stroke:var(--pet-outline)" stroke-width="3.5" />
      <circle cx="124" cy="96" r="21" style="fill:var(--pet-eye-bg);stroke:var(--pet-outline)" stroke-width="3.5" />
      <!-- 瞳孔（鼠标追踪作用于此 group） -->
      <g class="pet-pupil">
        <circle cx="76" cy="98" r="10" style="fill:var(--pet-pupil)" />
        <circle cx="124" cy="98" r="10" style="fill:var(--pet-pupil)" />
        <circle cx="72.5" cy="94.5" r="3.2" style="fill:var(--pet-pupil-hi)" />
        <circle cx="120.5" cy="94.5" r="3.2" style="fill:var(--pet-pupil-hi)" />
      </g>
    </g>
    <!-- 喙 -->
    <path d="M100 112 L90 128 L110 128 Z" style="fill:var(--pet-beak);stroke:var(--pet-beak-stroke)" stroke-width="2" stroke-linejoin="round" />
  </svg>
</div>

<script>
  const pet = document.getElementById("pet");
  const bubble = document.getElementById("pet-bubble");
  if (!pet || !bubble) throw new Error("DesktopPet: #pet/#pet-bubble not found");

  const pupils = pet.querySelectorAll(".pet-pupil");
  const eyes = pet.querySelectorAll(".pet-eye");
  const lines: string[] = JSON.parse(pet.dataset.lines || "[]");
  const hint = pet.dataset.hint || "";
  const greetings: Record<string, string> = JSON.parse(pet.dataset.greetings || "{}");

  // ===== 系统偏好 =====
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ===== 按节令选取问候语 =====
  function greetingForNow(): string {
    const now = new Date();
    const day = now.getDay();
    if (day === 0 || day === 6) return greetings.weekend || "";
    const h = now.getHours();
    if (h >= 5 && h < 11) return greetings.morning || "";
    if (h >= 11 && h < 17) return greetings.afternoon || "";
    if (h >= 17 && h < 23) return greetings.evening || "";
    return greetings.night || "";
  }

  // ===== 姿态切换（视觉升级：挥手 / 抱书 / 睡觉，按节令/时段自动切换） =====
  const POSE_WAVING = "waving";
  const POSE_READING = "reading";
  const POSE_SLEEPING = "sleeping";
  const poseEls = {
    [POSE_WAVING]: pet.querySelector(".pose-waving"),
    [POSE_READING]: pet.querySelector(".pose-reading"),
    [POSE_SLEEPING]: pet.querySelector(".pose-sleeping"),
  };

  function setPose(pose: string | null) {
    (Object.keys(poseEls) as string[]).forEach((key) => {
      const el = poseEls[key];
      if (el) el.setAttribute("data-active", pose === key ? "true" : "false");
    });
    if (pose) pet.setAttribute("data-pose", pose);
    else pet.removeAttribute("data-pose");
  }

  function poseForNow(): string | null {
    const now = new Date();
    const h = now.getHours();
    const day = now.getDay();
    // 深夜或凌晨（23-5 点）→ 睡觉
    if (h >= 23 || h < 5) return POSE_SLEEPING;
    // 周末白天 → 放松抱书读
    if (day === 0 || day === 6) return POSE_READING;
    // 工作日早晨 → 元气挥手打招呼
    if (h >= 7 && h < 10) return POSE_WAVING;
    // 其余时间 → 抱书（阅读者形象）
    return POSE_READING;
  }

  setPose(poseForNow());
  // 跨午夜/时段切换时更新姿态（每小时核对一次，代价极小）
  window.setInterval(() => setPose(poseForNow()), 60 * 60 * 1000);

  // ===== 滚动跟随：宠物随阅读区块上下浮动 =====
  let followRAF = false;
  let isDragging = false;
  let petX = 20; // 当前锚定的水平位置（默认左下）
  let petY = 20; // 当前锚定的垂直位置
  const PET_W = 108;
  const PET_H = 108;
  const GAP = 20;

  // 收集当前页面可跟随的锚点（首页各 section；其他页无区块时退化为空）
  const anchorSel = ["main section", "main article", "#currently", "[data-reveal]"].join(",");

  function pickAnchor(): Element | null {
    const anchors = Array.from(document.querySelectorAll(anchorSel)).filter(
      (el) => (el as HTMLElement).offsetHeight > 0
    );
    if (!anchors.length) return null;
    // 取第一个已进入视口且仍在视口内的区块；否则取最后一个已滚过的区块
    const vh = window.innerHeight;
    for (const el of anchors) {
      const r = el.getBoundingClientRect();
      if (r.top < vh * 0.85 && r.bottom > 0) return el;
    }
    return anchors[anchors.length - 1];
  }

  function clampToViewport(x: number, y: number) {
    const w = pet.offsetWidth || PET_W;
    const h = pet.offsetHeight || PET_H;
    const margin = 8;
    x = Math.max(margin, Math.min(window.innerWidth - w - margin, x));
    y = Math.max(margin, Math.min(window.innerHeight - h - margin, y));
    return { x, y };
  }

  function followScroll() {
    followRAF = false;
    if (isDragging) return; // 拖拽中不自动跟
    if (
      document.documentElement.classList.contains("search-overlay-open") ||
      document.documentElement.classList.contains("mobile-overlay-open")
    ) {
      return; // 弹窗/菜单打开时保持隐藏
    }
    const anchor = pickAnchor();
    // 水平位置：保持用户拖拽后的 petX（未拖拽时为默认 20）
    const targetX = petX;
    const HEADER_OFFSET = 72; // sticky header 高度 + 间距，避免盖住导航
    if (anchor) {
      const r = anchor.getBoundingClientRect();
      let targetY = Math.max(HEADER_OFFSET, r.top + GAP);
      // 锚点在视口下方时，让宠物停在底部
      if (r.top > window.innerHeight - PET_H - GAP) targetY = window.innerHeight - PET_H - GAP;
      targetY = Math.max(HEADER_OFFSET, Math.min(window.innerHeight - PET_H - GAP, targetY));
      const pos = avoidBackToTop(targetX, targetY);
      const { x, y } = clampToViewport(pos.x, pos.y);
      pet.style.left = `${x}px`;
      pet.style.top = `${y}px`;
      petX = x;
      petY = y;
    } else {
      const pos = avoidBackToTop(targetX, 20);
      const { x, y } = clampToViewport(pos.x, pos.y);
      pet.style.left = `${x}px`;
      pet.style.top = `${y}px`;
      petX = x;
      petY = y;
    }
  }

  function requestFollow() {
    if (followRAF) return;
    followRAF = true;
    requestAnimationFrame(followScroll);
  }

  // 仅在桌面端启用滚动跟随（移动端保持固定，避免干扰阅读）
  const isFinePointer = () => window.matchMedia("(pointer: fine)").matches;
  if (isFinePointer() && !reduceMotion) {
    window.addEventListener("scroll", requestFollow, { passive: true });
    window.addEventListener("resize", requestFollow, { passive: true });
    requestFollow();
  }

  // ===== 随机眨眼（reduced-motion 时完全静止） =====
  let blinkTimer: ReturnType<typeof setTimeout>;
  function scheduleBlink() {
    if (reduceMotion) return;
    clearTimeout(blinkTimer);
    blinkTimer = setTimeout(() => {
      pet.classList.remove("blink");
      void pet.offsetWidth; // 重触发动画
      pet.classList.add("blink");
      setTimeout(() => pet.classList.remove("blink"), 420);
      scheduleBlink();
    }, 2600 + Math.random() * 3400);
  }
  scheduleBlink();

  // ===== 瞳孔跟随鼠标（reduced-motion 时静止） =====
  let raf = false;
  window.addEventListener("mousemove", (e) => {
    if (reduceMotion) return;
    if (raf) return;
    raf = true;
    requestAnimationFrame(() => {
      const rect = pet.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      let dx = (e.clientX - cx) / (rect.width / 2);
      let dy = (e.clientY - cy) / (rect.height / 2);
      dx = Math.max(-1, Math.min(1, dx));
      dy = Math.max(-1, Math.min(1, dy));
      const maxMove = 6;
      pupils.forEach((p) => {
        p.setAttribute("transform", `translate(${(dx * maxMove).toFixed(1)} ${(dy * maxMove * 0.8).toFixed(1)})`);
      });
      raf = false;
    });
  });

  // ===== 气泡 =====
  let bubbleTimer: ReturnType<typeof setTimeout>;
  function say(text: string) {
    bubble.textContent = text;
    bubble.classList.add("show");
    clearTimeout(bubbleTimer);
    bubbleTimer = setTimeout(() => bubble.classList.remove("show"), 3200);
  }

  // 首次进入弹一句引导（每次会话一次）
  if (!sessionStorage.getItem("pet-hint-shown")) {
    setTimeout(() => {
      say(hint || lines[0] || "");
      sessionStorage.setItem("pet-hint-shown", "1");
    }, 1200);
  }

  // ===== 点击 / 拖拽（仅桌面端拖拽） =====
  let moved = false;
  let startX = 0,
    startY = 0,
    origLeft = 0,
    origTop = 0;

  // 拖拽结束/过程中检测是否与「返回顶部」按钮重叠，重叠则自动弹到按钮左侧
  function avoidBackToTop(x: number, y: number) {
    const btn = document.getElementById("back-to-top");
    if (!btn) return { x, y };
    const w = pet.offsetWidth || PET_W;
    const h = pet.offsetHeight || PET_H;
    const br = btn.getBoundingClientRect();
    const overlap = x < br.right && x + w > br.left && y < br.bottom && y + h > br.top;
    if (!overlap) return { x, y };
    const nx = Math.max(8, br.left - w - 12);
    return { x: nx, y };
  }

  pet.addEventListener("pointerdown", (e) => {
    if (!isFinePointer()) return; // 触屏不启用拖拽，保持页面滚动
    startX = e.clientX;
    startY = e.clientY;
    moved = false;
    const rect = pet.getBoundingClientRect();
    origLeft = rect.left;
    origTop = rect.top;
    pet.setPointerCapture(e.pointerId);
    pet.style.touchAction = "none";
    pet.classList.add("dragging");
    isDragging = true;
  });

  pet.addEventListener("pointermove", (e) => {
    if (!isDragging) return;
    const dx = e.clientX - startX;
    const dy = e.clientY - startY;
    if (Math.abs(dx) + Math.abs(dy) > 8) moved = true;
    if (moved) {
      let x = origLeft + dx;
      let y = origTop + dy;
      x = Math.max(8, Math.min(window.innerWidth - pet.offsetWidth - 8, x));
      y = Math.max(8, Math.min(window.innerHeight - pet.offsetHeight - 8, y));
      const pos = avoidBackToTop(x, y);
      pet.style.left = `${pos.x}px`;
      pet.style.top = `${pos.y}px`;
      petX = pos.x;
      petY = pos.y;
    }
  });

  // 点击台词：30% 概率说节令问候（周末/早晚/深夜），否则随机台词
  function randomLine() {
    const g = greetingForNow();
    return g && Math.random() < 0.3 ? g : lines[Math.floor(Math.random() * lines.length)] || "";
  }

  const endDrag = () => {
    if (!isDragging) return;
    isDragging = false;
    pet.classList.remove("dragging");
    pet.style.touchAction = "";
    if (!moved) {
      // 视为点击：跳一下 + 台词（reduced-motion 时不跳）
      if (!reduceMotion) {
        pet.classList.remove("blink");
        void pet.offsetWidth;
        pet.classList.add("blink");
        setTimeout(() => pet.classList.remove("blink"), 420);
      }
      say(randomLine());
    }
  };
  pet.addEventListener("pointerup", endDrag);
  pet.addEventListener("pointercancel", endDrag);

  // 键盘支持
  pet.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      say(randomLine());
    }
  });

  // ===== 搜索弹窗 / 移动端菜单联动：打开时隐藏宠物（避免层级冲突） =====
  const htmlEl = document.documentElement;
  const overlayClasses = ["search-overlay-open", "mobile-overlay-open"];
  function syncPetHidden() {
    const hidden = overlayClasses.some((c) => htmlEl.classList.contains(c));
    pet.classList.toggle("pet-hidden", hidden);
  }
  const obs = new MutationObserver(syncPetHidden);
  obs.observe(htmlEl, { attributes: true, attributeFilter: ["class"] });
  syncPetHidden();
</script>
