---
// Column icon SVGs — clean, professional line icons
// 复用全站统一图标库 Icon.astro（与 4 栏目图标同风格：线性描边 / stroke-width 1.6 / round）
// 栏目专属色由 SECTION_COLORS 提供
import type { SectionKey } from "../lib/sections";
import { SECTION_COLORS } from "../lib/sections";
import Icon from "./Icon.astro";

export interface Props {
  section: SectionKey;
  class?: string;
}

const { section, class: cls = "w-6 h-6" } = Astro.props;
const sectionColor = SECTION_COLORS[section];
---

<Icon name={section} class={cls} style={`color:${sectionColor}`} />
