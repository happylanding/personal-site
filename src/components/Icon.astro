---
/**
 * Icon — 全站统一图标库
 *
 * 以 4 个栏目的图标库（ColumnIcon，见 src/lib/sections.ts 配色）为统一标准：
 *   - 线性描边：fill="none" stroke="currentColor"
 *   - 描边粗细统一 stroke-width="1.6"
 *   - 圆头端点/连接：stroke-linecap="round" stroke-linejoin="round"
 *   - 统一 viewBox="0 0 24 24"
 *
 * 所有图标共享同一个 svg 容器，仅内部 path 不同，保证视觉完全一致。
 * 用法：<Icon name="sparkles" class="w-5 h-5" />
 */

type IconName =
  // 栏目图标（与 ColumnIcon 一致，供 ColumnIcon 复用）
  | "insights"
  | "ai"
  | "tips"
  | "books"
  // 精选 / 状态
  | "star"
  | "starOutline"
  | "sparkles"
  | "mapPin"
  | "radio"
  | "warning"
  // 导航 / 页面
  | "home"
  | "user"
  | "mail"
  | "search"
  | "close"
  | "menu"
  | "bookmark"
  | "sun"
  | "moon"
  // 箭头
  | "arrowUp"
  | "arrowRight"
  | "arrowLeft"
  | "arrowUpRight"
  | "chevronDown"
  | "chevronRight"
  | "plus"
  // 功能
  | "download"
  | "bookOpen"
  | "fileText"
  | "cart"
  | "link"
  | "list"
  | "listTree"
  | "calendar"
  | "toolbox";

interface Props {
  name: IconName;
  class?: string;
  /** 覆盖默认描边粗细（全站统一标准为 1.6，通常无需改动） */
  strokeWidth?: number;
  style?: string;
}

const { name, class: cls = "w-6 h-6", strokeWidth = 1.6, style } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  style={style}
  aria-hidden="true"
>
  {
    name === "insights" && (
      <>
        <path d="M12 2c-2.67 0-5 2.16-5 5 0 1.26.46 2.5 1.18 3.47A8 8 0 0 0 12 22a8 8 0 0 0 3.82-11.53C16.54 9.5 17 8.26 17 7c0-2.84-2.33-5-5-5Z"/>
        <path d="M10 17.5h4"/>
        <path d="M11 15h2"/>
        <line x1="12" y1="8" x2="12" y2="11"/>
      </>
    )
  }
  {
    name === "ai" && (
      <>
        <rect x="4" y="4" width="16" height="16" rx="3"/>
        <path d="M12 8.5v7"/>
        <path d="M8.5 12h7"/>
        <path d="M12 2v2"/>
        <path d="M12 20v2"/>
        <path d="M2 12h2"/>
        <path d="M20 12h2"/>
      </>
    )
  }
  {
    name === "tips" && (
      <>
        <circle cx="4" cy="12" r="2"/>
        <circle cx="12" cy="4" r="2"/>
        <circle cx="12" cy="20" r="2"/>
        <circle cx="20" cy="12" r="2"/>
        <circle cx="8.34" cy="6.34" r="2"/>
        <circle cx="15.66" cy="6.34" r="2"/>
        <circle cx="8.34" cy="17.66" r="2"/>
        <circle cx="15.66" cy="17.66" r="2"/>
      </>
    )
  }
  {
    name === "books" && (
      <>
        <path d="M4 5v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2Z"/>
        <path d="M8 3v18"/>
        <path d="M16 3v18"/>
        <line x1="10" y1="8" x2="14" y2="8"/>
        <line x1="10" y1="12" x2="14" y2="12"/>
      </>
    )
  }
  {
    name === "star" && (
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="currentColor" stroke="none" stroke-width="0" />
    )
  }
  {
    name === "starOutline" && (
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
    )
  }
  {
    name === "sparkles" && (
