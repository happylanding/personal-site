---
/**
 * 📡 CURRENTLY —— "最近在做什么" 动态状态卡片
 *
 * 不再写死示例数据，而是基于站内真实内容（src/content/articles/）动态生成：
 *
 *   READING  最近在看的书        → 最近更新的阅读思考文章（author 字段非空）
 *   WRITING  最近在写什么        → 最近更新的普通文章
 *   CODING   最近在折腾什么      → 优先取最近文章正文中首个代码块的语言
 *   LEARNING 最近在学什么        → 优先取最近文章标签中与学习相关的词
 *
 * 生成规则：
 *   - 取「更新优先」排序（updated 存在时优先于 date，兼顾改稿与发布）
 *   - 每行自带链接：可跳转到对应文章，整卡不再是死文本
 *   - 文章不足或缺少可推断字段时自动降级为网站默认简介，绝不显示空行
 *   - 中英文双语标题/描述，跟随站点语言
 *
 * 前缀动态刷新：
 *   - 不固定：前缀从「网络热梗 × 趣味动词」池里按**站点内容指纹**挑选
 *   - 站点内容指纹 = 全部已发布文章的关键字段 + 正文归一化哈希
 *   - 只要站内更新了文章/内容 → 指纹变化 → 四行前缀一起换新（不定期、动态）
 *   - 内容没变 → 指纹不变 → 前缀稳定，不会每次构建抽风
 *
 * 排版约定（保证四行严格对齐）：
 *   - 左侧标签列固定等宽（grid 第一列 4.5rem），正文起点对齐
 *   - 标题/描述单行截断（truncate），右边缘对齐
 *   - 行间细分隔线，信息主次分明
 */
import { useTranslations, getLangFromUrl } from "../i18n/utils";
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const now = Date.now();
const yearMs = 365 * 24 * 60 * 60 * 1000;

const isBook = (a) => Boolean(a.data.author);
const titleOf = (a) => (lang === "en" ? a.data.titleEn || a.data.title : a.data.title);
const pathOf = (a) => `${lang === "en" ? "/en" : ""}/${a.data.section}/${a.id}`;
const stripBookMarks = (s) => s.replace(/^《|》$/g, "");
const fmtDate = (a) =>
  (a.data.updated || a.data.date).toLocaleDateString(lang === "en" ? "en-US" : "zh-CN", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

/** 网络热梗 × 有趣动词池：本站不严肃，标题也要会整活 😎 每行 8 个备选，池子越大越不容易撞句 */
const VIBES = {
  reading: {
    zh: [
      "在啃《{t}》",
      "在盘《{t}》",
      "在读《{t}》，已上头",
      "在卷《{t}》，精神状态良好",
      "今天也在啃《{t}》",
      "在磨《{t}》，越磨越香",
      "掉进《{t}》出不来了",
      "抱着《{t}》不肯撒手",
    ],
    en: [
      "Crushing {t}",
      "Deep in {t}",
      "Obsessed with {t}",
      "Devouring {t}",
      "Loving {t}",
      "Savoring {t}",
      "Falling down the {t} rabbit hole",
      "Glued to {t}",
    ],
  },
  writing: {
    zh: [
      "在肝《{t}》",
      "键盘冒烟中：《{t}》",
      "在憋大招：《{t}》",
      "灵感上头，在写《{t}》",
      "在更文《{t}》",
      "码字到飞起：《{t}》",
      "在憋《{t}》这篇大的",
      "深夜码字：《{t}》",
    ],
    en: [
      "Cooking up {t}",
      "Drafting {t}",
      "Pounding out {t}",
      "On a roll: {t}",
      "Working on {t}",
      "Smashing out {t}",
      "Crafting {t}",
      "Late-night writing: {t}",
    ],
  },
  coding: {
    zh: [
      "在折腾 {l}",
      "在跟 {l} 极限拉扯",
      "在搓 {l}，面向 BUG 编程",
      "在整活 {l}",
      "在肝 {l}，头秃警告",
      "在调 {l}，死活不报错",
      "在跟 {l} 掰头",
      "在驯服 {l}",
    ],
    en: [
      "Tinkering with {l}",
      "Wrestling with {l}",
      "Hacking on {l}",
      "Fighting {l}",
      "Grinding {l}",
      "Battling {l}",
      "Taming {l}",
      "Poking {l} with a stick",
    ],
  },
  learning: {
    zh: [
      "在学 {l}",
      "在偷偷卷 {l}",
      "在给大脑升级：{l}",
      "在上头 {l}",
      "在补课：{l}",
      "在悄悄点 {l} 技能点",
      "在研习 {l}",
      "在恶补 {l}",
    ],
    en: [
      "Leveling up in {l}",
      "Grinding {l}",
      "Studying {l}",
      "Upskilling in {l}",
      "Learning {l}",
      "Leveling {l} skill points",
      "Geeking out on {l}",
      "Cramming {l}",
    ],
  },
};

/** 稳定字符串哈希（FNV-1a 风格），同一输入永远得到同一数字 */
const hashStr = (s) => {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  return h >>> 0;
};

/**
 * 按「站点内容指纹」确定性挑选热梗：
 *  - 指纹 = 全部已发布文章关键字段 + 正文归一化哈希
 *  - 只要站内更新了文章/内容 → 指纹变 → 前缀刷新（不定期、动态）
 *  - 内容没变 → 指纹不变 → 前缀稳定，不抽风
 *  - 每行用不同偏移（kind + 行序号），保证四行前缀互不重复
 */
const pickVibe = (kind, lang, seed, offset = 0) => {
  const pool = VIBES[kind]?.[lang] ?? [];
  return pool[((hashStr(seed) + offset * 0x9e3779b1) >>> 0) % pool.length];
};

/** 更新优先排序：updated 存在且不晚于未来则按 updated，否则按 date */
const byUpdated = (a, b) => {
  const at = (x) => {
    const u = x.data.updated;
    return u && u.getTime() <= now + 24 * 60 * 60 * 1000 ? u.getTime() : x.data.date.getTime();
  };
  return at(b) - at(a);
};

// 数据源：已发布文章，按更新时间倒序
const published = (await getCollection("articles", ({ data }) => !data.draft)).sort(byUpdated);
const books = published.filter(isBook);
const posts = published.filter((a) => !isBook(a));

/**
 * 站点内容指纹：把所有已发布文章的关键字段 + 正文归一化哈希拼起来，
 * 只要站内更新了任何文章/内容，指纹就变，四行前缀随之一起刷新。
 */
const siteFingerprint = published
  .map((a) =>
    [
      a.id,
      a.data.section,
      a.data.title,
      a.data.titleEn,
      a.data.author || "",
      (a.data.tags || []).join(","),
      (a.data.date?.getTime?.() ?? ""),
      (a.data.updated?.getTime?.() ?? ""),
      (a.body || "").replace(/\s+/g, " ").trim(),
    ].join("|")
  )
  .join("\n");

/** 挑选最近一年内的一篇，超出则回退到全局最新一篇，避免空值 */
const pickRecent = (list) => list.find((a) => Date.now() - (a.data.updated || a.data.date).getTime() <= yearMs) || list[0];

const book = pickRecent(books);
const writing = pickRecent(posts);

// READING：默认回退到站内最近一本书籍
const reading = book
  ? {
      label: "READING",
      title: pickVibe("reading", lang, siteFingerprint, 0).replace("{t}", stripBookMarks(titleOf(book))),
      desc: book.data.author
        ? `${lang === "en" ? "by" : "作者"} ${lang === "en" ? book.data.authorEn || book.data.author : book.data.author}`
        : lang === "en"
          ? "Latest book on the shelf"
          : "书架上的新书",
      href: pathOf(book),
    }
  : null;

// WRITING：默认回退到最近一篇普通文章
const writingItem = writing
  ? {
      label: "WRITING",
      title: pickVibe("writing", lang, siteFingerprint, 1).replace("{t}", stripBookMarks(titleOf(writing))),
      desc: lang === "en" ? `Updated ${fmtDate(writing)}` : `更新于 ${fmtDate(writing)}`,
      href: pathOf(writing),
    }
  : null;

// CODING：优先从最近正文里挑首个代码块的语言，找不到就写网站本身
const LANG_NAMES = {
  js: "JavaScript",
  javascript: "JavaScript",
  ts: "TypeScript",
  typescript: "TypeScript",
  bash: "Shell",
  sh: "Shell",
  html: "HTML",
  css: "CSS",
  python: "Python",
  node: "Node.js",
  vue: "Vue",
  react: "React",
  svelte: "Svelte",
  astro: "Astro",
  json: "JSON",
  md: "Markdown",
  markdown: "Markdown",
  sql: "SQL",
  yaml: "YAML",
  yml: "YAML",
};
let codeLang = "";
let codeSource = null;
for (const a of published) {
  const m = a.body?.match(/```([\w+-]+)/);
  if (m) {
    codeLang = m[1];
    codeSource = a;
    break;
  }
}
const codeLangPretty = LANG_NAMES[codeLang.toLowerCase()] || codeLang;
const coding = {
  label: "CODING",
  title: codeLang
    ? pickVibe("coding", lang, siteFingerprint, 2).replace("{l}", codeLangPretty)
    : lang === "en"
      ? "Hacking on Astro & this site"
      : "在折腾 Astro 个人网站",
  desc: codeSource
    ? lang === "en"
      ? `From ${titleOf(codeSource)}`
      : `来自《${stripBookMarks(titleOf(codeSource))}》`
    : lang === "en"
      ? "Building this site with Astro + Tailwind"
      : "用 Astro + Tailwind 维护这个站点",
  href: codeSource ? pathOf(codeSource) : "/",
};

// LEARNING：优先从最近文章标签里找学习相关词（AI / 工具 / 语言），找不到就写长期主题
const learningKeywords = ["AI", "ai", "astro", "tailwind", "css", "javascript", "node", "vue", "react", "python", "web"];
const learning = (() => {
  // 跳过已用于 READING/WRITING/CODING 的文章，避免同一篇在卡片里重复出现
  const usedIds = new Set([book?.id, writing?.id, codeSource?.id].filter(Boolean));
  const seen = published.find((a) =>
    !usedIds.has(a.id) && (a.data.tags || []).some((tag) => learningKeywords.includes(tag))
  );
  if (seen) {
    const tag = (seen.data.tags || []).find((x) => learningKeywords.includes(x));
    const pretty = { ai: "AI", astro: "Astro", tailwind: "Tailwind CSS", css: "CSS", javascript: "JavaScript", node: "Node.js", vue: "Vue", react: "React", python: "Python", web: "Web" }[tag] || tag;
    return {
      label: "LEARNING",
      title: pickVibe("learning", lang, siteFingerprint, 3).replace("{l}", pretty),
      desc: lang === "en" ? `From ${titleOf(seen)}` : `来自《${stripBookMarks(titleOf(seen))}》`,
      href: pathOf(seen),
    };
  }
  return {
    label: "LEARNING",
    title: lang === "en" ? "Leveling up in AI & tools" : "在偷偷卷 AI 与效率工具",
    desc: lang === "en" ? "The long-running theme of this site" : "本站一直关注的主题",
    href: "/",
  };
})();

const rows = [reading, writingItem, coding, learning].filter(Boolean);
const grid = rows.length > 0 ? rows.slice(0, 4) : [];
---

{
  grid.length > 0 && (
    <div
      class="rounded-2xl border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] p-6"
      data-currently
    >
      <div class="mb-4 flex items-center justify-between">
        <h2
          class="font-mono text-xs font-semibold uppercase tracking-widest text-black/40 dark:text-white/40 flex items-center gap-1.5"
        >
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-green-600 dark:bg-green-400 animate-pulse" aria-hidden="true"></span>
          <Icon name="radio" class="w-3.5 h-3.5" />
          {lang === "en" ? "CURRENTLY" : "最近在做什么"}
        </h2>
        <span class="font-mono text-xs text-black/40 dark:text-white/55">
          {lang === "en" ? "auto · from posts" : "自动 · 来自站内文章"}
        </span>
      </div>
      <!-- 方案 A 升级：卡片内 4 行文字带交错延迟 + back.out 弹性逐个入场 -->
      <div class="space-y-3 text-sm" data-reveal-stagger>
        {grid.map((row, i) => (
          <a
            href={row.href}
            title={row.title}
            class={`group grid grid-cols-[4.5rem_1fr_auto] items-center gap-x-3 py-2.5 transition-opacity hover:opacity-80 ${
              i > 0 ? "border-t border-black/[0.06] dark:border-white/[0.06]" : ""
            }`}
            data-currently-row
          >
            <span
              class="shrink-0 font-mono text-[13px] tracking-wider text-black/45 dark:text-white/55 group-hover:text-black/60 dark:group-hover:text-white/60 transition-colors"
            >
              {row.label}
            </span>
            <span class="min-w-0">
              <span class="block truncate text-black/70 dark:text-white/70 group-hover:opacity-70 transition-opacity">
                {row.title}
              </span>
              <span class="mt-0.5 block truncate text-[13px] text-black/45 dark:text-white/55">
                {row.desc}
              </span>
            </span>
            <span
              class="shrink-0 font-mono text-[13px] text-black/50 dark:text-white/65 opacity-0 transition-opacity group-hover:opacity-100"
              aria-hidden="true"
            >
              <Icon name="arrowUpRight" class="w-3.5 h-3.5" />
            </span>
          </a>
        ))}
      </div>
    </div>
  )
}
